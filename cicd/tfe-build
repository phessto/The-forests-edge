#!/usr/bin/env bash
# =============================================================================
# tfe-build — compile TFE + RPM (or run the smoke test) inside the tfe-build image
# =============================================================================
# Expected mounts (set by build.sh / podman run):
#   /src  — repo root (source; read only as far as this script is concerned)
#   /out  — output directory for binaries and RPMs (e.g. ./dist)
#
# Modes (env TFE_MODE, set by build.sh):
#   build (default) — compile tfe + daemon and the RPMs into /out
#   test            — smoke test: compile in a scratch copy, boot the world
#                     from the repo on a scratch run directory with the SSH
#                     listener on, log in as the README's test immortal over
#                     ssh -tt, ssh -T and telnet, check the world loaded, shut
#                     the MUD down from inside the game; writes nothing to /out
#
# The compile always runs in a scratch copy under /tmp, so no root-owned
# src/OBJ or binaries are left in the mounted repo.
#
# Artifacts written:
#   /out/tfe
#   /out/daemon
#   /out/rpm/*.rpm          (binary + source RPM from packaging/tfe.spec)
# =============================================================================
set -euo pipefail

SPEC_FILE="packaging/tfe.spec"
# Writable directories TFE expects beside src/ (paths in src/file.h).
# Keep in sync with packaging/tfe.tmpfiles.
RUN_DIRS="backup clans deleted/area deleted/player logs/immortal logs/mob
logs/object logs/player logs/room lost+found mail notes/clans prev/area
prev/files prev/player prev/rooms prev/tables reimb rooms var/control var/html
var/log var/run var/swap/action var/swap/room var/tmp"
WORLD_DIRS="area files tables notes player public_html"

log()  { echo -e "\033[32m[+] $1\033[0m"; }
fail() { echo -e "\033[31m[!] $1\033[0m" >&2; exit 1; }

[[ -d /src ]] || fail "missing /src mount"
cd /src

# Copy the tree (no .git, no dist) to a scratch dir and run make there.
compile_scratch() {
    local dir="$1"
    mkdir -p "$dir"
    tar -C /src -cf - \
        --exclude='./.git' --exclude='./dist' \
        --exclude='./src/OBJ' --exclude='./src/tfe' --exclude='./src/daemon' \
        . | tar -C "$dir" -xf -
    log "Compiling in $dir ($(g++ --version | head -1))"
    make -C "$dir/src" -j"$(nproc)"
}

smoke_test() {
    local work=/tmp/tfe-smoke root port=4000 ssh_port=4022 pid rc
    compile_scratch "$work"
    root="$work/run"
    mkdir -p "$root/bin"
    for d in $WORLD_DIRS; do cp -a "$work/$d" "$root/$d"; done
    for d in $RUN_DIRS; do mkdir -p "$root/$d"; done
    cp -a "$work/src/tfe" "$work/src/daemon" "$root/bin/"
    : > "$root/files/bugs.txt"

    # SSH on: the environment says 4122, the command line 4022; the command
    # line must win (checked below).
    log "Booting TFE on port $port (SSH $ssh_port) in $root"
    ( cd "$root/bin" && TFE_SSH_PORT=4122 exec ./tfe "$port" --ssh-port "$ssh_port" ) \
        > "$root/var/log/stdout.log" 2>&1 &
    pid=$!
    for _ in $(seq 1 180); do
        grep -q 'MUD BOOTED' "$root/files/bugs.txt" 2>/dev/null && break
        kill -0 "$pid" 2>/dev/null || { cat "$root/files/bugs.txt" "$root/var/log/stdout.log" >&2; fail "tfe exited during boot"; }
        sleep 1
    done
    grep -q 'MUD BOOTED' "$root/files/bugs.txt" || { kill "$pid"; fail "tfe did not finish booting in 180s"; }

    # Anything logged between STARTING and BOOTED is a boot-time bug.
    local bootbugs
    bootbugs="$(sed -n '/STARTING MUD/,/MUD BOOTED/p' "$root/files/bugs.txt" | grep -v 'STARTING MUD\|MUD BOOTED' || true)"
    if [[ -n "$bootbugs" ]]; then
        echo "$bootbugs" >&2
        kill "$pid"
        fail "boot logged bugs (above)"
    fi
    log "Boot clean"

    # SSH listener: settings precedence, host keys, then real OpenSSH logins.
    grep -q "SSH: Listening on port $ssh_port " "$root/var/log/stdout.log" \
        || { kill "$pid"; cat "$root/var/log/stdout.log" >&2; fail "SSH not listening on $ssh_port (--ssh-port must override TFE_SSH_PORT)"; }
    for k in ssh_host_ed25519_key ssh_host_rsa_key; do
        [[ "$(stat -c %a "$root/ssh/$k" 2>/dev/null)" == 600 ]] \
            || { kill "$pid"; fail "host key $root/ssh/$k missing or not mode 0600"; }
    done
    [[ "$(stat -c %a "$root/ssh")" == 700 ]] || { kill "$pid"; fail "$root/ssh is not mode 0700"; }
    grep 'SSH: Host key' "$root/var/log/stdout.log" | tr -d '\r' | sed 's/^/     /'
    log "SSH: logging in as TempImm with ssh -tt (pty) and ssh -T (no pty)"
    if ! python3 - "$ssh_port" <<'PY'
import os, pty, re, select, socket, subprocess, sys, time
port = sys.argv[1]
host = socket.gethostbyname(socket.gethostname())
opts = ["-p", port, "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR", "-o", "BatchMode=yes"]

def need(cond, what):
    print(("ok   " if cond else "FAIL ") + what)
    if not cond:
        sys.exit(1)

def clean(b):
    return re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", b.decode("latin-1")).replace("\r", "")

class Session:
    def __init__(self, tty):
        if tty:
            self.pid, self.fd = pty.fork()
            if self.pid == 0:
                os.execvp("ssh", ["ssh", "-tt"] + opts + ["play@" + host])
            self.wfd = self.fd
        else:
            self.p = subprocess.Popen(["ssh", "-T"] + opts + ["play@" + host],
                                      stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
            self.fd, self.wfd = self.p.stdout.fileno(), self.p.stdin.fileno()
        self.tty = tty
    def read(self, wait=1.5):
        out, end = b"", time.time() + wait
        while time.time() < end:
            r, _, _ = select.select([self.fd], [], [], 0.2)
            if not r:
                continue
            try:
                d = os.read(self.fd, 65536)
            except OSError:
                break
            if not d:
                break
            out += d
            end = max(end, time.time() + 0.4)
        self.raw = out
        return clean(out)
    def type(self, line, wait=1.5):
        # A person on a pty types characters and Enter (CR); a script without
        # a pty sends whole lines.
        if self.tty:
            for ch in line:
                os.write(self.wfd, ch.encode()); time.sleep(0.02)
            os.write(self.wfd, b"\r")
        else:
            os.write(self.wfd, line.encode() + b"\n")
        return self.read(wait)
    def exit_status(self):
        if self.tty:
            for _ in range(50):
                pid, st = os.waitpid(self.pid, os.WNOHANG)
                if pid:   # (no os.waitstatus_to_exitcode on UBI8's Python 3.6)
                    return os.WEXITSTATUS(st) if os.WIFEXITED(st) else -1
                time.sleep(0.2)
            return None
        try:
            return self.p.wait(timeout=10)
        except subprocess.TimeoutExpired:
            return None

for tty in (True, False):
    kind = "ssh -tt" if tty else "ssh -T"
    s = Session(tty)
    need("Choice:" in s.read(5), kind + ": greeting and login menu")
    need("Password" in s.type("TempImm"), kind + ": name accepted")
    out = s.type("llama", 3)
    need("llama" not in out, kind + ": password not echoed")
    s.type("", 2); out = s.type("", 3)
    need("Path of Death" in out or "Vnum:" in out, kind + ": logged in and placed in a room")
    if tty:
        # The game's LF CR becomes CR LF: no bare LF, no CR left after a LF.
        need(re.search(rb"(^|[^\r])\n|\n\r(?!\n)", s.raw) is None,
             kind + ": lines end CR LF for the terminal")
    else:
        need(b"\r" not in s.raw, kind + ": no CRs without a pty")
    need(b"\xff" not in s.raw, kind + ": no telnet bytes")
    need("Vnum: 33751" in s.type("look"), kind + ": look")
    need("Thank you for visiting" in s.type("quit", 3), kind + ": quit")
    need(s.exit_status() == 0, kind + ": client exits 0 when the game closes the link")

r = subprocess.run(["ssh", "-T"] + opts + ["nobody@" + host], stdin=subprocess.DEVNULL,
                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
need(r.returncode != 0 and b"Permission denied" in r.stderr, "other SSH user names refused")
PY
    then
        kill "$pid" 2>/dev/null || true
        tail -20 "$root/var/log/stdout.log" >&2
        fail "SSH smoke test failed"
    fi
    log "Logging in as TempImm over telnet"

    if ! python3 - "$port" <<'PY'
import re, socket, sys, time
port = int(sys.argv[1])
host = socket.gethostbyname(socket.gethostname())   # TFE binds the hostname's address
s = socket.create_connection((host, port), timeout=10)

def read(wait=1.5):
    out, end = b"", time.time() + wait
    s.settimeout(0.3)
    while time.time() < end:
        try:
            d = s.recv(65536)
        except socket.timeout:
            continue
        if not d:
            break
        out += d
        end = max(end, time.time() + 0.4)
    global raw
    raw = out
    out = re.sub(rb"\xff[\xfb-\xfe].|\xff[\xf0-\xfa]", b"", out)
    return re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", out.decode("latin-1")).replace("\r", "")

def cmd(line, wait=1.5, more=False):
    s.sendall(line.encode() + b"\r\n")
    out = read(wait)
    while more and "-- MORE --" in out[-200:]:
        s.sendall(b"\r\n")
        out += read(1)
    return out

def need(cond, what):
    print(("ok   " if cond else "FAIL ") + what)
    if not cond:
        sys.exit(1)

need("Choice:" in read(3), "greeting and login menu")
need("Password" in cmd("TempImm"), "name accepted")
cmd("llama", 3); cmd("", 2); out = cmd("", 3)
need("Path of Death" in out or "Vnum:" in out, "logged in and placed in a room")
mem = cmd("memory", 3, more=True)
counts = {k: int(v) for k, v in re.findall(r"^\s*(Areas|Rooms|Mobs|Objects|Exits|Resets|Species|Shops)\s+(\d+)", mem, re.M)}
print("     world:", " ".join(f"{k}={v}" for k, v in counts.items()))
need(counts.get("Areas", 0) > 0 and counts.get("Rooms", 0) > 0, "world loaded (areas and rooms > 0)")
need("You leave north" in cmd("north"), "walked north")
need("Vnum: 33750" in cmd("look"), "look shows the next room")
# TFE ends lines with LF CR. World text with CR LF CR LF in it (the damaged
# 2009 area files) shows as a blank line after every line.
need(b"\r\n\r\n" not in raw, "room description is not double-spaced")
need("TempImm" in cmd("who"), "who lists the player")
need("saved" in cmd("save"), "save")
cmd("shutdown", 5)
print("ok   shutdown sent")
PY
    then
        kill "$pid" 2>/dev/null || true
        tail -20 "$root/files/bugs.txt" >&2
        fail "smoke test failed"
    fi

    rc=0
    for _ in $(seq 1 60); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid"; fail "tfe did not exit after shutdown"; fi
    wait "$pid" || rc=$?
    [[ -f "$root/var/control/shutdown" ]] || fail "no var/control/shutdown after in-game shutdown (exit $rc)"
    log "TFE shut down from in game: $(cat "$root/var/control/shutdown")"
    log "Smoke test passed"
}

MODE="${TFE_MODE:-build}"
case "$MODE" in
    build) [[ -d /out ]] || fail "missing /out mount" ;;
    test)  smoke_test; exit 0 ;;
    *) echo "unknown TFE_MODE: $MODE (build, test)" >&2; exit 2 ;;
esac

WORK="$(mktemp -d /tmp/tfe-compile.XXXXXX)"
compile_scratch "$WORK"
install -m 0755 "$WORK/src/tfe" "$WORK/src/daemon" /out/
rm -rf "$WORK"

log "Compile finished → /out"
ls -la /out

# -----------------------------------------------------------------------------
# RPM: package prebuilt /out binaries via packaging/tfe.spec
# -----------------------------------------------------------------------------
command -v rpmbuild >/dev/null 2>&1 || fail "rpmbuild not found in image; rebuild tfe-base (./build.sh -r)"
[[ -f "$SPEC_FILE" ]] || fail "missing $SPEC_FILE"

VERSION="$(awk '/^Version:/{print $2; exit}' "$SPEC_FILE")"
[[ -n "$VERSION" ]] || fail "could not parse Version from $SPEC_FILE"

log "Building RPM (tfe-${VERSION}) from prebuilt dist/ artifacts"

RPM_TOPDIR="$(mktemp -d /tmp/tfe-rpmbuild.XXXXXX)"
STAGE="$(mktemp -d /tmp/tfe-rpmsrc.XXXXXX)"
cleanup_rpm() { rm -rf "$RPM_TOPDIR" "$STAGE"; }
trap cleanup_rpm EXIT

mkdir -p "$RPM_TOPDIR"/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
STAGEDIR="$STAGE/tfe-${VERSION}"
mkdir -p "$STAGEDIR"

# Stage a clean source tree; exclude VCS, build output and prior RPMs.
tar -C /src -cf - \
    --exclude='./.git' \
    --exclude='*.rpm' \
    --exclude='./dist' \
    --exclude='./src/OBJ' \
    --exclude='./src/tfe' \
    --exclude='./src/daemon' \
    . | tar -C "$STAGEDIR" -xf -

# Ship the binaries we just compiled so %build can use them.
mkdir -p "$STAGEDIR/dist"
install -m 0755 /out/tfe /out/daemon "$STAGEDIR/dist/"

tar -C "$STAGE" -czf "$RPM_TOPDIR/SOURCES/tfe-${VERSION}.tar.gz" "tfe-${VERSION}"
cp "$SPEC_FILE" "$RPM_TOPDIR/SPECS/tfe.spec"

# --nodeps: BuildRequires use the (x86-32) virtual provides, which a
# UBI image may not resolve the same way; the toolchain is in tfe-base.
rpmbuild \
    --define "_topdir $RPM_TOPDIR" \
    --nodeps \
    -ba \
    "$RPM_TOPDIR/SPECS/tfe.spec"

mkdir -p /out/rpm
find "$RPM_TOPDIR/RPMS" "$RPM_TOPDIR/SRPMS" -type f -name '*.rpm' -exec cp -a {} /out/rpm/ \;

trap - EXIT
cleanup_rpm

log "RPM finished → /out/rpm"
ls -la /out /out/rpm
