# /etc/tfe/tfe.env — read by tfe.service (EnvironmentFile=)
#
# Game port. TFE also opens TFE_PORT+1 for its "who" listing. It binds the
# address that this host's own hostname resolves to (gethostbyname), not
# 0.0.0.0, so make sure the hostname resolves to the interface players use.
TFE_PORT=4000

# Extra flags before the port: -w starts wizlocked, -g godlocked (or both,
# in that order).
TFE_FLAGS=

# Upstream test immortal from the README: character TempImm (level 99),
# password "llama", in account "temp" (account password also "llama").
# With "yes", every start of tfe.service makes sure both halves exist,
# adding the "temp" account to files/accounts and player/TempImm if missing;
# existing accounts and players are never changed. Setting it after the first
# start works too: systemctl restart tfe.
#
# To log in: telnet <host> 4000, and at "Choice:" type the character name
# TempImm (not the account name), then "Password:" llama, then press Return
# twice for the two message screens.
#
# Anyone who knows the README can log in as a god with it, so leave this off
# on a reachable server. Turning it back off does not delete TempImm; to
# remove it: systemctl stop tfe; mv /var/lib/tfe/player/TempImm
# /var/lib/tfe/lost+found/ (the temp account can stay).
TFE_SEED_TEST_LOGIN=no
