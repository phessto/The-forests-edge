# /etc/tfe/tfe.env — read by tfe.service (EnvironmentFile=)
#
# Game port. TFE also opens TFE_PORT+1 for its "who" listing. It binds the
# address that this host's own hostname resolves to (gethostbyname), not
# 0.0.0.0, so make sure the hostname resolves to the interface players use.
TFE_PORT=4000

# Extra flags before the port: -w starts wizlocked, -g godlocked (or both,
# in that order).
TFE_FLAGS=

# The RPM carries the upstream test immortal from the README (TempImm, level
# 99, password "llama") and its "temp" account. They are copied into the game
# on first start only when this is "yes". Anyone who knows the README can log
# in as a god with them, so leave this off on a reachable server.
TFE_SEED_TEST_LOGIN=no
