# /etc/tfe/tfe.env — read by tfe.service (EnvironmentFile=)
#
# Game port. TFE also opens TFE_PORT+1 for its "who" listing. It binds the
# address that this host's own hostname resolves to (gethostbyname), not
# 0.0.0.0, so make sure the hostname resolves to the interface players use.
TFE_PORT=4000

# SSH listener, built into tfe (libssh). OFF unless TFE_SSH_PORT is set:
# uncomment the TFE_SSH_PORT line below and restart tfe to turn it on.
# Players then connect with
#   ssh -p 4022 play@<host>
# and get the normal login screen; the in-game account password is the real
# authentication, now encrypted in transit. SSH itself accepts the one user
# name TFE_SSH_USER (default play) with no password. Like the game port, it
# binds the address the hostname resolves to. Open it in the firewall:
#   firewall-cmd --permanent --add-port=4022/tcp && firewall-cmd --reload
#
# tfe reads these itself, so they work the same when tfe is started by hand.
# A --ssh-port / --ssh-user / --ssh-max-sessions / --ssh-hostkey-dir /
# --ssh-login-timeout option on the command line (TFE_FLAGS) overrides the
# variable; --no-ssh turns the listener off whatever is set here. Unset or
# empty means "use the default". A bad value stops the boot with a message in
# the journal. The other settings only matter once TFE_SSH_PORT is set; they
# are shown commented out with their defaults.
#
# Port: 1-65535 (not TFE_PORT or TFE_PORT+1), or off (also 0).
# Default: off. Example: 4022.
#TFE_SSH_PORT=4022
# SSH user name players log in with: letters, digits, . _ -, or * for any
# name. Default: play.
#TFE_SSH_USER=play
# Most SSH connections at once (logins in progress included), 1-1024; more
# are refused at connect. Default: 32.
#TFE_SSH_MAX_SESSIONS=32
# Seconds a connection gets to finish the SSH handshake and open the game
# (5-600); idle players are then handled by the game itself. Default: 30.
#TFE_SSH_LOGIN_TIMEOUT=30
# Host keys (ssh_host_ed25519_key, ssh_host_rsa_key) are generated on the
# first start with SSH on and reused after; their fingerprints are printed
# at every start (journalctl -u tfe | grep 'SSH: Host key'). Default: ../ssh
# from the working directory, i.e. /var/lib/tfe/ssh. A directory outside
# /var/lib/tfe is read-only to the service (ProtectSystem=strict).
#TFE_SSH_HOSTKEY_DIR=/var/lib/tfe/ssh

# Extra flags before the port: -w starts wizlocked, -g godlocked (or both,
# in that order).
TFE_FLAGS=

# Upstream test immortal from the README: character TempImm (level 99),
# password "llama", in account "temp" (account password also "llama").
# With "yes", every start of tfe.service makes sure both halves exist,
# adding the "temp" account to files/accounts and player/TempImm if missing;
# existing accounts and players are never changed. Setting it after the first
# start works too: systemctl restart tfe.
#
# To log in: telnet <host> 4000, and at "Choice:" type the character name
# TempImm (not the account name), then "Password:" llama, then press Return
# twice for the two message screens.
#
# Anyone who knows the README can log in as a god with it, so leave this off
# on a reachable server. Turning it back off does not delete TempImm; to
# remove it: systemctl stop tfe; mv /var/lib/tfe/player/TempImm
# /var/lib/tfe/lost+found/ (the temp account can stay).
TFE_SEED_TEST_LOGIN=no
