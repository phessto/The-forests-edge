#!/usr/bin/awk -f
# /usr/libexec/tfe/tfe-accounts — read and merge TFE's files/accounts
#
# Format (src/account.cc save_accounts/load_accounts): a count, then per
# account 7 quoted strings (name, email, password, new email, confirmation
# code, notes, timezone; \" and \\ escaped) and 4 numbers. The game finds
# accounts by binary search, so the list must stay sorted by name
# (strcasecmp order).
#
#   tfe-accounts -v mode=names FILE        print each account name
#   tfe-accounts -v mode=merge FILE NEW    print FILE with every account
#                                          from NEW whose name FILE lacks,
#                                          inserted in sorted position
# Exits 1 (printing nothing) if a file does not parse.
BEGIN { RS = "^$"; LC_ALL = "C" }

# Split one whole accounts file into records; returns the count, or -1.
function parse(text, rec, key,    pos, n, i, f, c, tok, numtok, start) {
    pos = 1; n = length(text)
    # count
    while (pos <= n && substr(text, pos, 1) ~ /[ \t\r\n]/) pos++
    start = pos
    while (pos <= n && substr(text, pos, 1) ~ /[0-9-]/) pos++
    if (pos == start) return -1
    numtok = substr(text, start, pos - start) + 0
    for (i = 1; i <= numtok; i++) {
        rec[i] = ""
        for (f = 1; f <= 11; f++) {
            while (pos <= n && substr(text, pos, 1) ~ /[ \t\r\n]/) pos++
            if (pos > n) return -1
            start = pos
            if (f <= 7) {
                if (substr(text, pos, 1) != "\"") return -1
                pos++; tok = ""
                while (pos <= n && (c = substr(text, pos, 1)) != "\"") {
                    if (c == "\\") { pos++; c = substr(text, pos, 1) }
                    tok = tok c; pos++
                }
                if (pos > n) return -1
                pos++
                if (f == 1) key[i] = tok
            } else {
                while (pos <= n && substr(text, pos, 1) ~ /[0-9-]/) pos++
                if (pos == start) return -1
            }
            # keep the raw text so nothing is re-encoded
            rec[i] = rec[i] substr(text, start, pos - start) (f < 7 ? "\n" : (f == 7 ? "\n" : (f < 11 ? " " : "\n\n")))
        }
    }
    return numtok
}

FILENAME == ARGV[1] { a = $0 }
FILENAME == ARGV[2] { b = $0 }

END {
    na = parse(a, ra, ka)
    if (na < 0) { print "tfe-accounts: cannot parse " ARGV[1] > "/dev/stderr"; exit 1 }
    if (mode == "names") { for (i = 1; i <= na; i++) print ka[i]; exit 0 }
    nb = parse(b, rb, kb)
    if (nb < 0) { print "tfe-accounts: cannot parse " ARGV[2] > "/dev/stderr"; exit 1 }
    for (j = 1; j <= nb; j++) {
        dup = 0
        for (i = 1; i <= na; i++) if (tolower(ka[i]) == tolower(kb[j])) dup = 1
        if (dup) continue
        # insert at the first position whose name sorts after the new one
        for (p = 1; p <= na && tolower(ka[p]) < tolower(kb[j]); p++) ;
        for (i = na; i >= p; i--) { ra[i+1] = ra[i]; ka[i+1] = ka[i] }
        ra[p] = rb[j]; ka[p] = kb[j]; na++
    }
    printf "%d\n\n", na
    for (i = 1; i <= na; i++) printf "%s", ra[i]
}
