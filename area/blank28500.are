"// Check for full health
loop( all_in_room ) {
  drain_stat( rch, hunger, 20 );
  drain_stat( rch, thirst, 20 );

  i = find_stat( rch, hit );
  j = find_stat( rch, max_hit );

  if ( i == j ) {
    transfer( rch, find_room( 28556 ) );
  }
  else {
    acode( room, 3 );
  }
}
"
