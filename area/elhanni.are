"if( can_fly( ch ) ) {

  act_tochar( \"You fly off the boulder.\", ch );

  act_notchar( \"$n flies off the boulder.\", ch );

  transfer( ch, find_room( 4013 ) );

  }

else {

  if( find_skill( ch, climb ) > random( 1, 4 ) ) {

    act_tochar(\"You carefully climb down the large block of stone.\", ch );

    act_notchar(\"$n carefully climbs down to the limestone shelf below.\", ch );

    transfer( ch, find_room( 4013 ));

    act_notchar(\"$n climbs down from the boulder to the east.\", ch );

    }

  else {

    act_tochar(\"You fail to find the necessary footholds to climb down.\", ch );

