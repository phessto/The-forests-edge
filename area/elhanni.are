  transfer( ch, find_room( 4013 ));

  act_tochar(\"You land, a crumpled heap, on the limestone floor.\", ch );

  act_notchar(\"$n lands in a crumpled heap, having fallen from the boulder to the east.\", ch );

  dam_message( ch, i, \"the fall\" );

  inflict( ch, ch, i, \"falling\" );

  }

