"if( find_stat( ch, level ) > 93 )

  continue;

if( is_exhausted( ch ) || is_follower( ch ) || !is_standing( ch ) )

  continue;

i = 15;

if( find_stat( ch, wis ) > 15 )

  i = i - 2;

if( find_stat( ch, int ) > 16 )

  i = i - 2;

if( is_player( ch ) ) {

  if( class( ch ) == ranger )

    i = i - 5;

  }

if( race( ch ) == elf )

  i = i - 1;

if( race( ch ) == dwarf )

  i = i - 2;

j = random( 1, i );

if( j == 3 ) {

  act_tochar( #makesout, ch );

  continue;

  }

else {

  act_tochar( #try, ch );

  transfer( ch, find_room( 82039 ) );

  modify_move( ch, -20 );

  modify_move( ch, -1 );

  loop( followers ) {

    if( is_exhausted( rch ) || !is_standing( rch ) ) {

      act_tochar( #tooexhausted, rch );

      act_tochar( #hestired, ch );

      }

    else {

      act_tochar( #follow, rch );

      act_tochar( #follows, ch );

      transfer( rch, find_room( 82039 ) );

      modify_move( rch, -20 );

      modify_move( rch, -1 );

      }

    }

  }

