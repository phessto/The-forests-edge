"if( rflag( reset0, room ) ) {

  remove_rflag( reset0, room );

  act_tochar( #play, ch );

  act_notchar( #rplay, ch );

  if( find_stat( ch, level ) > 90 ) {

    acode( room, 4 );

    end;

    }

  wait( 3 );

  if( !char_in_room( ch, find_room( 981 ) ) )

    end;

  act_tochar( #one, ch );

  act_notchar( #rone, ch );

  acode( room, 3 );

  wait( 2 );

  if( !char_in_room( ch, find_room( 981 ) ) )

    end;

  act_tochar( #two, ch );

  act_notchar( #rtwo, ch );

  acode( room, 3 );

  wait( 2 );

  if( !char_in_room( ch, find_room( 981 ) ) )

    end;

  act_tochar( #three, ch );

  act_notchar( #rthree, ch );

  acode( room, 3 );

  set_rflag( reset0, room );

  }

else

  act_tochar( #wait, ch );

