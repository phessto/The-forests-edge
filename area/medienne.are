E
"1west wall unremarkable plain stone"
"Grey river rock has been stacked and mortared to form a thick, rough wall. 

Like many other parts of Medienne, the wall shows signs of recent battle;

pockmarks from explosives and scratches from weapons are quite evident along

the length of the barrier.  A few of the smaller rocks have broken off,

leaving crumbling indentations that look like handholds of some sort.

"
A
"climb"
"handholds wall plain stone"
"if( can_fly( ch ) ) {

  wait( 0 );

  send_to_char( #fly, ch );

  act_notchar( #chfly, ch );

  transfer( ch, find_room( 171 ) ) ;

  act_notchar( #roomfly, ch );

  }

else {

  if( find_skill( ch, climb ) > 6 ) {

    use_skill( ch, climb );

    send_to_char( #climb, ch );

    act_notchar( #roomclimb, ch );

    transfer( ch, find_room( 171 ) );

    act_notchar ( #arrival, ch );

    }

  else {

    act_tochar( #fail, ch );

    }

  }

