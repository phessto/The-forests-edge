"Knight Marshal Arthur"
"if( !mob_in_room( 2605, room ) ) {

  continue;

  end;

  }

wait( 3 );

if( cflag( 180, ch ) ) {

  act_tochar( \"The Knight Marshal glowers at you, one who left the order.\", ch );

  end;

  }

if( cflag( 179, ch ) ) {

  act_tochar( \"You kneel in homage before the Knight Marshal.\", ch );

  end;

  }

if( !wearing_obj( 4233, ch ) ) {

  mpcode( mob_in_room( 2605, room ), 2 );

  end;

  }

if( !wearing_obj( 4240, ch ) ) {

  mpcode( mob_in_room( 2605, room ), 2 );

  end;

  }

if( !wearing_obj( 4243, ch )

  && !wearing_obj( 4245, ch )

  && !wearing_obj( 4246, ch ) ) {

  mpcode( mob_in_room( 2605, room ), 2 );

  end;

  }

act_tochar( #join1, ch );

act_notchar( #rjoin1, ch );

wait( 3 );

if( !char_in_room( ch, room ) ) end;

  act_room( #join2, ch );

act_room( #join2b, ch );

wait( 4 );

if( !char_in_room( ch, room ) ) end;

  act_room( #join3, ch );

act_tochar( #left, ch );

act_notchar( #rleft, ch );

wait( 4 );

if( !char_in_room( ch, room ) ) end;

  act_room( #join4, ch );

act_tochar( #right, ch );

act_notchar( #rright, ch );

wait( 4 );

if( !char_in_room( ch, room ) ) end;

  act_room( #join5, ch );

act_tochar( #head, ch );

act_notchar( #rhead, ch );

wait( 4 );

if( !char_in_room( ch, room ) ) end;

  act_room( #punch, ch );

act_notchar( #rpunched, ch );

i = 30;

dam_message( ch, i, \"Knight Marshal's Heavy-Handed Blow\" );

inflict( ch, mob, i, \"The Joining Rite of the Medienne Knights\" );

set_resting( ch );

wait( 1 );

if( !char_in_room( ch, room ) ) end;

  act_tochar( #punched, ch );

wait( 4 );

if( !char_in_room( ch, room ) ) end;

  act_room( #joined, ch );

set_cflag( 179, ch );

obj_to_room( oload( 4233 ), find_room( 5 ) );

wait( 4 );

if( !char_in_room( ch, room ) ) end;

  act_tochar( #arise, ch );

if( is_resting( ch ) ) {

  act_tochar( #stand, ch );

  act_notchar( #rstand, ch );

  interpret( ch, \"stand\" );

  }

loop( all_in_room ) {

  if( rch == mob_in_room( 2599, room ) )

    interpret( mob_in_room( 2599, room ), \"cheer\", ch );

  if( rch == mob_in_room( 2600, room ) )

    interpret( mob_in_room( 2600, room ), \"cheer\", ch );

  }

wait( 1 );

act_area( #bells, ch );

