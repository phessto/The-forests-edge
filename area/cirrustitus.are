"if( is_player( ch ) && !is_mounted( ch ) && !is_sleeping( ch ) && !is_resting( ch ) && !is_fighting( ch ) && find_stat( ch, level ) > 59 ) {
  act_room( #pegasus, ch );
  mob = mload( 2571, room );
  wait( 2 );
  if( find_skill( ch, riding ) > 4 ) {
    act_tochar( #mount, ch );
    act_notchar( #nmount, ch );
    set_mount( ch, mob );
    wait( 2 );
    act_tochar( #fly, ch );
    act_notchar( #nfly, ch );
    wait( 1 );
    transfer( ch, find_room( 36772 ) );
    act_tochar( #arrive, ch );
    act_notchar( #narrive, ch );
    set_mount( ch, null );
    junk_mob( mob );
    remove_cflag( 68, ch );
    }
  else {
    act_tochar( #fail, ch );
    act_notchar( #nfail, ch );
    wait( 1 );
    act_room( #away, ch );
    junk_mob( mob );
    remove_cflag( 68, ch );
    }
  }
else {
  remove_cflag( 68, ch );
  continue;
  }
"
