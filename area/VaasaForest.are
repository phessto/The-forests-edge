if( can_fly( ch ) ) {
  act_tochar( #fly, ch );
  act_notchar( #rfly, ch );
  transfer( ch, find_room( 19003 ) );
  act_notchar( #flyarr, ch );
}
if( !can_fly( ch ) ) {
  if( size( ch ) < 5 ) {
    if( race( ch ) == elf ) {
      if( mob_in_room( 2425, find_room( 19311 ) ) ) {
        act_tochar( #helped, ch );
        act_notchar( #rhelped, ch );
        transfer( ch, find_room( 19003 ) );
        act_notchar( #arr, ch );
      }
    } else {
      act_tochar( #no, ch );
      end;
    }
  }
  else {
    act_tochar( #up, ch );
    act_notchar( #rup, ch );
    transfer( ch, find_room( 19003 ) );
    act_notchar( #arr, ch );
  }
}
loop( followers ) {
  if( is_exhausted( rch ) ) {
    act_tochar( \"You're too tired to follow right now.\", rch );
    end;
  }
  if( is_resting( ch ) || is_sleeping( ch )) {
    act_tochar( \"You must be standing to do that.\", ch );
    end;
  }
  if( size( rch ) > 4 ) {
    act_tochar( #up, rch );
    act_notchar( #rup, rch );
    transfer( ch, find_room( 19003 ) );
    act_notchar( #arr, rch );
  }
  else {
    act_tochar( #lifted, rch );
    act_notchar( #rlifted, rch );
