"if( !is_resting( ch ) ) {
  if( !char_affected( ch, float ) ) {
    if( find_stat( ch, dex ) < random( 10, 22 ) && find_skill( ch,climb ) < random( 1,9 ) ) {
      act_tochar( #mud, ch );
      act_notchar( #rmud, ch );
      transfer( ch, find_room( 86001 ) );
      act_notchar( #imud );
      interpret( ch,\"sit\" );
      continue;
    }
    else{
      use_skill( ch,climb );
      act_tochar( #makes, ch );
      continue;
    }
  }
  else {
    act_tochar( #float, ch );
    continue;
  }
  loop ( followers ) {
    ch = rch;
    acode( room,1 );
  }
}
"
