A
"say yell"
"fear"
"if( rflag( reset0, room ) && cflag( 101, ch ) ) {

  remove_rflag( reset0, room );

  remove_rflag( reset1,room );

  set_rflag( no.recall,room );

  act_tochar( #say, ch );

  act_notchar( #rsay, ch );

  wait( 2 );

  act_room( #open1, ch );

  loop( all_in_room) {

    if( is_player( rch ) || is_pet( rch ) ) {

      do_spell( paralyze, null, rch,7 );

    }

  }

  wait( 3 );

  act_room( #open2, ch );

  wait( 2 );

  open( room,west );

  act_room( #open, ch);

  loop( all_in_room) {

    if( is_player( rch ) || is_pet( rch ) ) {

      do_spell( slow, null, rch, 7 );

    }

  }

  set_rflag( reset1,room );

  remove_rflag( no.recall, room );

}

else

  if( !cflag( 101, ch ) )

    act_tochar( #language, ch );

"
E
