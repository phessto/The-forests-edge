"say yell"
"sky skies"
"if( rflag( reset0, room ) && cflag( 101, ch ) ) {

  remove_rflag( reset0, room );

  remove_rflag( reset1,room );

  set_rflag( no.recall,room );

  act_tochar( #say,ch );

  act_notchar( #rsay,ch );

  wait( 1 );

  act_room( #open2, ch );

  wait( 1 );

  act_room( #open3, ch );

  wait( 2 );

  open( room,north );

  act_room( #open, ch);

  loop( all_in_room) {

    if( is_player( rch ) || is_pet( rch ) ) {

      i = dice( 5, 10, 50 );

      dam_message( rch, i, \"the impact\" );

      inflict( rch, mob, i, \"gale of wind\" );

      set_resting ( rch );

    }

  }

  set_rflag( reset1,room );

  remove_rflag( no.recall, room );

}

else

  act_tochar( #language, ch );

