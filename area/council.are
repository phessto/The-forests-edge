""
"if( rflag( reset0, room ) ) {

  i = 87036;

  j = num_in_room( find_room( i ) );

  if( j > 0 && is_player( ch ) ) {

    remove_rflag( reset0, room );

    remove_rflag( reset1, room );

    set_rflag( no.recall, room );

    mob = rand_char( find_room( i ) );

    if( j == 1 ) {

      act_room( #lastpounce, ch );

    }

    else {

      act_room( #pounce, ch );

    }

    transfer( mob, room );

    mpcode( mob, 2 );

    wait( 2 );

    remove_rflag( no.recall, room );

    set_rflag( reset1, room );

  }

}

