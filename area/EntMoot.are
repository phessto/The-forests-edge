if( find_skill( ch, entish ) == 10 ) {

  act_tochar( #rune_intro ch );

  wait( 2 );

  if( !char_in_room( ch, find_room( 10003 ) ) )

    end;

  act_tochar( #runes1, ch );

  act_notchar( #rrunes1, ch );

