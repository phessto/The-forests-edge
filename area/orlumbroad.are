"moss"
"if( is_player( ch ) ) {

  act_tochar( #moss, ch );

  act_notchar( #rmmoss, ch );

  wait( 1 );

  i = 1d20;

  if( rflag( reset1, room ) ) {

    if( i < 11 ) {

      obj = oload( 81 );

      obj_to_char( obj, ch );

      act_tochar( #gotmoss, ch );

      act_notchar( #rmgotmoss, ch );

      remove_rflag( reset1, room );

      end;

      }

    act_tochar( #nomoss, ch );

    act_notchar( #rmnomoss, ch );

    remove_rflag( reset1, room );

    }

  else

    act_tochar( #nomoss, ch );

  }

