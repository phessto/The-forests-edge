"__HOWL_CODE__"
""
"mob = mob_in_room( 2669, room );
if( mob ) {
  if( !is_fighting( mob ) ) {
    if( !is_silenced( mob ) ) {
      act_room( #above_lair, mob );
      loop( all_in_room ) {
        if( rch != mob ) {
          if( can_hear( rch ) ) {
            i = 3d21+3;
            sound_message( rch, i, \"the intense howling\" );
            inflict( rch, mob, i, \"The Howler\" );
            j = i / 10;
            if( j > 10 ) {
              j = 10;
              }
            if( j > 0 ) {
              if( rch ) {
                do_spell( deafen, mob, rch, j );
                }
              }
            }
          }
        else {
          if( can_hear( rch ) ) {
            if( find_stat( rch, hit ) < find_stat( rch, max_hit ) ) {
              do_spell( cure serious, mob, rch );
              }
            }
          }
        }
      room = find_room( 5021 );
      send_to_room( #lair, room );
      loop( all_in_room ) {
        if( can_hear( rch ) ) {
          i = 3d13+3;
          sound_message( rch, i, \"the intense howling\" );
          inflict( rch, null, i, \"The Howler\" );
          j = i / 10;
          if( j > 10 ) {
            j = 10;
            }
          if( j > 0 ) {
            if( rch ) {
              do_spell( deafen, null, rch, j );
              }
            }
          }
        }
      room = find_room( 5020 );
      send_to_room( #before_lair, room );
      loop( all_in_room ) {
        if( can_hear( rch ) ) {
          i = 3d7+3;
          sound_message( rch, i, \"the intense howling\" );
          inflict( rch, null, i, \"The Howler\" );
          j = i / 10;
          if( j > 10 ) {
            j = 10;
            }
          if( j > 0 ) {
            if( rch ) {
              do_spell( deafen, null, rch, j );
              }
            }
          }
        }
      room = find_room( 5019 );
      send_to_room( #beyond_lair, room );
      i = 5001;
      loop( i < 5019 ) {
        room = find_room( i );
        send_to_room( #cavern, room );
        i = i + 1;
        }
      }
    }
  }
