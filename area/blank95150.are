"if( has_obj( 4313, ch ) && !wearing_obj( 4313, ch ) ) {

  act_tochar( #cant, ch );

  end;

  }

if( is_player( ch ) ) {

  if( wearing_obj( 4313, ch ) ) {

    if( is_name( \"UOFD\", clan_abbrev( ch ) ) ) {

      act_tochar( #twist, ch );

      act_notchar( #ntwist, ch );

      wait( 1 );

      act_tochar( #bamfout, ch );

      act_notchar( #nbamfout, ch );

      transfer( ch, find_room( 28024 ) );

      act_notchar( #narrive, ch );

      }

    else {

      act_tochar( #nope, ch );

      act_notchar( #rnope, ch );

      }

    }

  else

    continue;

  }

else

  continue;

