"if( !mob_in_room( 2370, find_room( 70050 ) ) ) {
  transfer_all( find_room( 70050 ), room );
  act_tochar( #escape, ch );
  act_notchar( #rescape, ch );
  }
if( !mob ) {
  junk_mob( mob_in_room( 2370, find_room( 70050 ) ) );
  transfer_all( find_room( 70050 ), room );
  act_tochar( #dead, ch );
  act_notchar( #rdead, ch );
  loop( obj_in_room( 11, find_room( 70050 ) ) ) {
    obj_to_room( obj_in_room( 11, find_room( 70050 ) ), room );
    }
  loop( obj_in_room( 10, find_room( 70050 ) ) ) {
    obj_to_room( obj_in_room( 10, find_room( 70050 ) ), room );
    }
  }
wait( random( 0, 1 ) );
if( char_in_room( ch, find_room( 70050 ) ) ) {
  if( random( 1, 3 ) > 1 ) {
    i = 3d10+20;
    dam_message( ch, i, \"+powerful muscle contractions\" );
    inflict( ch, mob, i, \"stomach muscles\" );
    }
  if( random( 1, 3 ) > 1 ) {
    i = 6d7+15;
    acid_message( ch, i, \"the toxic digestive acid\" );
    inflict_acid( ch, mob, i, \"stomach acid\" );
    poison( ch );
    }
  }
acode( find_room( 70050 ), 2 );
"
