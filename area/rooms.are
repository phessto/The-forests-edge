  act_tochar( #hurt, ch );
  act_notchar( #nhurt, ch );
  wait(1);
  transfer( ch, find_room( 11236 ) );
  act_notchar( #fall, ch );
  dam_message( ch, 4d5+35, \"The fall\" );
  inflict( ch, null, 4d5+35, \"falling down a cliff\" );
  modify_move( ch, -10 );
  set_resting( ch );
