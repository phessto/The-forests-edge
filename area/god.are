i = find_stat( victim, max_hit );
j = find_stat( victim, hit );
obj = obj_to_room( oload( 3707 ), room );
if( i == j ) { set_singular( obj, \"[ perfect health ]\" ); end; }
if( 10*j > 9*i ) { set_singular( obj, \"[ slightly scratched ]\" ); end; }
if( 10*j > 8*i ) { set_singular( obj, \"[ few bruises ]\" ); end; }
if( 10*j > 7*i ) { set_singular( obj, \"[ some cuts ]\" ); end; }
if( 10*j > 5*i ) { set_singular( obj, \"[ badly wounded ]\" ); end; }
if( 10*j > 6*i ) { set_singular( obj, \"[ badly wounded ]\" ); end; }
if( 10*j > 4*i ) { set_singular( obj, \"[ many nasty wounds ]\" ); end; }
if( 10*j > 3*i ) { set_singular( obj, \"[ bleeding freely ]\" ); end; }
if( 10*j > 2*i ) { set_singular( obj, \"[ covered in blood ]\" ); end; }
if( 10*j > 1*i ) { set_singular( obj, \"[ leaking guts ]\" ); end; }
if( 10*j > 0 ) { set_singular( obj, \"[ mostly dead ]\" ); end; }
