obj = obj_to_container( oload( 3689 ), has_obj( 4726, ch ) );
obj = obj_to_container( oload( 3690 ), has_obj( 4726, ch ) );
obj = obj_to_container( oload( 3691 ), has_obj( 4726, ch ) );
obj = obj_to_container( oload( 3692 ), has_obj( 4726, ch ) );
k = 3688 + 1d4;
obj = has_obj( k, has_obj( 4726, ch ) );
set_singular( obj, word( name( ch, has_obj( 3688 - i, room ) ), 11 ) );
arg = word( name( ch, has_obj( 3685, room ) ), 3 - j );
cmd = word( name( ch, has_obj( 3685 + i, room ) ), j );
set_singular( obj, string( \"$t died before the $T, but neither died to the spectre of a dwarven $y\", ch, obj, null, arg, cmd ) );
loop( is_altered( obj ) ) {
  k = 3688 + 1d4;
  obj = has_obj( k, has_obj( 4726, ch ) );
}
set_singular( obj, word( name( ch, has_obj( 3685 + i, room ) ), 3 - j ) );
arg = word( name( ch, has_obj( 3688, room ) ), j );
cmd = word( name( ch, has_obj( 3685, room ) ), j );
set_singular( obj, string( \"$t witnessed the deaths of the $T and the $y\", ch, obj, null, arg, cmd ) );
loop( is_altered( obj ) ) {
  k = 3688 + 1d4;
  obj = has_obj( k, has_obj( 4726, ch ) );
}
set_singular( obj, word( name( ch, has_obj( 3685, room ) ), 11 ) );
arg = word( name( ch, has_obj( 3688 - i, room ) ), j );
cmd = word( name( ch, has_obj( 3688, room ) ), 3 - j );
set_singular( obj, string( \"$t and the $T each witnessed the first of their party fall to a spectre of a dwarven $y\", ch, obj, null, arg, cmd ) );
loop( is_altered( obj ) ) {
  k = 3688 + 1d4;
  obj = has_obj( k, has_obj( 4726, ch ) );
}
set_singular( obj, word( name( ch, has_obj( 3685 + i, room ) ), 11 ) );
arg = word( name( ch, has_obj( 3688 - i, room ) ), 3 - j );
cmd = word( name( ch, has_obj( 3688 - i, room ) ), 4 );
set_singular( obj, string( \"$t died $T but not to the spectre of a dwarven $y\", ch, obj, null, arg, cmd ) );
i = 3685;
loop( i < 3689 ) {
  obj_to_container( has_obj( i, room ), has_obj( 4726, ch ) );
  i++;
}
