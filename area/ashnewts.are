else {

  act_tochar( \"You root around through the ring of obsidian stones.\", ch );

  act_notchar( \"$n roots around through the ring of obsidian stones.\", ch );

  if( rflag( reset0, room ) ) {

    remove_rflag( reset0, room );

    i = find_skill( ch, searching );

    if( i > random( 0, 20 ) ) {

      if( random( 1, 3 ) == 2 ) {

        obj = obj_to_char( oload( 77 ), ch );

        act_tochar( \"You find $p!\", ch, obj );

        act_notchar( \"$n finds $p!\", ch, obj );

        }

      else {

        act_tochar( #noth, ch );

        act_notchar( #rnoth, ch );

        }

      }

    else {

      act_tochar( #noth, ch );

      act_notchar( #rnoth, ch );

      }

    }

  else {

    act_tochar( #noth, ch );

    act_notchar( #rnoth, ch );

    }

