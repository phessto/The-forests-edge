"i = 236;

if( get_religion( ch ) == Tarafas ) {

  if( class( ch ) == cleric || class( ch ) == paladin ) {

    if( find_stat( ch, prayer ) > 300 ) {

      drain_stat( ch, prayer, 0, -300 );

      if( race( ch ) == elf )

        i = 4532;

      else

        i = 4533;

      if( wearing_obj( 4532, ch )

        || wearing_obj( 4533, ch )

        || wearing_obj( 4534, ch ) ) {

        act_tochar( #failure, ch );

        drain_stat( ch, prayer, 0, -25 );

        end;

        }

      else {

        act_tochar( #pray, ch );

        obj_to_char( oload( i ), ch );

        interpret( ch, \"wear dawnstar.sprite\" );

        end;

        }

      }

    else {

      act_tochar( #failure, ch );

      drain_stat( ch, prayer, 0, -25 );

      end;

      }

    }

  else {

    if( find_stat( ch, prayer ) > 400 ) {

      drain_stat( ch, prayer, 0, -400 );

      if( race( ch ) == elf )

        i = 4533;

      else

        i = 4534;

      if( wearing_obj( 4532, ch )

        || wearing_obj( 4533, ch )

        || wearing_obj( 4534, ch ) ) {

        act_tochar( #failure, ch );

        drain_stat( ch, prayer, 0, -50 );

        end;

        }

      else {

        act_tochar( #pray, ch );

        obj_to_char( oload( i ), ch );

        interpret( ch, \"wear dawnstar.sprite\" );

        end;

        }

      }

    else {

      act_tochar( #failure, ch );

      drain_stat( ch, prayer, 0, -50 );

      end;

      }

