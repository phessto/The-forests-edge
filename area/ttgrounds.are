A
""
""
"// master archery acode:

// room -> the room to shoot at

// i -> the room to shoot from

// cmd -> the direction to shoot from

// 2380 = vyan archer

// 2381 = goblin archer

if ( ( mob = mob_in_room( 2380, find_room( i ) ) ) || ( mob = mob_in_room( 2381, find_room( i ) ) ) ) {

  if( is_fighting( mob ) ) {

    // just show off the fight

    act_room( string( #fighting, mob, null, is_fighting( mob ), cmd ), ch );

  } else if( is_standing( mob ) && can_see( mob ) ) {

    // note that archers can see invisible but not hidden.

    rch = rand_player( room );

    if( !rch ) end;

      if ( ( !char_affected( rch, hide ) ) && ( !char_affected( rch, camouflage ) ) )  {

      if( random( 0, 3 ) == 0 ) {

        send_to_room( string( #firearrow, null, null, null, cmd ), room );

        i = 1d100;

        fire_message( rch, i, string( \"$n's fire arrow\", mob ) );

        inflict_fire( rch, null, i, string( \"$n\", mob ) );

        continue;

      } else {

        send_to_room( string( #arrow, null, null, null, cmd ), room );

        i = 1d100;

        dam_message( rch, i, string(\"$n's arrow\", mob ) );

        inflict( rch, null, i, string( \"$n\", mob ) );

        continue;

      }

    }

  }

}

// we return with continue if an arrow was fired, and end otherwise.

end;

"
E
"arrow"
"Suddenly an arrow comes screaming into the room from the top of the wall to the $t!

"
E
"fighting"
"On the battlement to the $t, $n is distracted from shooting at you by his duel with $N.

"
E
"firearrow"
"Suddenly an arrow trailing green fire shoots down from the wall to the $t!

"
!
