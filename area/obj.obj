"punch"
"large punching bag"
"i = find_stat( ch, dex );

j = find_stat( ch, str );

k = 1d40;


if( class( ch ) == monk ) {

  if( i + j > k ) {

    if( k > 35 && find_skill( ch, demon slash ) ) {

      send_to_char( #demon_hit, ch );

      act_notchar( #rdemon_hit, ch );

    }

    else if( k > 30 && find_skill( ch, dragon strike ) ) {

      send_to_char( #dragon_hit, ch );

      act_notchar( #rdragon_hit, ch );

    }

    else if( k > 25 && find_skill( ch, eagle claw ) ) {

      send_to_char( #eagle_hit, ch );

      act_notchar( #reagle_hit, ch );

    }

    else if( k > 20 && find_skill( ch, bear grasp ) ) {

      send_to_char( #bear_hit, ch );

      act_notchar( #rbear_hit, ch );

    }

    else if( k > 15 && find_skill( ch, tiger paw ) ) {

      send_to_char( #tiger_hit, ch );

      act_notchar( #rtiger_hit, ch );

    }

    else {

      send_to_char( #punch_hit, ch );

      act_notchar( #rpunch_hit, ch );

    }

  }

  else

  {

    send_to_char( #swing_miss, ch );

    act_notchar( #swing_miss, ch );

  }

}

else {

  if( i + j > k ) {

    if( j > k ) {

      send_to_char( #slam_hit, ch );

      act_notchar( #rslam_hit, ch );

    }

    else {

      send_to_char( #punch_hit, ch );

      act_notchar( #rpunch_hit, ch );

    }

  }

  else {

    send_to_char( #punch_miss, ch );

    act_notchar( #rpunch_miss, ch );

  }

}

"
