  i = 10d10+550;

  inflict_fire( ch, null, i, \"Lonil's wrath\" );

  fire_message( ch, i, \"Lonil's wrath\", null );

  drain_stat( ch, str, 15, -5 );

  drain_stat( ch, str, 15, -5 );

  drain_stat( ch, str, 15, -5 );

}

