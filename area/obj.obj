    act_tochar( \"$N seems to meld with the shadows, avoiding your arrow.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_notchar( \"$N seems to meld with the shadows, avoiding $n's arrow.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_tochar( \"You meld with the shadows, avoiding an arrow from $p.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    act_notchar( \"$n melds with the shadows, avoiding an arrow from $p.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    i = 0;

    obj_to_room( oload( vnum( obj ) ), room );

    }

  }

if( i > 0 && shield( victim ) && !is_sleeping( victim ) ) {

  if( check_skill( victim, shield block, -50-j ) ) {

    use_skill( victim, shield block );

    act_tochar( \"$N blocks your arrow with $s shield.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_notchar( \"$N block $n's arrow with $s shield.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_tochar( \"You block an arrow from $p with your shield.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    act_notchar( \"$n blocks an arrow from $p with $s shield.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    i = 0;

    }

  }

if( i > 0 && find_skill( victim, tumble ) > 0 && !is_sleeping( victim ) ) {

  if( check_skill( victim, tumble, -60-j ) ) {

    use_skill( victim, tumble );

    act_tochar( \"$N tumbles away, avoiding your arrow.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_notchar( \"$N tumbles away, avoiding $n's arrow.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

