if( obj ) {

  set_cflag( 100, ch );

  if( !cflag( 123, ch ) )

    act_tochar( \"You nock $p, and carefully take aim.\", ch, obj );

  if( victim )

    act_tochar( \"You carefully take aim at $N.\", ch, obj, victim );

