"if( !is_fighting( ch ) ) {

  act_tochar( #fight, ch );

  end;

  }

junk_obj( obj, 1 );

if( get_religion( ch ) == Iniara ) {

  if( class( ch ) == Cleric || class( ch ) == Paladin )

    j = random( 1, 6 );

  else

    j = random( 1, 5 );

  if( j == 1 ) {

    act_tochar( #ouch, ch );

    act_notchar( #rouch, ch );

    i = random( 1, 5 );

    dam_message( ch, i, \"ruby shard\" );

    inflict( ch, mob, i, \"Iniara's dark magic\" );

    end;

    }

  else {

    act_tochar( #toss, ch );

    act_notchar( #rtoss, ch );

    i = random( 1, 5 );

    attack_magic( ch, victim, i, \"+ruby shard\" );

    end;

    }

  }

else

  act_tochar( #nothing, ch );

"
E
