"cast"
""
"if( 1d8 != 3 )

  continue;

j = 0;

if( is_name( first_word( arg ), \"conflagration\" ) )

  j = 1;

if( is_name( first_word( arg ), \"banishment\" ) )

  j = 2;

if( j == 0 )

  continue;

loop( all_in_room ) {

  if( is_name( skip_word( arg ), name( ch, rch ) ) )

    victim = rch;

  }

if( !victim )

  victim = is_fighting( ch );

if( !victim )

  continue;

if( race( victim ) != undead )

  continue;

if( j == 1 ) {

  k = cast_mana( conflagration, ch );

  if( find_stat( ch, mana ) < k )

    continue;

  modify_mana( ch, -k );

  act_tochar( #flare, ch, obj, null );

  act_notchar( #flares, ch, obj, null );

  do_spell( burning hands, null, ch, 10 );

  if( ch )

    cast_spell( conflagration, ch, victim, 3 * ( find_skill( ch, conflagration ) ) );

  }

if( j == 2 ) {

  k = cast_mana( banishment, ch );

  if( find_stat( ch, mana ) < k )

    continue;

  modify_mana( ch, -k );

  act_tochar( #flare, ch, obj, null );

  act_notchar( #flares, ch, obj, null );

  do_spell( burning hands, null, ch, 10 );

  if( ch )

    cast_spell( banishment, ch, victim, 3 * ( find_skill( ch, banishment ) ) );

  }

