  act_tochar( \"@eYou carefully insert the rune stone, 'Cho' into the blade, producing:@n\", ch );

  act_notchar( \"@e$n carefully inserts the rune stone, 'Cho' into a rune blade, producing:@n\", ch );

  act_room( \"@C$p@n\", ch, obj );

}

"
