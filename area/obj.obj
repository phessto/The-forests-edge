"end;

if( cflag( 97, ch ) )

  act_tochar( \"Your nose itches.\", ch );

else {

  set_cflag( 97, ch );

  act_tochar( \"You snort a pinch of sulfur.\", ch );

  act_notchar( \"$n snorts a pinch of sulfur.\", ch );

  i = 2d20+11;

  act_tochar( \"The powder reacts to your chemistry!\", ch );

  act_notchar( \"$n's head snaps back!\", ch );

  fire_message( ch, i, \"the burning sulfur powder\" );

  inflict_fire( ch, ch, i, \"snorting a pinch of sulfur\" );

  do_spell( blind, null, ch );

  j = 1;

  if( find_stat( ch, con ) < 5 )

    j = 0;

  if( find_stat( ch, str ) < 5 )

    j = 0;

  if( find_stat( ch, dex ) < 5 )

    j = 0;

  if( j == 1 )

    opcode( obj, 1 );

  else

    act_tochar( \"You are too weakened for the sulfur to have any more effect.\", ch );

  junk_obj( obj, 1 );

  wait( random( 10, 20 ) );

  remove_cflag( 97, ch );

  act_tochar( \"Your nose is less itchy.\", ch );

  }

"
