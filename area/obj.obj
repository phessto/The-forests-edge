"insert"
"Ash"
"obj = has_obj( 3873, ch );

opcode( obj, 3 );

if( cflag( 145, ch ) ) {

  act_tochar( \"A $y already has 3 rune stones embedded in it.\", ch, obj );

  remove_cflag( 145, ch );

  end;

}

act_obj = has_obj( 3884, ch );

if( !act_obj ) {

  act_tochar( \"You do not have that rune to carefully insert.\", ch );

  end;

}

if( is_name( \"Ash\", name( ch, obj ) ) )

  act_tochar( \"Your rune blade already has 'Ash' embedded in it.\", ch );

else {

  junk_obj( act_obj, 1 );

  if( obj_value( obj, 0 ) != 0 )

    do_spell( obscure, null, obj, 10 );

  if( cflag( 146, ch ) )

    set_singular( obj, string( \"rune blade: Ash\", ch, obj ) );

  else

    if( first_word( string( \"$y\", ch, obj ) ) == \"rune\" )

    set_singular( obj, string( \"$y Ash\", ch, obj ) );

  else

    set_singular( obj, skip_word( string( \"$y Ash\", ch, obj ) ) );

  remove_cflag( 146, ch );

  act_tochar( \"@eYou carefully insert the rune stone, 'Ash' into the blade, producing:@n\", ch );

  act_notchar( \"@e$n carefully inserts the rune stone, 'Ash' into a rune blade, producing:@n\", ch );

  act_room( \"@C$p@n\", ch, obj );

}

