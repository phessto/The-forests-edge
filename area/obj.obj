"if( cflag( 100, ch ) ) {

  act_tochar( \"You are not adept at rapid-fire shooting.\", ch );

  end;

  }

if( cflag( 123, ch ) ) {

  mob = mload( 2298, get_room( ch ) );

  set_name( mob, arg );

  interpret( mob, \"look self\" );

  room = find_room( obj_value( wearing_obj( 4094, ch ), 2 ) );

  loop( all_in_room ) {

    if( is_name( name( mob, mob ), name( ch, rch ) ) ) {

      victim = rch;

      }

    }

  junk_mob( mob );

  set_obj_timer( wearing_obj( 4094, ch ), 4 );

  }

if( !cflag( 123, ch ) ) {

  if( is_name( arg, \"1 west\" ) && is_open( room, west ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"west\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"east\" );

    exit = door( room, west );

    }

  if( is_name( arg, \"1 east\" ) && is_open( room, east ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"east\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"west\" );

    exit = door( room, east );

    }

  if( is_name( arg, \"1 north\" ) && is_open( room, north ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"north\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"south\" );

    exit = door( room, north );

    }

  if( is_name( arg, \"1 south\" ) && is_open( room, south ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"south\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"north\" );

    exit = door( room, south );

    }

  if( !exit ) {

    act_tochar( #block, ch );

    end;

    }

  room = leads_to( exit );

  if( room == get_room( ch ) || rflag( safe, room ) ) {

    act_tochar( #block, ch );

    junk_obj( obj_in_room( 3479, get_room( ch ) ), 1 );

    junk_obj( obj_in_room( 3523, get_room( ch ) ), 1 );

    end;

    }

  }

set_obj_value( obj_in_room( 3479, get_room( ch ) ), 0, 4094 );

i = 4284;

obj = has_obj( 3651, ch );

loop( !obj && i < 4289 ) {

  obj = has_obj( i, ch );

  if( !obj )

    i = i + 1;

  }

if( obj ) {

  set_cflag( 100, ch );

  if( !cflag( 123, ch ) )

    act_tochar( \"You nock $p, and carefully take aim.\", ch, obj );

  if( victim )

    act_tochar( \"You carefully take aim at $N.\", ch, obj, victim );

  if( !victim && cflag( 123, ch ) )

    act_tochar( \"You look to $p and choose a random target.\", ch, obj_in_room( 3479, get_room( ch ) ) );

  }

else {

  act_tochar( \"You have no arrows with which to shoot!\", ch );

  end;

  }

wait( 1 );

if( cflag( 100, ch ) )

  opcode( wearing_obj( 4094, ch ), 4 );

"
