  l = 3;

if( is_name( first_word( arg ), \"1 west\" ) && is_open( room, west ) )

  l = 4;

m = l + 1;

if( m > 3 )

  m -= 4;

if( l > 0 ) {

  l -= 1;

  exit = door( room, l );

}

if( !exit ) {

  act_tochar( #block, ch );

  end;

}

room = leads_to( exit );

