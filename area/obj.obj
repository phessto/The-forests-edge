"act_tochar( #read, ch, obj, null );

act_notchar( #reads, ch, obj, null );

wait( 1 );

if( !ch || !obj || is_fighting( ch ) || is_sleeping( ch ) )

  end;

if( get_religion( ch ) != temohpab ) {

  act_tochar( #mush, ch, obj, null );

  act_notchar( #mushes, ch, obj, null );

  set_resting( ch );

  obj_to_room( obj, room );

  loop( find_stat( ch, mana ) > 0 ) {

    modify_mana( ch, -100 );

    modify_mana( ch, -20 );

    modify_mana( ch, -5 );

    modify_mana( ch, -1 );

    drain_stat( ch, int, 60, -1 );

    }

  end;

  }

i = 1d4;

if( i == 1 ) {

  interpret( ch, #say );

  do_spell( holy wrath, null, ch, 10 );

  }

if( i == 2 ) {

  interpret( ch, #say2 );

  interpret( ch, #say3 );

  j = find_stat( ch, move );

  j = j * -1;

  modify_move( ch, j );

  if( !mob_in_room( 2701, room ) ) {

    mob = mload( 2701, room );

    act_notchar( #imp, mob );

    attack( mob, ch, 1d8, \"+sharp claws\" );

    }

  }

if( i == 3 ) {

  interpret( ch, #say4 );

  do_spell( bless, null, ch, 10 );

  }

if( i == 4 ) {

  interpret( ch, #say5 );

  j = find_stat( ch, hit );

  j = j / 3;

  dam_message( ch, j, \"the sacrifice to Temohpab\" );

  inflict( ch, null, j, \"sacrifice to Temohpab\" );

  }

"
