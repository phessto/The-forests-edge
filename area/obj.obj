  interpret( mob, \"look self\" );

  room = find_room( obj_value( wearing_obj( 1679, ch ), 2 ) );

  loop( all_in_room ) {

     if( is_name( name( mob, mob ), name( ch, rch ) ) ) {

      victim = rch;

      }

    }

  junk_mob( mob );

  set_obj_timer( wearing_obj( 1679, ch ), 4 );

  }

