"none"
"if( wearing_obj( 1411, ch ) ) {

  if( class( ch ) == bard ) {

    if( rflag( No.Magic, room ) ) {

      act_tochar( #nothere, ch );

      end;

      }

    act_tochar( #play, ch );

    act_notchar( #rplay, ch );

    if( find_skill( ch, detect magic ) < 5 ) {

      do_spell( detect magic, null, ch, 1 );

      }

    else {

      use_skill( ch, detect magic );

      loop( all_in_room ) {

        if( !is_sleeping( rch ) && can_hear( rch ) ) {

          if( ch != rch ) {

            if( modify_mana( ch, -20 ) ) {

              do_spell( detect magic, null, rch, find_skill( ch, detect magic ) - 4 );

              act_tochar( #aff, ch, obj, rch );

              } }

            else

              do_spell( detect magic, null, rch, find_skill( ch, detect magic ) - 4 );

            } } } }

          else {

            act_tochar( #nope, ch );

            act_notchar( #rch, ch );

            } }

          else {

            act_tochar( #notw, ch );

            }

"
