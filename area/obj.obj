"if( find_skill( ch, cure light ) > 9 ) {

  if( !cflag( 199, ch ) ) {

    if( !is_silenced( ch ) ) {

      if( cast_mana( cure light, ch ) + 10 <= find_stat( ch, mana ) ) {

        set_cflag( 199, ch );

        modify_mana( ch, -(cast_mana( cure light, ch ) + 10 ) );

        act_tochar( #conc1, ch );

        act_notchar( #nconc1, ch );

        wait( 1 );

        act_tochar( #conc2, ch );

        act_notchar( #nconc2, ch );

        wait( 1 );

        act_tochar( #glow, ch );

        act_notchar( #nglow, ch );

        wait( 1 );

        if( random( 0, 9 ) < find_skill( ch, concoct elixir ) ) {

          remove_cflag( 199, ch );

          act_tochar( #succ, ch );

          act_notchar( #nsucc, ch );

          use_skill( ch, concoct elixir );

          replace_obj( wearing_obj( 4801, ch ), 4802 );

        }

        else {

          remove_cflag( 199, ch );

          act_tochar( #fail, ch );

          use_skill( ch, concoct elixir );

          if( random( 0, 18 ) > ( find_skill( ch, concoct elixir ) + 8 ) ) {

            act_tochar( #explode, ch );

            act_notchar( #nexplode, ch );

            obj = wearing_obj( 4801, ch );

            junk_obj( obj, 1 );

            dam_message( ch, 4d4+5, \"+*the tiny fragments\" );

            inflict( ch, mob, 4d4+5, \"a failed concoction attempt\" );

          }

        }

      }

      else

        act_tochar( #nomana, ch );

    }

    else {

      remove_cflag( 199, ch );

      act_tochar( #silenced, ch );

    }

  }

  else

    act_tochar( #doing, ch );

}

else

  act_tochar( #cant, ch );

