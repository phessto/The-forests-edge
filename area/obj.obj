"if( class( ch ) == bard ) {

  if( rflag( No.Magic, room ) ) {

    act_tochar( #nothere, ch );

    end;

  }

  act_tochar( #play, ch );

  act_notchar( #rplay, ch );

  j = find_skill( ch, instrument mastery );

  if( j > 0 && !cflag( 198, ch ) ) {

    set_cflag( 198, ch );

    use_skill( ch, instrument mastery );

    wait( 1 );

    act_tochar( #play2, ch );

    act_notchar( #nplay2, ch );

    wait( 1 );

    loop( all_in_room ) {

      if( !is_sleeping( rch ) && can_hear( rch ) ) {

        if( ch != rch ) {

          if( modify_mana( ch, -100 ) ) {

            do_spell( detect hidden, null, rch, j );

            drain_stat( rch, wis, j, 1 );

          }

        }

        else {

          do_spell( detect hidden, null, rch, j );

          drain_stat( rch, wis, j, 1 );

        }

      }

    }

  }

}

else {

  act_tochar( #nope, ch );

  act_notchar( #rch, ch );

}

