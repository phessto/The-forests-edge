"*"
"act_notchar( \"$n looks at a large ornate sundial.\", ch );

send_to_char( get_desc( obj, \"either\" ), ch );


i = time_hour();

j = time_minute();

k = moon_phase();


// Calc adjusted hour

m = time_hour();

if ( m > 12 )

  m-= 12;


arg = get_desc( null, string( \"h$T\", null, null, null, \"\", m ) );


if ( i > 4 && i < 19 ) {

  opcode( obj, 2 );

}

else if ( i < 5 || i > 18 ) {

  if ( k != -1 && k != 4 ) {

    if( k == 0 )

      act_tochar( \"@BFrom the shadows cast by the light of the full moon, it appears to be@n\", ch );

    else if ( k == 1 || k == 7 )

      act_tochar( \"@BFrom the shadows cast by the light of the gibbous moon, it appears to be@n\", ch );

    else if ( k == 2 || k == 6 )

      act_tochar( \"@BFrom the shadows cast by the light of the half moon, it appears to be@n\", ch );

    else if ( k == 3 || k == 5 )

      act_tochar( \"@BFrom the shadows cast by the light of the crescent moon, it appears to be@n\", ch );

    opcode( obj, 3 );

  }

  else

    act_tochar( \"With neither the sun or moon to give light, it is impossible to know what time it is.\", ch );

}

"
