        if( i == 2 && j != 2 && k != 2 && l != 2 && m != 2 )

          act_tochar( #null, ch );

        if( i == 12 && k != 1 && l != 1 )

          act_tochar( #null, ch );

        if( i == 1 && j == 1 )

          oprog( 4801, 2 );

        if( i == 1 && k == 1 )

          oprog( 4801, 3 );

        if( i == 1 && l == 1 )

          oprog( 4801, 4 );

        if( i == 1 && m == 1 )

          oprog ( 4801, 5 );

        if( i == 1 && n == 1 )

          oprog( 4801, 6 );

        if( i == 1 && n == 2 )

          oprog( 4801, 7 );

        if( i == 2 && j == 2 )

          oprog( 4801, 8 );

        if( i == 2 && k == 2 )

          oprog( 4801, 9 );

        if( i == 2 && l == 2 )

          oprog( 4801, 10 );

        if( i == 2 && m == 2 )

          oprog( 4801, 11 );

        if( i == 3 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 12 );

        if( i == 4 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 13 );

        if( i == 5 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 14 );

        if( i == 6 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 15 );

        if( i == 7 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 16 );

        if( i == 8 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 17 );

        if( i == 9 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 18 );

        if( i == 10 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 19 );

        if( i == 11 && j == 0 && k == 0 && l == 0 && m == 0 && n == 0 )

          oprog( 4801, 20 );

        if( i == 12 && j == 12 )

          oprog( 4801, 21 );

      }

    }

    else

      act_tochar( #fight, ch );

  }

}

else

  act_tochar( #cant, ch );

