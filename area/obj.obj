  }

  obj_to_room( oload( vnum( obj ) ), room );

  junk_obj( obj, 1 );

  end;

}

if( char_affected( victim, sanctuary ) || is_pet( victim ) ) {

  k = 1000;

}

if( is_player( victim ) ) {

  if( is_player( ch ) && find_stat( ch, level ) < 91 ) {

    act_tochar( \"You are forbidden from attacking other players with ranged weapons.\", ch );

    k = 1000;

  }

}

else {

  if( find_stat( victim, hit ) < find_stat( victim, max_hit ) ) {

    k = 200;

  }

}

if( is_resting( victim ) ) {

  k = k - 100;

}

if( is_sleeping( victim ) || find_stat( victim, hit ) < 0 ) {

  k = k - 500;

}

j = find_stat( ch, level ) - find_stat( victim, level );

j = j + i;

if( !check_skill( ch, bow, 20+j ) ) {

  act_tochar( #miss, ch, obj_in_room( 3479, get_room( ch ) ), victim );

  act_notchar( #rmiss, ch, obj_in_room( 3479, get_room( ch ) ), victim );

  i = 0;

  obj_to_room( oload( vnum( obj ) ), room );

}

else

  use_skill( ch, bow );

if( i > 0 && check_skill( victim, dodge, k-j ) ) {

  use_skill( victim, dodge );

  act_tochar( \"$N dodges your sling bullet.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

  act_notchar( \"$N dodges $n's sling bullet.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

  act_tochar( \"You dodge a sling bullet from $p.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

  act_notchar( \"$n dodges a sling bullet from $p.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

  i = 0;

  obj_to_room( oload( vnum( obj ) ), room );

}

if( i > 0 && find_skill( victim, shadow dance ) > 0 && !is_sleeping( victim ) ) {

  if( check_skill( victim, shadow dance, -60-j ) ) {

    use_skill( victim, shadow dance );

    act_tochar( \"$N seems to meld with the shadows, avoiding your sling bullet.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_notchar( \"$N seems to meld with the shadows, avoiding $n's sling bullet.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_tochar( \"You meld with the shadows, avoiding a sling bullet from $p.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    act_notchar( \"$n melds with the shadows, avoiding a sling bullet from $p.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    i = 0;

    obj_to_room( oload( vnum( obj ) ), room );

  }

}

if( i > 0 && shield( victim ) && !is_sleeping( victim ) ) {

  if( check_skill( victim, shield block, -50-j ) ) {

    use_skill( victim, shield block );

    act_tochar( \"$N blocks your sling bullet with $s shield.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_notchar( \"$N block $n's sling bullet with $s shield.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_tochar( \"You block a sling bullet from $p with your shield.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    act_notchar( \"$n blocks a sling bullet from $p with $s shield.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    i = 0;

  }

}

if( i > 0 && find_skill( victim, tumble ) > 0 && !is_sleeping( victim ) ) {

  if( check_skill( victim, tumble, -60-j ) ) {

    use_skill( victim, tumble );

    act_tochar( \"$N tumbles away, avoiding your sling bullet.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_notchar( \"$N tumbles away, avoiding $n's sling bullet.\", ch, obj_in_room( 3523, get_room( ch ) ), victim );

    act_tochar( \"You tumble away, avoiding a sling bullet from $p.\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    act_notchar( \"$n tumbles away, avoiding a sling bullet from $p\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    i = 0;

    obj_to_room( oload( vnum( obj ) ), room );

  }

}

if( i > 0 ) {

  if( random( 1, 5 ) == 1 )

    obj_to_char( oload( vnum( obj ) ), victim );

  act_tochar( \"You fire a sling bullet to $p and strike $N!\", ch, obj_in_room( 3479, get_room( ch ) ), victim );

  act_notchar( \"$n fires a sling bullet to $p and strikes $N!\", ch, obj_in_room( 3479, get_room( ch ) ), victim );

  j = 2d75 + i;

  if( !is_player( victim ) )

    mob = mload( vnum( victim), get_room( ch ) );

  if( mob && find_stat( mob, hit ) < j ) {

    junk_mob( mob );

  }

  if( !mob ) {

    mob = mload( 2462, get_room( ch ) );

    set_singular( mob, string( \"$X\", ch, obj, victim ) );

  }

  if( vnum( obj ) == 4723 ) {

    dam_message( mob, j, \"A sling bullet\" );

    inflict( mob, ch, j, \"sling bullet\" );

    dam_message( victim, j, \"A sling bullet\" );

    inflict( victim, ch, j, \"sling bullet\" );

  }

  if( vnum( obj ) == 4762 ) {

    shock_message( mob, j, \"A sling bullet of lightning\" );

    inflict_shock( mob, ch, j, \"sling bullet\" );

    shock_message( victim, j, \"A sling bullet of lightning\" );

    inflict_shock( victim, ch, j, \"sling bullet\" );

  }

  if( vnum( obj ) == 4763 ) {

    fire_message( mob, j, \"A sling bullet of flame\" );

    inflict_fire( mob, ch, j, \"sling bullet\" );

    fire_message( victim, j, \"A sling bullet of flame\" );

    inflict_fire( victim, ch, j, \"sling bullet\" );

  }

  if( vnum( obj ) == 4764 ) {

    cold_message( mob, j, \"A sling bullet of frost\" );

    inflict_cold( mob, ch, j, \"sling bullet\" );

    cold_message( victim, j, \"A sling bullet of frost\" );

    inflict_cold( victim, ch, j, \"sling bullet\" );

