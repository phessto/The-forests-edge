act_room( \"A sling bullet flies in from $p!\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

remove_cflag( 100, ch );

if( !victim ) {

  act_tochar( #miss, ch, obj_in_room( 3479, get_room( ch ) ), victim );

  act_notchar( #rmiss, ch, obj_in_room( 3479, get_room( ch ) ), victim );

  if( !cflag( 123, ch ) ) {

