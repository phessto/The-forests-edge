      victim = rch;

      }

    }

  junk_mob( mob );

  set_obj_timer( wearing_obj( 3612, ch ), 4 );

  }

if( !cflag( 123, ch ) ) {

  if( is_name( arg, \"1 west\" ) && is_open( room, west ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"west\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"east\" );

    exit = door( room, west );

    }

  if( is_name( arg, \"1 east\" ) && is_open( room, east ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"east\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"west\" );

    exit = door( room, east );

    }

  if( is_name( arg, \"1 north\" ) && is_open( room, north ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"north\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"south\" );

    exit = door( room, north );

    }

  if( is_name( arg, \"1 south\" ) && is_open( room, south ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"south\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"north\" );

    exit = door( room, south );

    }

  if( !exit ) {

    act_tochar( #block, ch );

    end;

    }

  room = leads_to( exit );

  if( room == get_room( ch ) || rflag( safe, room ) ) {

    act_tochar( #block, ch );

    junk_obj( obj_in_room( 3479, get_room( ch ) ), 1 );

    junk_obj( obj_in_room( 3523, get_room( ch ) ), 1 );

    end;

    }

  }

set_obj_value( obj_in_room( 3479, get_room( ch ) ), 0, 3612 );

