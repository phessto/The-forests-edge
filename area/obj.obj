"end;

if( cflag( 97, ch ) )

  act_tochar( \"Your nose itches.\", ch );

else {

  set_cflag( 97, ch );

  act_tochar( \"You snort a pinch of powdered antler.\", ch );

  act_notchar( \"$n snorts a pinch of powdered antler.\", ch );

  act_tochar( \"The powder reacts with your chemistry!\", ch );

  act_notchar( \"$n's head snaps back!\", ch );

  do_spell( blind, null, ch );

  j = 1;

  if( find_stat( ch, wis ) < 5 )

    j = 0;

  if( find_stat( ch, int ) < 5 )

    j = 0;

  if( find_stat( ch, con ) < 5 )

    j = 0;

  if( j == 1 )

    opcode( obj, 2 );

  else

    act_tochar( \"Your brain is too addled for more powder to affect you.\", ch );

  junk_obj( obj, 1 );

  wait( random( 10, 20 ) );

  remove_cflag( 97, ch );

  act_tochar( \"Your nose is less itchy.\", ch );

  }

"
