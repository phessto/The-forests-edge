"i = 0; j = 0;

if( is_name( first_word( arg ), \"chilling\" ) ) { j = 1;

  if( is_name( skip_word( arg ), \"touch\" ) ) { i = 1; } }

if( is_name( first_word( arg ), \"freeze\" ) ) { j = 2; }

if( is_name( first_word( arg ), \"ice\" ) ) {

  if( is_name( skip_word( arg ), \"lance\" ) ) { i = 1; j = 3; }

  if( is_name( skip_word( arg ), \"shield\" ) ) { i = 1; j = 4; }

  if( is_name( skip_word( arg ), \"storm\" ) ) { i = 1; j = 5; }

  if( j == 0 && find_skill( ch, ice storm ) > 0 ) { j = 5; }

  if( j == 0 && find_skill( ch, ice lance ) > 0 ) { j = 3; }

  }

if( j == 0 ) { continue; }

loop( all_in_room ) {

  if( i == 0 && is_name( skip_word( arg ), name( ch, rch ) ) ) { victim = rch; }

  if( i == 1 && is_name( skip_word( skip_word( arg ) ), name( ch, rch ) ) ) { victim = rch; }

  }

if( !victim && j != 4 ) { victim = is_fighting( ch ); }

if( !victim && j == 4 ) { victim = ch; }

if( !victim ) { continue; }

if( j == 1 ) { cast_spell( chilling touch, ch, victim, 2 + find_skill( ch, chilling touch ) ); }

if( j == 2 ) { cast_spell( freeze, ch, victim, 2 + find_skill( ch, freeze ) ); }

if( j == 3 ) { cast_spell( ice lance, ch, victim, 2 + find_skill( ch, ice lance ) ); }

if( j == 4 ) { cast_spell( ice shield, ch, victim, 2 + find_skill( ch, ice shield ) ); }

if( j == 5 ) { cast_spell( ice storm, ch, victim, 2 + find_skill( ch, ice storm ) ); }

"
