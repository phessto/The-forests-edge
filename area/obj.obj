    act_tochar( #block, ch );

    end;

    }

  room = leads_to( exit );

  if( room == get_room( ch ) || rflag( safe, room ) ) {

    act_tochar( #block, ch );

    junk_obj( obj_in_room( 3479, get_room( ch ) ), 1 );

    junk_obj( obj_in_room( 3523, get_room( ch ) ), 1 );

    end;

    }

