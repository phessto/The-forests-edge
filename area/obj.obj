    act_notchar( \"$n tumbles away, avoiding an arrow from $p\", victim, obj_in_room( 3523, get_room( ch ) ), ch );

    i = 0;

    obj_to_room( oload( vnum( obj ) ), room );

    }

  }

if( i > 0 ) {

  if( random( 1, 5 ) == 1 )

    obj_to_char( oload( vnum( obj ) ), victim );

  act_tochar( \"You fire an arrow to $p and strike $N!\", ch, obj_in_room( 3479, get_room( ch ) ), victim );

  act_notchar( \"$n fires an arrow to $p and strikes $N!\", ch, obj_in_room( 3479, get_room( ch ) ), victim );

  j = 1d112 + i + 3 * find_skill( ch, bow);

  if( !is_player( victim ) )

    mob = mload( vnum( victim), get_room( ch ) );

  if( mob && find_stat( mob, hit ) < j ) {

    junk_mob( mob );

    }

  if( !mob ) {

    mob = mload( 2462, get_room( ch ) );

    set_singular( mob, string( \"$X\", ch, obj, victim ) );

    }

  if( vnum( obj ) == 3651 ) {

    dam_message( mob, j, \"An ironwood arrow\" );

    inflict( mob, ch, j, \"arrow\" );

    dam_message( victim, j, \"An ironwood arrow\" );

    inflict( victim, ch, j, \"arrow\" );

    }

  if( vnum( obj ) == 4284 ) {

    cold_message( mob, j, \"An ice arrow\" );

