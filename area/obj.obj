  if( is_name( arg, \"1 west\" ) && is_open( room, west ) ) {

    set_singular( obj_to_room( oload( 3479 ), room ), \"west\" );

    set_singular( obj_to_room( oload( 3523 ), room ), \"east\" );

    exit = door( room, west );

