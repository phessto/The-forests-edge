"look"
"large stone sundial"
"act_notchar( \"$n looks at a large stone sundial.\", ch );

act_tochar( #desc, ch );

j = date_month();

k = date_day() - 1;

loop( j > -1 ) {

  j--;

  k = k + days_in_month( j );

}

j = k/20;

l = k - j*20 + 1;

act_obj = obj_to_room( oload( 3705 + j ), room );

if( time_hour() > 4 && time_hour() < 19 ) {

  opcode( obj, 2 );

}

if( time_hour() < 5 || time_hour() > 18 ) {

  if( moon_phase() != -1 && moon_phase() != 4 ) {

    if( moon_phase() == 0 )

      act_tochar( \"@BFrom the shadows cast by the light of the full moon, it appears to be@n\", ch );

    if( moon_phase() == 1 || moon_phase() == 7 )

      act_tochar( \"@BFrom the shadows cast by the light of the gibbous moon, it appears to be@n\", ch );

    if( moon_phase() == 2 || moon_phase() == 6 )

      act_tochar( \"@BFrom the shadows cast by the light of the half moon, it appears to be@n\", ch );

    if( moon_phase() == 3 || moon_phase() == 5 )

      act_tochar( \"@BFrom the shadows cast by the light of the crescent moon, it appears to be@n\", ch );

    opcode( obj, 3 );

  }

  else

    act_tochar( \"With neither the sun or moon to give light, it is impossible to know what time it is, but the date appears to be the $T day of $P in the year $cY.\", ch, null, act_obj, ordinal( i ), ordinal( l ) );

}

"
E
