"__CLOSE_PORT_CODE__"
""
"if( is_open( find_room( 88000 ), south ) ) {

  send_to_room( #south, find_room( 88000 ) );

  send_to_room( #north, find_room( 36001 ) );

  close( find_room( 88000 ), south );

  }

"
E
