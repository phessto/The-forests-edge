"Since the carpet is nailed down at one end, it only stands to reason that it

could be rolled up.

"
A
"lift"
"bar"
"if( !is_open( room, north ) ) {

  if( rflag( reset1, room ) ) {

    acode( room, 5 );

    act_tochar( #lift, ch );

    act_notchar( #rlift, ch );

    remove_rflag( reset1, room );

    }

  else {

    act_tochar( #already, ch );

    }

  }

else {

  act_tochar( #open, ch );

  }

"
