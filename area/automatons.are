"corners piles parts"
"act_tochar( \"You search through the piles of broken parts.\", ch );

act_notchar( \"$n searches through the piles of broken parts.\", ch );

if( rflag( reset2, room ) ) {

  remove_rflag( reset2, room );

  i = random( 1, 20 );

  }

else {

  i = 0;

  }

if( i == 7 ) {

  obj = obj_to_char( oload( 325 ), ch );

  act_tochar( \"You find $p!\", ch, obj );

  act_notchar( \"$n finds $p!\", ch, obj );

  }

else if( i == 13 ) {

  act_tochar( \"You seem to disturb something!\", ch );

  act_notchar( \"$n seems to disturb something!\", ch );

  mob = mload( 2686, room );

  set_victim( mob, ch );

  }

else {

  act_tochar( \"You don't find anything of interest.\", ch );

  }

