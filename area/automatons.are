"if( dflag( secret, door( room, down ) ) ) {

  mob = mob_in_room( 357, room );

  if( mob ) {

    act_tochar( #mob, ch, null, mob );

    }

  else {

    act_tochar( #pull, ch );

    act_notchar( #rpull, ch );

    remove_dflag( secret, door( room, down ) );

    wait( 4 );

    if( !dflag( secret, door( room, down ) ) ) {

      send_to_room( #roll, room );

      set_dflag( secret, door( room, down ) );

      }

    }

  }

else {

  act_tochar( #already, ch );

  }

