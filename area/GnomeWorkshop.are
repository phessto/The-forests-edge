A
"push pull"
"lever"
"act_tochar( #pull, ch );
act_notchar( #rpull, ch );
if( is_open( room, north ) ) {
  act_room( #close, ch );
  close( room, north );
}
else {
  act_room( #open, ch );
  open( room, north );
}
wait( 3 );
if( is_open( room, north ) ) {
  close( room, north );
  send_to_room( #close, room );
}
"
E
"pull"
"You pull the lever set next to the door and there is an immediate clatter of
gears and cogs in action within the walls.
"
E
"rpull"
"$n pulls the lever set next to the door and there is an immediate clatter of
gears and cogs in action within the walls.
"
E
"close"
"With a heavy @rCLANG!@n the northern door swings shut and all the mechanical
sounds cease within the walls.
"
E
"open"
"Amidst the whirring and clattering sounds the @ycreeeeaaak@n of the northern door
is added as it swings open.
"
!
