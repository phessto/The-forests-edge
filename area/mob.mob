"j = find_stat( mob, hit ) * 100;
k = find_stat( mob, max_hit );
if( ( j / k ) < 20 && rflag( reset1, room ) ) {
  act_notchar( #pray, mob );
  remove_rflag( reset1, room );
  if( 1d4 == 2 ) {
    act_notchar( #dimlight, mob );
    heal( mob, 5000 );
    }
  else
    act_notchar( #nothing, mob );
  }
i = 1d3;
if( i == 1 ) {
  act_notchar( #curse, mob );
  j = 0;
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      k = 1d100+105;
      dam_message( rch, k, \"the choking black mist\" );
      inflict( rch, mob, k, \"choking black mist\" );
      j = j + k;
      }
    }
  heal( mob, j*2 );
  }
if( i == 2 ) {
  j = 0;
  loop( all_in_room ) {
    if( vnum( rch ) > 2650 && vnum( rch ) < 2656 ) {
      if( ( find_stat( rch, hit ) * 100 ) / find_stat( rch, max_hit ) < 80 )
        j = j + 1;
      }
    }
  if( j >= 2 ) {
    act_notchar( #glow, mob );
    loop( all_in_room ) {
      if( vnum( rch ) > 2650 && vnum( rch ) < 2656 )
        heal( rch, 425 );
      }
    }
  else {
    act_notchar( #blast, mob );
    rch = rand_player( room );
    if( rch )
      do_spell( harm, mob, rch, 14 );
    }
  }
if( i == 3 ) {
  ch = victim;
  loop( all_in_room ) {
    if( is_player( rch ) ) {
      if( ( find_stat( rch, align ) % 3 ) == 0 && class( rch ) == paladin )
        ch = rch;
      }
    }
  interpret( mob, \"salute\", ch );
  attack_weapon( mob, ch, 2d9+5, \"shoulder bash\" );
  attack_weapon( mob, ch, 2d9+5, \"snap kick\" );
  attack_weapon( mob, ch, 2d9+5, \"knee smash\" );
  attack_weapon( mob, ch, 2d9+5, \"haymaker\" );
  attack_weapon( mob, ch, 2d9+5, \"groin kick\" );
  attack_weapon( mob, ch, 2d12+8, \"two-fisted smash\" );
  if( 1d3 != 2 )
    attack_weapon( mob, ch, 2d9+5, \"elbow smash\" );
  if( 1d2 == 1 )
    attack_weapon( mob, ch, 2d9+5, \"quick jab\" );
  }
