"if( !ch )
  continue;
if( find_stat( ch, level ) > 91 )
  continue;
if( is_name( \"tame\", arg ) ) {
  if( class( ch ) == ranger ) {
    if( get_sex( ch ) != female ) {
      act_tochar( \"$N ignores you.\", ch, obj, victim );
      end;
    }
    if( race( ch ) == human || race( ch ) == goblin || race( ch ) == orc
      || race( ch ) == ogre || race( ch ) == troll ) {
      continue;
    }
    else {
      act_tochar( \"$N ignores you.\", ch, obj, victim );
      end;
    }
  }
  else {
    act_tochar( \"$N ignores you.\", ch, obj, victim );
    end;
  }
}
else {
  continue;
}
