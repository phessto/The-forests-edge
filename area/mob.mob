if( i == 1 )
attack( mob, victim, 1d5+7, \"bone-jarring kick\" );
else if( i == 2 )
interpret( mob, \"bash\" );
else if( i == 3 ) {
act_room( #whip, ch, obj, mob );
attack_room( mob, 1d8+5, \"skeletal tail lash\" );
}
"
