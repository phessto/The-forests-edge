  if( rch != mob ) {
    j = 3d12+5;
    fire_message( rch, j, \"the explosion\" );
    inflict_fire( rch, mob, j, \"A terrible explosion\" );
  }
}
send_to_room( #d_explode, find_room( 21100 ) );
send_to_room( #d_explode, find_room( 21102 ) );
