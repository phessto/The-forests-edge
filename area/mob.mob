"loop( all_in_room ) {
  if( rch != mob ) {
    do_spell( curse, mob, rch, 1 );
    if( !wearing_obj( 3724, rch ) ) {
      obj = obj_to_char( oload( 3724 ), rch );
      interpret( rch, \"wear vile\" );
      act_tochar( #curse, rch, obj, mob );
      act_notchar( #rcurse, rch, obj, mob );
      act_tochar( \"You feel **MUCH** more susceptible to electricity!!\", rch );
      }
    }
  }
i = 1d4;
if( i == 1 ) {
  act_room( \"@E$n casts chain lightning!\", mob );
  do_spell( chain lightning, mob, victim, 10 );
  }
if( i == 2 ) {
  act_room( \"@E$n casts lightning bolt!\", mob );
  do_spell( lightning bolt, mob, rand_player( room ), 10 );
  }
if( i == 3 ) {
  act_room( \"@E$n summons forth a wave of energy!\", mob );
  loop( 1d10 > 2 ) {
    do_spell( shock, mob, rand_player( room ), 1 );
    }
  }
if( i == 4 ) {
  act_room( \"@E$n invokes a lightning storm!\", mob );
  loop( all_in_room ) {
