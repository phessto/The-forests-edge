if( is_name( \"tame\", arg ) ) {
  if( class( ch ) == ranger ) {
    continue;
    }
  else {
    act_tochar( \"$N ignores you.\", ch, obj, victim );
    end;
    }
  }
else {
  continue;
  }
"
