""
"Zithuan"
"attack( mob, victim, 2d20+10, \"claw swipe\" );
if( 1d4 > 1 )
  attack( mob, victim, 2d20+10, \"claw swipe\" );
if( 1d2 == 1 ) {
  if( attack( mob, victim, 3d25+10, \"deadly bite\" ) && 1d3 == 1 ) {
    if( poison( victim ) )
      acode( find_room( 36 ), 4 );
  }
}
if( 1d7 == 1 ) {
  if( !char_affected( mob, silence ) ) {
    act_room( #croak, mob );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) || mob == is_fighting( rch ) )
        attack_sound( mob, rch, 8d8+20, \"stunning croak\" );
    }
    loop( all_in_room ) {
      if( race( rch ) == slaad && rch != mob ) {
        if( !char_affected( rch, silence ) ) {
          ch = rch;
          act_room( #croak, ch );
          loop( all_in_room ) {
            if( is_player( rch ) || is_pet( rch ) || mob == is_fighting( rch ) ) {
              attack_sound( ch, rch, 8d8+20, \"echoing croak\" );
            }
          }
          rch = ch;
        }
        else {
          act_room( #no_croak, rch );
          do_spell( holy wrath, rch, rch );
        }
      }
    }
  }
  else {
    act_room( #no_croak, mob );
    do_spell( holy wrath, mob, mob );
  }
}
"
E
"croak"
"@Y$>n opens its mouth to emit a powerful croak!@n
"
E
"no_croak"
"@Y$>n opens its mouth to croak, but fails to produce a sound!@n
