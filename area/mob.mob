  if( !is_silenced( mob ) ) {
  act_tochar( #shriek, ch, obj, mob );
  act_notchar( #rshriek, ch, obj, mob );
  i = 4d6+10;
  sound_message( ch, i,  \"A blood-curdling shriek\" );
  inflict_sound( ch, mob, i, \"being shrieked to death\" );
  loop( followers ) {
    act_tochar( #shriek, rch, obj, mob );
    act_notchar( #rshriek, rch, obj, mob );
    i = 4d6+10;
    sound_message( rch, i,  \"A blood-curdling shriek\" );
    inflict_sound( rch, mob, i, \"being shrieked to death\" );
    }
  }
else
  act_room( #cant, ch, obj, mob );
