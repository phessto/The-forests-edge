  send_to_room( #taunt2, room );
if( random( 1, 20 ) == 3 )
  interpret( mob, \"yell Come on, your fighing with the big boys now !!\" );
if( random( 1, 20 ) == 4 )
  interpret( mob, \"yell You think you can hurt me !?\" );
