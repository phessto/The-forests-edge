""
""
"wolf of crystalline ice"
""
""
"stands perfectly immobile, as if frozen in place."
"wolves of crystalline ice"
""
""
"stand perfectly still, as if frozen in place."
"Faceted and sparkling, the surfaces of this extraordinarily large wolf of
translucent ice glimmer softly in the cavern light.  Despite standing as tall
as a man at the shoulder, this construct of ice is extraordinarily detailed,
down to the texture of individual hairs being visible; possibly this is a
trick of the light playing across the intricate facets.  Frost rimes the air
between the brutal jaws of this fashioned beast, even though its flanks do not
move with breath.  A burning blue light fills the places where the eyes of an
ordinary wolf would be, piercingly bright.  Although the eyes have no pupils,
it seems as if they are looking in all directions simultaneously.
"
"Nereus"
""
""
"if( 1d12 == 5 ) {
  i = 0;
  loop( all_in_room ) {
    if( !is_player( rch ) && !is_pet( rch ) ) {
      if( vnum( rch ) == 2077 )
        i = i + 1;
      }
    }
  if( i == 2 ) {
    act_room( #merge, rch );
    acode( room, 3 );
    }
  }
rch = mob_in_room( 2544, room );
if( rch ) {
  if( 1d7 == 2 )
    interpret( mob, \"rescue\", rch );
  }
if( attack( mob, victim, 3d52+32, \"terrible bite\" ) ) {
  act_tochar( #sinks, ch, null, mob );
  act_notchar( #sinksin, ch, null, mob );
  j = 30d16+36;
  cold_message( ch, j, \"the bone-chilling bite\" );
  inflict_cold( ch, mob, j, \"the bone-chilling bite of an ice wolf\" );
  }
else {
  if( 1d4 == 2 ) {
    act_notchar( #breath, mob );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( 1d3 != 2 ) {
          j = 30d16+36;
          cold_message( ch, j, \"the intense blast of frost\" );
          inflict_cold( ch, mob, j, \"the breath of an ice wolf\" );
          }
        }
      }
    }
  else {
    attack( mob, victim, 2d16+10, \"raking claw of ice\" );
    attack( mob, victim, 2d16+10, \"raking claw of ice\" );
    }
  }
