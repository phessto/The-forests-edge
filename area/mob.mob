#2514
""
""
"massive tendriculos"
""
""
"appears to blend in with the nearby vegetation."
"massive tendriculos"
""
""
"appear to blend in with the nearby vegetation."
"This massive mound of vegetation is over fifteen feet high and twenty feet
around.  Several jagged, limblike vines and branches stretch out from the mass
of leaves and other greenery that make up its fearsome body mass.  In its
middle is an enormous opening that resembles a mouth, with razor sharp fangs
composed of long, sharp thorns.  Blood and small bits of flesh can be detected
in the that dark recess.
"
"Olah"
""
""
"attack( mob, victim, 2d50+40, \"snapping vine\" );
attack( mob, victim, 3d40+40, \"+razor sharp limbs\" );
attack( mob, victim, 2d20+70, \"vicious bite\" );
attack( mob, victim, 3d30+60, \"painful swipe\" );
if( random( 1, 10 ) < 8 )
  attack( mob, victim, 4d50+50, \"agonizing blow\" );
if( random( 1, 9 ) < 8 ) {
  act_room( #grab, ch );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( random( 1, 9 ) < 7 )
        attack( mob, rch, 2d50+40, \"+lunging limbs\" );
      }
    }
  }
attack( mob, victim, 4d30+50, \"ferocious swipe\" );
loop( all_in_room ) {
  if( is_player( rch ) || is_pet( rch ) ) {
    if( random( 1, 7 ) == 3 ) {
      i = 3d40+20;
      act_tochar( #grab2, rch );
      act_notchar( #ngrab2, rch );
      dam_message( rch, i, \"the tendriculos's vicious crushing\" );
      inflict( rch, mob, i, \"a tendriculos's vicious crushing\" );
      }
    }
  }
if( random( 1, 18 ) == 18 ) {
  act_tochar( #devour, ch );
  act_notchar( #ndevour, ch );
  mpcode( mob, 3 );
  }
"
E
"devour"
"@gThe massive tendriculos opens completely its gaping mouth, then grabs ahold
of you and devours you whole!@n
"
E
"ndevour"
"@gThe massive tendriculos opens completely its gaping mouth, then grabs ahold
of $n and devours $m whole!@n
"
E
"incoming"
"@eYou see a small amount of light shine through from above as $n comes
tumbling in.@n
"
E
"grab"
"@GThe massive tendriculos lunges its tentacle-like limbs wildly around the
room!@n
"
E
"grab2"
"@mThe massive tendriculos grabs ahold of you and crushes you in its powerful
grip.@n
"
E
"ngrab2"
"@mThe massive tendriculos grabs ahold of $n and crushes $m in its powerful
grip.@n
"
