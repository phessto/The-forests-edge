    act_notchar( #elecblast_r, ch );
    shock_message( victim, j, \"The sketched symbol\" );
    inflict_shock( victim, mob, j, \"a construct's sketched symbol\" );
    }
if( random( 0, 5 ) < 3 ) {
  send_to_room( #mindblast, room );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      i = 15d15+25;
      mind_message( rch, i, \"the mindless roar\" );
      inflict_mind( rch, mob, i, \"mindless roar\" );
      }
    }
  }
}
if( random( 0, 8 ) == 1 ) {
  send_to_room( #raise, room );
  interpret( victim, \"whimper\" );
  interpret( mob, \"bash\" );
  }
"
