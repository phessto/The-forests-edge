#2402
""
""
"High Warrior Priest of Temohpab"
""
""
"stands here brushing down his war stallion."
"High Warrior Priest of Temophab"
""
""
"are here"
"This young man is obviously in the prime of his life.  His long shoulder
length hair is worn tied back in a sharp looking pony tail, and shows not
a hint of grey.  He stands at a height of six and a half feet tall and
weighs upward of two hundered and fifty pounds.  No fat is evident, and
he does not seem to struggle with the weight that he carries.  His face
is clean shaven allowing one to notice his square jaw and high cheekbones.
Dark blue eyes stare out at you, seemingly drinking in every detail of
his surroundings, always wary and always ready to war.
"
"Soren"
""
"Nereus"
"if( mob_in_room( 2401, room ) ) {
  attack( mob, ch, 1d25+25, \"deadly slash\" );
  attack( mob, ch, 2d12+25, \"vicious kick\" );
  attack( mob, ch, 25d2+60, \"downward slash\" );
  if( random( 1, 3 ) == 3 )
    attack( mob, ch, 100d2, \"angry stab\" );
  if( random( 1, 4 ) == 3 ) {
    act_room( #cure, ch );
    do_spell( heal, mob, mob );
    if( mob_in_room( 2401, room ) ) {
      act_room( #horse, ch );
      do_spell( cure critical, mob, mob_in_room( 2401, room ) );
      }
    }
  if( random( 1, 4 ) == 2 ) {
    ch = rand_char( room );
    if( ch != mob ) {
      if( rch != mob ) {
        act_tochar( #push, ch );
        act_notchar( #push2, ch );
        if( attack( mob, ch, 50d4, \"deadly impaling\" ) ) {
          act_tochar( #shove, ch );
          act_notchar( #shove2, ch );
          transfer( ch, find_room( 17328 ) );
          }
        }
      }
    }
  if( random( 1, 4 ) == 3 ) {
    act_room( #spin, ch );
    loop( all_in_room ) {
      if( rch != mob ) {
        if( rch != mob_in_room( 2401, room ) )
          attack( mob, rch, 5d10+75, \"spinning slash\" );
        }
      }
    }
  }
else {
  attack( mob, ch, 2d15+25, \"deadly slash\" );
  attack( mob, ch, 2d15+25, \"vicious kick\" );
  attack( mob, ch, 5d10+45, \"forward slash\" );
  if( random( 1, 4 ) >= 3 )
    attack( mob, ch, 2d40, \"angry stab\" );
  if( random( 1, 4 ) == 3 ) {
    act_room( #cure, ch );
    do_spell( heal, mob, mob );
    }
  if( random( 1, 4 ) == 2 ) {
    act_room( #spin, ch );
    loop( all_in_room ) {
      if( rch != mob )
        attack( mob, rch, 5d10+75, \"spinning slash\" );
      }
    }
  }
"
