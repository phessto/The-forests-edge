"attack( mob, victim, 3d6+5, \"+filthy claws\" );
if( random( 0, 1 ) == 0 )
  attack( mob, victim, 3d6+5, \"+filthy claws\" );
if( random( 0, 3 ) < 2 ) {
  act_room( #to_all, mob );
  attack( mob, victim, 3d5+4, \"+snapping jaws\" );
}
if( random( 1, 8 ) < 3 ) {
  act_tochar( #to_char, ch );
  act_notchar( #drown, ch );
  i = 2d10+2;
  dam_message( victim, i, \"A mudmonster's choking mass\" );
  inflict( victim, mob, i, \"submersion\" );
}
"
