"mischievous imps"
""
"small,"
"pounce from the shadows, grinning madly."
"This little imp is far from a supreme physical specimen.  It is quite
small, only around two feet tall, and though its frame is quite scrawny,
a little bit of a potbelly protrudes around its waistline.  Its skin is
smooth, a greyish tone tinged with brown in color.  A pair of thin,
membraneous wings arch from the little creature's shoulders, curling
around it's grubby little body somewhat protectively.  Beady red eyes
gleam with a hint of mischief, and a toothy little grin seems fixed on
its ugly face, a visage surely only its mother could love.
"
"Soren"
""
""
"attack( mob, victim, 5d5+40, \"+sharp little claws\" );
attack( mob, victim, 5d5+40, \"+sharp little claws\" );
attack( mob, victim, 5d5+40, \"+sharp little claws\" );
i = 1d10;
if( i == 1 ) {
  act_tochar( #lick, ch );
  act_notchar( #lick2, ch );
  attack_acid( mob, ch, 5d4+45, \"acidic saliva\" );
  }
if( i >= 9 ) {
  interpret( mob, \"egrin\" );
  act_room( #fury, ch );
  loop( all_in_room ) {
    if( is_player( rch ) )
      attack( mob, ch, 5d6+25, \"+furious talons\" );
    }
  }
if( i == 2 ) {
  interpret( mob, \"snicker\" );
  act_tochar( #pounce, ch );
  act_notchar( #pounce2, ch );
  interpret( mob, \"bash\" );
  }
if( !is_silenced( mob ) ) {
  if( random( 1, 15 ) == 5 ) {
    ch = rand_player( room );
    act_tochar( #redglow, ch );
    act_notchar( #redglow2, ch );
    wait( 1 );
    act_room( #flames, ch );
    do_spell( flame strike, ch );
    }
  }
if( i == 6 )
  interpret( mob, \"leer\" );
"
