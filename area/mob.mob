""
""
"{reptilian beast} Queen of the Tiphuzuad"
""
"massive, bloated"
"is laying foul, pulsating egg sacs here."
"tiphuzuun"
""
""
"- is bugged ** Contact an immortal! **"
"Possibly as wide as she is tall, this bloated reptilian monstrosity squats
here, fetid eggs leaking from her onto the stone floor in foul clutches.  It
appears that once she was a bipedal lizard, but her front legs have grown
thick with fat and now seem to support some fraction of her massive weight as
she lays eggs.  Huge rear legs support the rest of her bulk, below a
ponderously large tail used for balance.  Her scales are an inky green color,
dark enough to almost be black.  They glint soft, irridescent green in the
light, almost with a pearly sheen.  Atop her bulbous torso, a large maw gapes,
dozens of rows of jagged, triangular teeth stained black with rotting meat and
foul, sticky saliva.
"
"Nereus"
""
""
"if( rflag( reset0, room ) ) {
  interpret( mob, #keen );
  summon( mob, victim );
  remove_rflag( reset0, room );
  loop( all_in_room ) {
    if( race( rch ) != tiphuzuad ) {
      i = 6d65+65;
      if( find_stat( rch, level ) < 60 )
        i = i + ( i / 2 );
      sound_message( rch, i, \"the wailing keening\" );
      inflict_sound( rch, mob, i, \"the queen of the tiphuzuad\" );
      do_spell( paralyze, mob, rch, 15 );
      }
    }
  }
if( attack( mob, victim, 3d150+150, \"decapitating bite\" ) ) {
  act_tochar( #inflict, victim );
  act_neither( #acid, victim, null, mob );
  ch = victim;
  mpcode( mob, 1 );
  }
attack( mob, victim, 3d30+25, \"whipping tail\" );
attack( mob, victim, 3d30+25,\"whipping tail\" );
rch = rand_player( room );
if( attack( mob, rch, 3d75+35, \"ponderous tail smash\" ) ) {
  if( is_standing( rch ) ) {
    if( 1d20 + 5 > find_stat( ch, dex ) ) {
      act_tochar( #knocks, rch );
      act_notchar( #knocksd, rch );
      set_resting( rch );
      set_delay( ch, 100 - find_stat( rch, dex ) );
      }
    else
      act_tochar( #avoid, rch );
    }
  }
if( 1d2 == 2 ) {
  act_notchar( #vomits, mob );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( 1d2 == 2 ) {
        i = 30d10+165;
        acid_message( rch, i, \"the acidic mucous\" );
        inflict( rch, mob, i, \"the queen of the tiphuzuad\" );
        if( rch )
          poison( rch );
        }
      }
    }
  }
