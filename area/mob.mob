"attack_weapon( mob, victim, 2d10+25, \"heavy-handed haymaker\" );
attack_weapon( mob, victim, 2d10+25, \"heavy-handed haymaker\" );
if( random( 0, 1 ) == 0 )
  attack_weapon( mob, victim, 2d10+25, \"heavy-handed haymaker\" );
if( random( 0, 3 ) < 2 ) {
  if( !is_silenced( mob ) ) {
