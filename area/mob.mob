"attack( mob, victim, 3d3+7, \"wing slap\" );
if( random( 1, 3 ) == 1 )
  attack( mob, victim, 3d3+7, \"wing slap\" );
i = 1;
loop( i == 1 ) {
  i = random( 0, 5 );
  act_room( \"$n flaps $s wings and circles overhead...\", mob );
  rch = rand_player( room );
  if( is_fighting( rch ) ) {
    if( attack( mob, rch, 3d3+7, \"+shredding talons\" ) ) {
      act_tochar( \"The raven grabs onto your flesh for leverage and starts pecking!\", ch );
      act_notchar( \"The raven grabs onto $n's flesh for leverage and starts pecking!\", ch );
      loop( random( 1, 5 ) > random( 2, 9 ) ) { 
        attack( mob, rch, 1d1+1, \"peck\" );
        }
      }
    }
  }
if( random( 1, 3 ) == 1 ) {
  act_room( \"A bolt of energy jets forth from $n's screeching beak!\", mob );
  if( attack_shock( mob, victim, 2d10+9, \"bolt of energy\" ) ) {
    j = 1d40+1;
    fire_message( victim, j, \"The burning magic\" );
    inflict_fire( victim, mob, j, \"the cursed raven king\" );
    }
  }
