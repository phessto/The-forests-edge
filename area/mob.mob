""
"pale furry muscular humanoid grimling warrior"
"{pale, furry, muscular humanoid} grimling warrior"
""
""
"stands as a lone sentinel in the darkness."
"{pale, furry, muscular humanoids} grimling warriors"
""
""
"stand guard here."
"Chest heaving and huffing in an almost animal fashion, this white-furred
humanoid male samples the air through a snout-like nose.  A stooped, crouching
posture and enormous black eyes attest that this race has evolved underground
for what must have been thousands of years.  Thick, coarse, dirty white hair
covers his body, serving both as clothing and protection against the damp and
cold of the cavern life.  Roughly five feet tall and wiry with muscle, healed
wounds serve as evidence that this creature is no stranger to battle.
"
"Nereus"
""
"Nereus"
"if( !char_affected( mob, haste ) && 1d8 == 2 ) {
  act_notchar( #scream, mob );
  interpret( mob, \"berserk\" );
  do_spell( haste, mob, mob, 10 );
}
if( !wearing_obj( 4724, mob ) ) {
  rch = rand_player( room );
  if( !can_see_char( mob, rch ) )
    rch = victim;
  act_notchar( #noweapons, mob, null, rch );
  attack( mob, rch, 4d8+8, \"desperate bite\" );
  attack( mob, victim, 5d6+3, \"frantic clawing\" );
  if( attack( mob, victim, 5d6+3, \"frantic clawing\" ) ) {
    do_spell( blind, mob, ch, 5 );
  }
  if( attack( mob, victim, 5d6+3, \"frantic clawing\" ) ) {
    do_spell( blind, mob, ch, 5 );
  }
}
else {
  attack_weapon( mob, victim, 1d0+30, \"[BUG]\" );
