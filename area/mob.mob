if( random( 1, 5 ) == 4 ) {
  act_room( #flap, ch );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( is_fighting( rch ) && can_see_char( mob, rch ) ) {
        j = 10d10+100;
        dam_message( rch, j, \"A gargoyle's slicing wing swipe\" );
        inflict( rch, mob, j, \"black marble, silver veined gargoyle\" );
        }
      }
    }
  }
if( random( 1, 4 ) == 3 ) {
  act_tochar( #gaze, ch );
  act_notchar( #gaze2, ch );
  j = 20d10;
  act_room( #zap, ch );
  shock_message( ch, j, \"The forked lightning\" );
  inflict_shock( ch, mob, j, \"black marble, silver veined gargoyle\" );
  }
if( random( 1, 3 ) == 2 )
  attack( mob, ch, 2d25+75, \"rock hard elbow smash\" );
