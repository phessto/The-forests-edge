"Genna"
""
"titaness of beauty"
""
""
"hovers gracefully before you."
"titanesses of beauty"
""
""
"hover gracefully before you."
"Silky golden hair cascades down the irresistably beautiful visage of the
twenty-five foot woman before you.  Her sky blue eyes are large and round,
examining everything before her with a warm demeanor.  Her shoulders are
smooth and in a V shape.  Toned arms extend from the shoulders and end in
delicate fingers with manicured fingernails.  Her figure is that of an
hourglass supported by strong, shapely legs.  She smells pleasant like a sweet
mixture of roses and honey.
"
"Olah"
""
"Olah"
"attack( mob, victim, 3d30+50, \"powerful strike\" );
attack( mob, victim, 3d45+40, \"smiting blow\" );
attack( mob, victim, 6d20+40, \"wrathful strike\" );
attack( mob, victim, 4d30+40, \"furious smite\" );
i = 1d5;
if( i == 1 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_tochar( #slay, ch );
    act_notchar( #nslay, ch );
    do_spell( slay, mob, victim, 5 );
    }
  }
if( i == 3 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_room( #fire, ch );
    j = 5d40+40;
    fire_message( victim, j, \"The titaness of beauty's fire storm\" );
    inflict_fire( victim, mob, j, \"A titaness of beauty's fire storm\" );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 5 ) {
          j = 5d40+50;
          fire_message( rch, j, \"The titaness of beauty's fire storm\" );
          inflict_fire( rch, mob, j, \"A titaness of beauty's fire storm\" );
          }
        }
      }
    }
  }
if( random( 1, 7 ) == 7 ) {
  act_tochar( #hurl, ch );
  act_notchar( #nhurl, ch );
  set_resting( victim );
  }
attack( mob, victim, 5d25+35, \"furious punch\" );
if( random( 1, 9 ) < 7 ) {
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( random( 1, 9 ) < 8 )
        attack( mob, rch, 3d45+40, \"tornado punch\" );
      }
    }
  }
attack( mob, victim, 4d40+35, \"powerful kick\" );
if( random( 1, 9 ) < 8 )
  attack( mob, victim, 4d40+55, \"thunderous kick\" );
if( i == 5 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_room( #heal, ch );
    do_spell( restoration, mob, mob, 7 );
    }
  }
"
