attack_weapon( mob, victim, 3d30+30, \"powerful jab\" );
attack_weapon( mob, victim, 3d45+35, \"agonizing blow\" );
attack_weapon( mob, victim, 5d20+30, \"wrathful strike\" );
i = 1d5;
if( i == 1 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_tochar( #harm, victim );
    act_notchar( #nharm, victim );
    do_spell( harm, mob, victim, 7 );
    }
  }
if( i == 3 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_room( #fire, ch );
    j = 5d30+40;
    fire_message( victim, j, \"The titan guardian's fire storm\" );
    inflict_fire( victim, mob, j, \"A titan guardian's fire storm\" );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 5 ) {
          fire_message( rch, j, \"The titan guardian's fire storm\" );
          inflict_fire( rch, mob, j, \"A titan guardian's fire storm\" );
          }
        }
      }
    }
  }
attack_weapon( mob, victim, 5d25+35, \"furious punch\" );
if( random( 1, 9 ) < 8 )
  attack( mob, victim, 6d25+30, \"disorienting blow\" );
if( random( 1, 9 ) < 7 ) {
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( random( 1, 9 ) < 8 )
        attack_weapon( mob, rch, 3d45+30, \"tornado punch\" );
      }
