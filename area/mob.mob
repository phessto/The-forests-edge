""
"ettercap"
""
"revolting, spider-like"
"prowls the shadows here."
"ettercaps"
""
"revolting, spider-like"
"prowl the shadows here."
"This loathsome beast stands about five feet tall, though might be taller
if it were not slightly hunched over.  A pair of bony, spindly legs
somehow support this creature's bulbous torso, and a round, spider-like
head sits upon furred shoulders.  A pair of forelimbs that look like they
could function as either arms or legs end in sharp, vicious claws.
"
"Zithuan"
""
"Olah"
"j = 0;
if( attack( mob, victim, 2d16+8, \"keen-edged claw\" ) )
  j = 1;
if( attack( mob, victim, 2d16+8, \"keen-edged claw\" ) && j == 1 )
  j = 2;
if( j == 2 ) {
  act_tochar( #rend, ch, obj, mob );
  act_notchar( #rrend, ch, obj, mob );
  i = 4d12+16;
  dam_message( victim, i, \"+the ettercap's rending claws\" );
  inflict( ch, mob, i, \"ettercap\" );
  }
if( random( 1, 4 ) == 1 ) {
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      act_tochar( #web, rch );
      do_spell( web, mob, rch );
      }
    }
  }
if( attack( mob, victim, 5d7+4, \"vicious bite\" ) == 1 ) {
  poison( victim );
  if( random( 1, 3 ) == 1 ) {
    act_tochar( #bite, ch, obj, mob );
    act_notchar( #rbite, ch, obj, mob );
    i = 4d8+10;
    dam_message( victim, i, \"+the ettercap's ripping manibles\" );
    inflict( ch, mob, i, \"ettercap\" );
    poison( victim );
    }
  }
"
