"are here"
"Dressed in a suit of blood-stained leather armor and grasping a gleaming
broadsword, this spectre stares at your with a burning hatrid for all living
beings.  His coarse black hair is braided neatly and tied back with a leather
strap.  His glowing red eyes look like tiny bonfires blazing strongly.  An
aura of evil surrounds his form and stretches out around him like a hand
trying to choke you.
"
"Terek"
""
"Severus"
"attack_weapon( mob, victim, 5d4+5, \"wicked slash\" );
attack_weapon( mob, victim, 5d4+5, \"counterstrike\" );
attack_weapon( mob, victim, 5d4+10, \"strong slash\" );
attack_cold( mob, victim, 5d5, \"ghostly touch\" );
if( random( 1, 6 ) < 3 ) {
  i = 5d5+10;
  act_room( #wail, ch, obj, mob );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
sound_message( rch, i, \"The gnomish ranger's unearthly wailing\" );
inflict_sound( rch, mob, i, \"The gnomish ranger's unearthly wailing\" );
      }
    }
  }
if( random( 1, 5 ) == 1 ) {
  i = 5d5+10;
  act_tochar( #soul, ch, obj, mob );
  act_notchar( #soul1, ch, obj, mob );
  dam_message( victim, i, \"The gnomish ranger's soul strike\" );
  inflict( victim, mob, i, \"The gnomish ranger's soul strike\" );
  }
