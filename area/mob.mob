"if( is_name( arg, \"shock\" ) )
  i = 1;
if( is_name( arg, \"lightning bolt\" ) )
  i = 2;
if( is_name( arg, \"chain lightning\" ) )
  i = 3;
if( is_name( arg, \"arc lightning\" ) )
  i = 4;
if( i > 0 && 1d4 != 2 ) {
  act_notchar( #deft, victim );
  obj = wearing_obj( 4784, victim );
  act_notchar( #deft, victim, obj, null );
  if( i == 1 )
    do_spell( shock, victim, ch, find_skill( ch, shock ) );
  if( i == 2 )
    do_spell( lightning bolt, victim, ch, find_skill( ch, lightning bolt ) );
  if( i == 3 )
    do_spell( chain lightning, victim, ch, find_skill( ch, chain lightning ) );
  if( i == 4 )
    do_spell( arc lightning, victim, ch, find_skill( ch, arc lightning ) );
  end;
}
if( is_name( arg, \"web\" ) && 1d2 == 2 ) {
  act_notchar( #dodge, victim );
  end;
}
continue;
"
