if ( !is_pet( mob ) ) {
  loop( all_in_room ) {
    if( is_player( rch ) ) {
      if( random( 1, 4 ) == 1 ) {
        i = 5d5+135;
        act_room( #firestorm, ch );
        attack_fire( mob, rch, i, \"wall of fire\" );
      }
    }
  }
}
