  attack_acid( mob, victim, 4d5, \"spew of corrosive liquid\" );
  }
attack( mob, victim, 1d12, \"sharp, rocky edge\" );
if( attack( mob, victim, 1d12, \"shark, rocky edge\" ) )
  interpret( mob, \"bash\" );
