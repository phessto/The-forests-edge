#2379
"Arkillion"
""
"goblin eremite, chosen of Morkith"
""
""
"performs a flowing kata around the room."
"goblin eremite's, chosen of morkith"
""
""
"perform an intricate weaving kata around the room."
"Before you stands a goblin in the prime of his life.  Surprisingly this
goblin's skin appears to be a clean, crisp dark green stretched taught
over bulging musceles.  Dark black hair tops his skull, cut into a short
military like crewcut, that only seems to further set him apart from his
race.  Black eyes showing no hint of color stare out across the room, no
doubt surveying his surroundings constantly.  Shirtless and shoeless he
dances about the room in one flowing, violent motion.
"
"Soren"
""
""
"attack( mob, victim, 5d4+40, \"tiger paw\" );
attack( mob, ch, 2d15+50, \"bear grasp\" );
if( random( 1, 3 ) == 1 )
  interpret( mob, \"emote grins fiendishly.\" );
attack( mob, ch, 2d10+50, \"locust kick\" );
if( random( 1, 4 ) == 2 ) {
  loop( all_in_room ) {
    if( is_player( rch ) ) {
      send_to_room( #sweep, room );
      j = 5d10+100;
      dam_message( rch, j, \"Arkillion's spin kick\" );
      inflict( rch, mob, j, \"Arkillion's spin kick\" );
      }
    }
  }
if( random( 1, 4 ) == 3 ) {
  send_to_room( #drop, room );
  send_to_room( #drop2, room );
  attack( mob, ch, 4d4+100, \"upper cut\" );
  }
if( random( 1, 6 ) == 4 ) {
  send_to_room( #dark1, room );
  act_tochar( #kill1, ch );
  act_notchar( #kill2, ch );
  attack( mob, ch, 75d3+150, \"shadow punch\" );
  }
