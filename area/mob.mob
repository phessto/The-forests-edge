"i = 1d6;
if( i == 3 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_tochar( #crit, victim );
    act_notchar( #ncrit, victim );
    do_spell( cause critical, mob, victim, 7 );
    }
  }
if( i == 5 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_room( #call, ch );
    do_spell( call lightning, mob, victim, 7 );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 5 )
          do_spell( call lightning, mob, rch, 7 );
        }
      }
    }
  }
if( i == 6 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_room( #heal, ch );
    do_spell( cure critical, mob, mob, 10 );
    }
  }
attack( mob, victim, 3d30+20, \"powerful elbow\" );
j = 1d3;
if( j == 1 ) {
  act_room( #flurry, ch );
  attack( mob, victim, 3d40+30, \"painful blow\" );
  attack( mob, victim, 5d25+30, \"furious punch\" );
  attack( mob, victim, 5d20+25, \"lightning quick strike\" );
  if( random( 1, 9 ) < 8 )
    attack( mob, victim, 6d25+30, \"disorienting blow\" );
  if( random( 1, 9 ) < 7 ) {
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 8 )
          attack( mob, rch, 3d40+30, \"spinning punch\" );
        }
      }
    }
  }
else {
  attack( mob, victim, 3d30+15, \"strong blow\" );
  attack( mob, victim, 5d20+20, \"powerful punch\" );
  if( random( 1, 9 ) < 8 )
    attack( mob, victim, 6d20+20, \"jarring blow\" );
  if( random( 1, 9 ) < 7 ) {
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 8 )
          attack( mob, rch, 3d25+20, \"spinning punch\" );
        }
      }
    }
  }
attack( mob, victim, 4d25+20, \"strong kick\" );
if( random( 1, 9 ) < 8 )
  attack( mob, victim, 4d25+40, \"powerful kick\" );
