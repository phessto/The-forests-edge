"list = contents( room );
i = 0;
loop( item( list, i ) && i < 99 ) {
  obj = object( item( list, i ) );
  if( !obj || obj_type( obj ) != trash ) {
    remove( list, i );
    } else {
  i += 1;
  }
}
take( mob, list );
junk( mob, list );
continue;
