"mob = mob_in_room( 2425, room );
act_room( #huzzah, ch );
if( get_religion( ch ) == Cynnis ) {
  interpret( mob, \"hug\", ch );
  if( class( ch ) == cleric || class( ch ) == paladin ) {
    wait( 1 );
    if( has_obj( 4004, ch ) ) {
      act_tochar( #has_symbol, ch );
      }
    else {
      act_tochar( #symbol, ch );
      obj_to_char( oload( 4004 ), ch );
      }
    }
  act_tochar( #heal, ch );
  cast_spell( heal, mob, ch );
  wait( 1 );
  act_tochar( #blessing, ch );
  cast_spell( bless, mob, ch );
  }
wait( 1 );
act_tochar( #feather, ch );
obj_to_char( oload( 586 ), ch );
