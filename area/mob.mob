"glare at you haughtily."
"Tall and arrogant is the vyan woman standing before you.  Her ebony skin
is covered with runic patterns that have been tattooed in sullen crimson
tones and violent yellows.  Short ringlets of snow-white hair fall
loosely on her head, adorned here and there with precious gemstones in a
variety of colors.  Her delicate, slender hands fairly crackle with
arcane energy; indeed sparkles of incandescent green jump between her
long, sharply pointed crimson nails.
"
"Zithuan"
""
""
"attack_weapon( mob, victim, 3d6+2, \"left hand\" );
attack_weapon( mob, victim, 3d6+2, \"right hand\" );
i = random( 1, 7 );
if( i == 6 ) {
  act_room( #flame, ch, obj, mob );
  do_spell( flame strike, mob, victim );
  }
if( i == 5 ) {
  act_room( #ice, ch, obj, mob );
  do_spell( ice lance, mob, victim );
  }
if( i == 4 ) {
  act_room( #lightning, ch, obj, mob );
  do_spell( chain lightning, mob, victim );
  }
if( i == 3 ) {
  act_room( #acid, ch, obj, mob );
  do_spell( acid storm, mob, victim );
  }
if( i == 2 ) {
  act_room( #fear, ch, obj, mob );
  rch = rand_player( room );
  interpret( rch, \"flee\" );
  }
if( i == 1 ) {
  act_room( #darkness, ch, obj, mob );
  loop( all_in_room ) {
    if( wearing_obj( 21, rch ) ) {
      obj = wearing_obj( 21, rch );
      act_tochar( #dark, rch, obj, mob );
      junk_obj( wearing_obj( 21, rch ) );
      }
    }
  }
"
