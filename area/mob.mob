"attack( mob, victim, 30d2+75, \"mighty blow\" );
if (1d2 == 2 ) {
  act_tochar( #uhrt, ch, null, mob );
  act_notchar( #hrt, ch, null, mob );
  do_spell( slay, mob, ch, 14 );
}
i = 1d4;
if ( i == 1 ) {
  act_room( #blind, mob );
  loop ( all_in_room ) {
    if ( is_pet( rch ) || is_player( rch ) ) {
      if ( is_fighting( rch ) ) {
        do_spell( blind, mob, rch, 16 );
        set_delay( rch, 32 );
      }
    }
  }
}
if ( i == 2 ) {
  act_room( #confuse, mob );
  loop ( all_in_room ) {
    if ( (is_pet( rch ) || is_player( rch )) && is_fighting( rch ) ) {
      do_spell( confuse, mob, rch, 13 );
      do_spell( slow, mob, rch, 15 );
    }
  }
}
if ( i == 3 ) {
  act_room( #flame, mob );
  loop( all_in_room ) {
    if ( (is_pet( rch ) || is_player( rch )) && is_fighting( rch ) ) {
      do_spell ( flame strike, mob, rch, 15 );
    }
  }
}
if ( i == 4 ) {
  if( !is_silenced( mob ) ) {
    act_room( #help, mob );
    summon( mob, victim, 20, 14 );
  }
}
attack( mob, victim, 40d4+68, \"righteous strike\" );
attack( mob, victim, 16d8+70, \"throttle\" );
do_spell( harm, mob, victim, 10 );
"
