""
"are here"
"Unkempt and wild-eyed, this man obviously went insane before his death.  A
short, ragged beard with accompanying moustache climbs up his stubble covered
cheeks to find a small mop of uncombed hair atop his head.  A long black cloak
is wrapped about his body, though it is somewhat unclear how much of his
shadowy form even exists within the folds of his cloak.  About his neck hangs
a small talisman with an infinity symbol intertwined with an hourglass.
"
"Zithuan"
""
"Zithuan"
"i = 6d12+18;
if( attack( mob, victim, i, \"spectral touch\" ) ) {
  heal( mob, i );
  }
i = 6d12+18;
if( attack( mob, victim, i, \"spectral touch\" ) ) {
  heal( mob, i );
  }
if( 1d6 == 1 ) {
  act_room( #lightning, mob );
  do_spell( chain lightning, mob, rand_player( room ) );
  }
if( 1d8 == 1 ) {
  act_room( #storm, mob );
  loop( all_in_room ) {
    rch = rand_player( room );
    i = 1d4;
    if( i < 4 ) {
      act_tochar( #struck, rch, obj, mob );
      act_notchar( #rstruck, rch );
      }
    if( i == 1 )
      drain_stat( rch, con, 1d3, -1 );
    if( i == 2 )
      drain_stat( rch, str, 1d3, -1 );
    if( i == 3 )
      drain_stat( rch, int, 1d3, -1 );
    heal( mob, find_stat( rch, level ) );
    }
  }
do_spell( cure serious, mob, mob, 1 );
if( find_stat( mob, hit ) == 1999 ) {
  act_room( #fade, mob );
  if( has_obj( 3641, mob ) ) {
    act_room( #drop, ch );
    obj_to_room( has_obj( 3641, mob ), room );
    obj_to_room( oload( 3641 ), find_room( 46 ) );
    }
  junk_mob( mob );
  remove_rflag( reset0, room );
  }
"
