    tell( mob, ch, #blue1 );
  if( cflag( 128, ch ) )
    tell( mob, ch, #red1 );
  if( cflag( 129, ch ) )
    tell( mob, ch, #black1 );
  if( cflag( 130, ch ) )
    tell( mob, ch, #green1 );
  act_tochar( \"$N gives you $p.\", ch, obj, mob );
  act_notchar( \"$N gives $n $p.\", ch, obj, mob );
  obj_to_char( obj, ch );
  }
else {
  set_cflag( 127, ch );
  remove_cflag( 128, ch );
  remove_cflag( 129, ch );
  remove_cflag( 130, ch );
  tell( mob, ch, #blue );
  junk_obj( has_obj( 1726, mob ) );
  }
