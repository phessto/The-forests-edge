    obj = wield( mob );
if( obj ) {
    act_tochar( #point, rch, obj, mob );
    act_notchar( #rpoint, rch, obj, mob );
    do_spell( cause serious, mob, rch, 3 );
}
    }
  }
if( is_altered( mob ) ) {
  attack( mob, victim, 2d6+2, \"vicious bite\" );
  attack( mob, victim, 1d8+3, \"savage left claw\" );
  attack( mob, victim, 1d8+3, \"savage right claw\" );
  if( random( 1, 4 ) == 1 )
    attack_room( mob, 2d6+4, \"berserk claw flurry\" );
  }
"
