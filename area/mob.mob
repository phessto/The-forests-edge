"male demi-titans"
""
"statuesque, well-built"
"are hovering around."
"Raven-black, curled locks hang wistfully off the forehead of this fifteen foot
man.  Ocean blue eyes peer out from his chiseled face.  Completing the rest of
his countenance are high cheek bones, thick black eyebrows, and a wide mouth. 
Not a blemish can be found on any of his tanned skin.  Muscles ripple from his
limbs, and there is a certain grace to their movements.
"
"Olah"
""
"Olah"
"i = 1d5;
if( i == 1 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_tochar( #crit, victim );
    act_notchar( #ncrit, victim );
    do_spell( cause critical, mob, victim, 7 );
    }
  }
if( i == 3 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_room( #wither, ch );
    do_spell( wither, mob, victim, 7 );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 6 )
          do_spell( wither, mob, rch, 7 );
        }
      }
    }
  }
if( i == 5 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_room( #heal, ch );
    do_spell( cure critical, mob, mob, 10 );
    }
  }
attack( mob, victim, 3d30+25, \"powerful jab\" );
j = 1d3;
if( j == 1 ) {
  act_room( #flurry, ch );
  attack( mob, victim, 3d45+30, \"agonizing blow\" );
  attack( mob, victim, 5d25+30, \"furious punch\" );
  attack( mob, victim, 5d20+25, \"lightning quick strike\" );
  if( random( 1, 9 ) < 8 )
    attack( mob, victim, 6d25+30, \"disorienting blow\" );
  if( random( 1, 9 ) < 7 ) {
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 8 )
          attack( mob, rch, 3d45+30, \"tornado punch\" );
        }
      }
    }
  }
else {
  attack( mob, victim, 3d35+20, \"powerful blow\" );
  attack( mob, victim, 5d20+15, \"powerful punch\" );
  if( random( 1, 9 ) < 8 )
    attack( mob, victim, 6d20+20, \"jarring blow\" );
  if( random( 1, 9 ) < 7 ) {
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 8 )
          attack( mob, rch, 3d25+20, \"spinning punch\" );
        }
      }
    }
  }
attack( mob, victim, 4d25+20, \"strong kick\" );
if( random( 1, 9 ) < 8 )
  attack( mob, victim, 5d25+35, \"powerful kick\" );
"
