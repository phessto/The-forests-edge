""
""
"are here"
"This hunched man is an enigma of age and youth.  He seems unable to support
his own weight with his bony, frail frame and near total lack of musculature,
and stands hunched as if beaten.  Fine, snowy hair rests in an unkempt mop
atop his head, the hair of the truly ancient and infirm.  No facial hair at
all covers his face, revealing skin the color of bleached parchment, which
hangs in folds around his eyes and mouth, drooping sadly.  At the same time,
his eyes are not rheumy; they are the inquisitive, piercing eyes of an
intelligent youth.  His hands are not arthritic claws; they are flexible,
agile, and the skin smooth.  Meeting his gaze is like looking into blackness;
into terrible deeds and sights - of carnage, of torture, of worlds beyond this
one, and of things better left unseen.
"
"Nereus"
""
"Nereus"
"if( char_affected( mob, invisibility ) )
  dispel_affect( mob, invisibility );
ch = null;
loop( all_in_room ) {
  if( is_player( rch ) ) {
    if( !ch ) {
      if( class( rch ) == mage )
        ch = rch;
      }
    if( class( rch ) == cleric )
      ch = rch;
    }
  }
if( !ch )
  ch = victim;
i = 1d8;
if( i == 1 ) {
  act_notchar( #flame, mob );
  do_spell( flame strike, mob, ch );
  }
if( i == 2 ) {
  act_notchar( #sibilant, mob );
  loop( all_in_room ) {
    if( is_player( rch ) ) {
      if( char_affected( rch, resist sleep ) )
        do_spell( slow, mob, rch, 20 );
      else
        do_spell( sleep, mob, rch, 15 );
      }
    }
  }
if( i == 3 ) {
  act_notchar( #discordant, mob );
  do_spell( faerie fire, mob, ch, 10 );
  do_spell( conflagration, mob, ch, 22 );
  rch = rand_player( room );
  if( rch )
    do_spell( conflagration, mob, rch, 18 );
  }
if( i == 4 ) {
  act_notchar( #screaming, mob );
  do_spell( fear, mob, ch, 10 );
  rch = rand_player( room );
  if( rch )
    do_spell( fear, mob, rch, 12 );
  rch = rand_player( room );
  if( rch )
    do_spell( fear, mob, rch, 12 );
  }
if( i == 5 ) {
  act_notchar( #frozen, mob );
  do_spell( paralyze, mob, ch, 10 );
  rch = rand_player( room );
  if( rch )
    do_spell( paralyze, mob, rch, 12 );
  rch = rand_player( room );
  if( rch )
    do_spell( paralyze, mob, rch, 12 );
  }
if( i == 6 ) {
  act_notchar( #meteor, mob );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( is_pet( rch ) ) {
        do_spell( prismic missile, mob, rch, 20 );
        if( 1d2 == 1 )
          do_spell( prismic missile, mob, rch, 20 );
        }
      if( 1d7 != 2 )
        do_spell( prismic missile, mob, rch, 12 );
      if( 1d5 != 2 )
        do_spell( prismic missile, mob, rch, 15 );
      if( 1d3 != 2 )
        do_spell( prismic missile, mob, rch, 20 );
      }
    }
  }
if( i == 7 ) {
  act_neither( #ice, mob, null, ch );
  act_tochar( #ices, ch, null, mob );
  do_spell( ice storm, mob, ch, 18 );
  }
if( i == 8 ) {
  act_neither( #acid, mob, null, ch );
  act_tochar( #acids, ch, null, mob );
  do_spell( acid storm, mob, ch, 20 );
  }
