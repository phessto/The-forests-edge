"Standing about six and a half feet tall, this muscular brute of a man
constantly scans the area looking for intruders.  His arms and legs are
so large that they protrude from his many layers of clothing.  His
narrow-eyes suddenly focus their attention on you, and a gleam of
excitement ignites in them.
"
"Kotoktok"
""
"Kotoktok"
"if( wearing_obj( 3027, mob ) || wearing_obj( 2676, mob ) ) {
  if( random( 0, 9 ) < 4 )
    attack( mob, victim, 6d10+18, \"powerful stab\" );
  attack( mob, victim, 3d10+15, \"second pierce\" );
  attack( mob, victim, 3d10+15, \"third pierce\" );
  if( random( 0, 9 ) < 8 )
    attack( mob, victim, 5d9+20, \"potent pierce\" );
}
else {
  if( random( 0, 9 ) < 5 )
    attack( mob, victim, 6d10+12, \"power-packed punch\" );
  attack( mob, victim, 3d9+10, \"fierce kick\" );
  act_tochar( #lunge, ch );
  act_notchar( #rlunge, ch );
  attack( mob, victim, 3d10, \"strangulation\" );
  attack( mob, victim, 4d7, \"powerful punch\" );
  if( random( 0, 9 ) < 8 )
    attack( mob, victim, 5d9+20, \"two-fisted crush\" );
}
if( random( 1, 5 ) < 3 ) {
  send_to_room( #spin, room );
  loop( all_in_room )  {
    if( is_player( rch ) ) {
      if( random( 0, 9 ) < 8 )
        attack( mob, rch, 3d10+15, \"spinning punch\" );
    } } }
