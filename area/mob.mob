"Valynar"
""
"portly man with long, braided black hair"
""
""
"stands here, arms crossed across his chest."
"[BUG]"
""
""
"are here"
"A palpable aura of evil surrounds this man, despite his otherwise fairly
ordinary appearance.  He is a short man, only a few inches taller than five
feet, and a body that might have been trim in youth has begun to turn to fat
in places.  Beneath a broad chest and shoulders, a large paunch hangs out,
evident even through the loose-fitting clothing he wears.  Iron-black hair
adorns his head, swept back into long braids that hang to the middle of his
back and are tied with ornate silver thread.  Silver is streaked through the
braids in places, a sign that he may be older than his other attributes would
lead one to believe.  Strong, sturdy hands end in stubby fingers, the tips
covered with a crimson stain that can only be blood.  A twisted, cruel sneer
is visible on his face.  Deep wrinkles on his forehead and around the corners
of his mouth betray that this is an expression he wears often.
"
"Nereus"
""
"Nereus"
"j = find_stat( mob, hit ) * 100;
k = find_stat( mob, max_hit );
if( ( j / k ) < 30 && rflag( reset0, room ) ) {
  act_notchar( #pray, mob );
  remove_rflag( reset0, room );
  if( 1d3 == 2 ) {
    act_notchar( #dimlight, mob );
    heal( mob, 5000 );
    }
  }
i = 0;
loop( all_in_room ) {
  if( !is_player( rch ) && !is_pet( rch ) ) {
    j = find_stat( rch, hit ) * 100;
    k = find_stat( rch, max_hit );
    if( ( j / k ) < 80 )
      i = i + 1;
    }
  }
if( i > 2 ) {
  act_notchar( #casts, mob );
  loop( all_in_room ) {
    if( !is_player( rch ) && !is_pet( rch ) ) {
      do_spell( heal, mob, rch, 20 );
      heal( rch, 400 );
      }
    }
  }
else {
  i = 0;
  loop( all_in_room ) {
    if( !is_player( rch ) && !is_pet( rch ) ) {
      if( i == 0 ) {
        if( is_sleeping( rch ) && 1d5 == 2 ) {
          i = 1;
          do_spell( purify, mob, rch );
          act_notchar( #whispers, mob, null, rch );
          }
        else {
          j = find_stat( rch, hit ) * 100;
          k = find_stat( rch, max_hit );
          if( ( j / k ) < 75 ) {
            act_notchar( #whispers, mob, null, rch );
            do_spell( restoration, mob, rch, 25 );
            heal( mob, 800 );
            i = 1;
            }
          }
        }
      }
    }
  }
if( i == 0 ) {
  rch = rand_player( room );
  if( rch ) {
    act_tochar( \"@C$N points at you, whispering words of prayer.@n\", rch, null, mob );
    act_notchar( \"@C$N points at $n, whispering words of prayer.@n\", rch, null, mob );
    if( class( rch ) == mage || class( rch ) == paladin || class( rch ) == cleric ) {
      if( !char_affected( rch, silence ) )
        do_spell( silence, mob, rch, 12 );
      else {
        if( !char_affected( rch, blind ) )
          do_spell( blind, mob, rch, 12 );
        else
          do_spell( slay, mob, rch, 20 );
        }
      }
    else {
      do_spell( slay, mob, rch, 20 );
      }
    }
  }
if( 1d2 == 1 )
  attack_weapon( mob, ch, 1d6, \"desperate punch\" );
"
