"wait( 1 );
if( !char_in_room( ch, room ) ) end;
  if( get_religion( ch ) == Xiroce ) {
  if( class( ch ) == cleric || class( ch ) == paladin ) {
    if( find_stat( ch, prayer ) >= 700 )
      act_tochar( #disciple, ch );
    else act_tochar( #adherent, ch );
      }
  else {
    if( find_stat( ch, prayer ) >= 700 )
      act_tochar( #devoted, ch );
    else act_tochar( #follower, ch );
      }
  wait( 2 );
  if( !char_in_room( ch, room ) ) end;
    if( class( ch ) == cleric || class( ch ) == paladin ) {
    if( !has_obj( 446, ch ) && !wearing_obj( 446, ch ) ) {
      if( !has_obj( 454, ch ) && !wearing_obj( 454, ch ) )
        act_tochar( #holy_symbol, ch );
      else
        act_tochar( #holier_symbol, ch );
      }
    }
  }
else interpret( mob, \"glare\", ch );
"
E
"disciple"
"The priest smiles as you enter and says, \"@MWelcome, $n, disciple of Xiroce. 
You may rest here until such time as you choose to travel onward or choose to
enter the final rest.@n\"
"
E
"adherent"
"The priest smiles as you enter and says, \"@MWelcome, $n, adherent of Xiroce. 
You may rest here until such timeas you choose to travel onward or choose to
enter the final rest.@n\"
"
E
"devoted"
"The priest sees you enter and says, \"@MWelcome devoted follower of Xiroce. 
You may rest here if you need until it is time for you to depart; one way or
another.@n\"
"
E
"follower"
"The priest sees you enter and says, \"@MGreetings follower of Xiroce.  You may
rest here if you need until it is time for you to depart; one way or
another.@n\"
"
E
"holy_symbol"
"Looking you over he adds, \"@MI see you do not carry a nightsheart flower,
holiest symbol of Xiroce.  You should seek one out in the various graveyards of
the land.  They are said to grow only in soil above a corpse that has not been
profaned by the touch of Morkith.@n\"
"
E
"holier_symbol"
"Looking you over he adds, \"@MAh, I see you have acquired a nightsheart
flower.  Hand it to me and I shall give to it Xiroce's blessing that it may
serve you better.@n\"
"
!
6 454
""
"if( get_religion( ch ) == Xiroce ) {
  if( class( ch ) == cleric || class( ch ) == paladin ) {
    act_tochar( #bless, ch );
    junk_obj( has_obj( 454, mob ) );
    obj_to_char( oload( 446 ), ch );
    }
  else {
    act_tochar( #thanks, ch );
    i = random( 1, 3 );
    if( i == 1 )
      cast_spell( bless, mob, ch );
    if( i == 2 )
      cast_spell( armor, mob, ch );
    if( i == 3 )
      cast_spell( holy wrath, mob, ch );
    }
  }
else
  act_tochar( #glare, ch );
"
E
"bless"
"@MThe priest accepts the nightsheart flower and recites a blessing over it. 
The flower briefly thobs with added darkness then returns to normal as the
incantation comes to a stop.  The priest then presents the imbued holy symbol
back to you.
"
E
"thanks"
"The priest looks at the flower, then you, takes the flower and says, \"@MThank
you for the rare gift follower of Xiroce.  It will be put to good use in the
hands of one of Xiroce's priests.  In exchange, let me offer you this token of
my thanks.@n\"
"
E
"glare"
"The priest glares at you and snatches the flower out of your hand saying,
\"@MThe holy items of Xiroce are profaned by your hands.  Leave this place
blasphemer!@n\"
"
!
