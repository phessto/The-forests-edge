    if( is_name( \"green\", name( mob, obj ) ) || is_name( \"gray\", name( mob, obj ) ) ) {
      set_singular( obj, \"dark green 'cavalry officer's sabretache'\" );
      set_plural( obj, \"dark green 'cavalry officer's sabretache'\" );
    }
    if( is_name( \"blue\", name( mob, obj ) ) || is_name( \"teal\", name( mob, obj ) ) ) {
      set_singular( obj, \"teal 'cavalry officer's sabretache'\" );
      set_plural( obj, \"teal 'cavalry officer's sabretache'\" );
    }
    if( is_name( \"black\", name( mob, obj ) ) || is_name( \"brown\", name( mob, obj ) ) ) {
      set_singular( obj, \"black 'cavalry officer's sabretache'\" );
      set_plural( obj, \"black 'cavalry officer's sabretache'\" );
    }
  }
}
if( cflag( 127, ch ) || cflag( 128, ch ) || cflag( 129, ch ) || cflag( 130, ch ) )
  act_room( \"$N carefully applies the dye to produce $p.\", ch, obj, mob );
else
  tell( mob, ch, \"I'm sorry, but you haven't given me the dye for this item.\" );
act_tochar( \"$N gives you $p.\", ch, obj, mob );
act_notchar( \"$N gives $n $p.\", ch, obj, mob );
obj_to_char( obj, ch );
remove_cflag( 127, ch );
remove_cflag( 128, ch );
remove_cflag( 129, ch );
remove_cflag( 130, ch );
"
!
