"Kotoktok"
"i = random( 1, 6 );
if( i == 6 )
  interpret( mob, \"bash\" );
if ( attack( mob, victim, 5d30+70, \"tremendous bite\" ) ) {
  if (random(1,5) < 3) {
    act_tochar(#biteu, victim, null, mob);
    act_notchar(#bite, victim, null, mob);
    i = 50d6+55;
    dam_message( victim, i, \"+The viciously tearing teeth\");
    inflict( victim, mob, i, \"+The viciously tearing teeth\" );
  }
}
attack( mob, victim, 15d15+10, \"tail swipe\" );
if (random(1,5) == 2) {
  act_notchar(#tail,mob);
  loop(all_in_room) {
    if ( (is_player(rch) || is_pet(rch)) && !is_pet(mob)) {
      attack (mob, victim, 15d15+10, \"sweeping tail\");
    }
  }
}
attack( mob, victim, 10d20+30, \"earthshaking stomp\" );
"
