"Pelanax"
""
"vyan adept, chosen of Morkith"
""
""
"prays to his dark master."
"vyan adepts, chosen of Morkith"
""
""
"pray to their dark master."
"Nearly completely enshrouded in his dark robes, this vyan adept is of an
indetermined age.  Almost none of his skin is visible save for his hands
and portions of his face not covered by his hood.  His ebon skin is
smooth and lacks any noticeable wrinkles though this is not rare for his
race.  He stands at a height of six foot, his build shrouded by the
layers of fine material that makes up his robes.
"
"Soren"
""
"Hedrack"
"if( wearing_obj( 1404, mob ) ) {
  attack( mob, ch, 5d5+70, \"smash\" );
  attack( mob, ch, 5d5+50, \"left uppercut\" );
  attack( mob, ch, 5d4+70, \"smash\" );
}
if( !wearing_obj( 1404, mob ) ) {
  attack( mob, ch, 5d5+50, \"left uppercut\" );
  attack( mob, ch, 5d2+25, \"strong kick\" );
  act_room( #pray, ch );
  heal( mob, 150 );
}
if( random( 1, 10 ) > 4 ) {
  if( mob_in_room( 2377, find_room( 17266 ) ) )
    acode( room, 2 );
}
if( random( 1, 4 ) == 3 ) {
  ch = rand_player( room );
  if( obj_in_room( 3576, room ) ) {
    act_tochar( #point1, ch );
    act_notchar( #point2, ch );
    act_room( #candle1, ch );
    do_spell( harm, mob, ch );
  }
  else {
    if( ch != mob ) {
      act_tochar( #point1, ch );
      act_notchar( #point2, ch );
      do_spell( cause critical, mob, ch );
    }
  }
}
if( random( 1, 4 ) == 2 ) {
  j = 5d10+125;
  loop( all_in_room ) {
    if( obj_in_room( 3576, room ) ) {
      if( rch != mob ) {
        send_to_room( #sweep, room );
        act_tochar( #candle1, rch );
        drain_stat( rch, con, 5, -1 );
        dam_message( rch, j, \"the touch of Morkith\" );
        inflict( rch, mob, j, \"the touch of Morkith\" );
      }
    }
    else {
      if( rch != mob ) {
        j = 8d10+50;
        send_to_room( #sweep, room );
        dam_message( rch, j, \"the distant touch of Morkith\" );
      }
      inflict( rch, mob, j, \"the distant touch of Morkith\" );
    }
  }
}
if( random( 1, 4 ) == 2 ) {
  act_room( #cure, ch );
  do_spell( cure critical, mob, mob );
}
"
