""
"exuding a radiant aura glides easily through the air."
"prismatic forest spirits"
""
""
"exuding radiant auras glide easily through the air."
"This spirit is a translucent figure of cascading colors whose image blurs and
bends in the light.  It appears humanoid in form, at least as far as it has
something resembling a head and a torso below it.  The torso tapers to a small
point, and it floats easily above the ground.  Sparkling flashes of light wink
in and out all about its figure.  A prismatic aura of all colors surrounds the
being and distorts the air around it with an unnatural glow.
"
"Malrothe"
""
"Malrothe"
"attack( mob, victim, 4d7+20, \"spiritual slash\" );
if( random( 1, 3 ) == 1 ) {
  act_tochar( #spear, ch );
  act_notchar( #rspear, ch );
  attack( mob, victim, 3d8+25, \"spearing blow\" );
  }
attack( mob, victim, 3d6+24, \"crushing blow\" );
if( random( 1, 5 ) == 1 ) {
  act_room( #rain, ch );
  loop( all_in_room ) {
    if( !is_group( rch, Aura ) ) {
      do_spell( prismic missile, mob, rch );
      }
    }
  }
loop( all_in_room ) {
  if( !is_group( rch, Aura ) ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( random( 1, 6 ) == 1 ) {
        act_tochar( #aura, rch );
        i = random( 1, 4 );
        if( i == 1 )
          attack_cold( mob, rch, 4d20+12, \"icy attack\" );
        if( i == 2 )
          attack_fire( mob, rch, 4d20+12, \"flaming strike\" );
        if( i == 3 )
          attack_shock( mob, rch, 4d20+12, \"electric lance\" );
        if( i == 4 )
          attack_acid( mob, rch, 4d20+12, \"withering essence\" );
        }
      }
    }
  }
