"if ( get_religion(victim) != Meriada ) {
  act_notchar( #heaven1, victim, null, mob );
  act_tochar( #heaven2, victim, null, mob );
  do_spell( harm, mob, victim, 13 );
  if (1d35 == 9)
    do_spell( slay, mob, victim, 15 );
}
else
  {
  act_notchar( #cant, victim, null, mob );
  act_tochar( #cant2, victim, null, mob );
}
i = 1d5;
if ( !mob_in_room( 2863, room ) && has_obj(2889, mob) ) {
  obj = has_obj(2889, mob);
  act_notchar( #golem, mob, obj, null );
  send_to_room( #golem2, room );
  mload( 2863, room );
  junk_obj( obj, 1 );
}
if ( i == 1 ) {
  act_notchar( #heal, mob );
  do_spell( heal, mob, mob, 15 );
}
if (i > 3) {
  act_notchar( #hail, mob );
  loop (all_in_room) {
    if ( ( get_religion(rch) != Meriada) && (is_player( rch ) || is_pet( rch )) ) {
      do_spell( slay, mob, rch, 10 );
    }
  }
}
attack_magic( mob, victim, 10d15+125, \"enchanted strike\" );
attack( mob, victim, 5d5+7, \"angry punch\" );
if (i <= 3)
  attack( mob, victim, 15d10+143, \"double-fisted blow\" );
acode (room, 1);
