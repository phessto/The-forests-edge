""
"stand ready to protect their charges from harm."
"This knight is a powerfully-built man displaying muscles toned through long
hours of combat practice.  He sports short-cropped hair that won't provide any
threat as a hand-hold for opponents in close combat.  He looks dangerous and
readily capable of inflicting harm on any threats around him at an instant's
notice.  In spite of several battle scars, his powerful physique, bold stance
and confident demeanor give him a look that many might describe as dashing.
"
"Kotoktok"
""
"Kotoktok"
"if( !wearing_obj( 4244, mob ) ) {
  if( has_obj( 4244, mob ) ) {
    if( random( 1, 2 ) == 1 )
      act_room( #wield, ch );
    interpret( mob, \"wear Medienne\" );
    }
  }
if( wearing_obj( 4244, mob ) ) {
  attack( mob, ch, 7d10+30, \"gallant slash\" );
  attack( mob, ch, 7d10+30, \"noble hack\" );
  if( random( 1, 5 ) == 1 )
    attack( mob, ch, 10d20+50, \"superbly placed swing\" );
  }
else {
  attack( mob, ch, 6d8+20, \"punch\" );
  attack( mob, ch, 6d8+20, \"jab\" );
  if( random( 1, 3 ) == 1 )
    interpret( mob, \"bash\" );
  }
if( random( 1, 3 ) == 1 ) {
  summon( mob, victim );
  act_room( \"A Knight calls for assistance.\", ch );
  }
"
