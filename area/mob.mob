if( random( 0, 3 ) == 1 ) {
  if( wearing_obj( 512, mob ) ) {
    send_to_room( #spin, room );
    loop( all_in_room ) {
      if( is_player( rch ) )
        attack( mob, rch, 3d35+5, \"deadly halberd sweep\" );
