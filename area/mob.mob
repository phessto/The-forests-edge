"attack( mob, victim, 3d7+20, \"phantasmal fist\" );
if( random( 1, 3 ) == 1 )
  attack( mob, victim, 3d7+20, \"spectral spear\" );
attack( mob, victim, 3d5+20, \"phantasmal pound\" );
if( random( 1, 5 ) == 1 ) {
  act_room( #rain, ch );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      i = 2d10+30;
      dam_message( rch, i, \"the barrage of falling earth\" );
      inflict( rch, mob, i, \"barrage of earth\" );
      }
    }
  }
if( mob_in_room( 2688, room ) && mob_in_room( 2689, room ) && mob_in_room( 2706, room ) && mob_in_room( 2707, room ) ) {
  if( random( 1, 12 ) == 1 ) {
    act_room( #prism, mob );
    mload( 2709, room );
    junk_mob( mob_in_room( 2688, room ) );
    junk_mob( mob_in_room( 2706, room ) );
    junk_mob( mob_in_room( 2689, room ) );
    junk_mob( mob );
    end;
    }
  }
i = 0;
loop( all_in_room ) {
  if( is_group( rch, Aura ) )
    i = i + 1;
  }
loop( all_in_room ) {
  if( is_group( rch, Aura ) ) {
    if( i >= 1 )
      if( random( 1, 10 ) == 1 ) {
      act_room( #ally1, rch );
      do_spell( vitality, rch, rch );
      }
    if( i >= 2 )
      if( random( 1, 20 ) == 1 ) {
      act_room( #ally2, rch );
      do_spell( ogre strength, rch, rch );
      }
    if( i >= 3 )
      if( random( 1, 30 ) == 1 ) {
      act_room( #ally3, rch );
      do_spell( thorn shield, mob, rch );
      }
    }
  else {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( i >= 1 )
        if( random( 1, 10 ) == 1 ) {
        act_tochar( #foe1, rch );
        act_notchar( #rfoe1, rch );
        do_spell( web, mob, rch );
        }
      if( i >= 2 )
        if( random( 1, 20 ) == 1 ) {
        act_tochar( #foe2, rch );
        act_notchar( #rfoe2, rch );
        poison( rch );
        }
      if( i >= 3 )
        if( random( 1, 30 ) == 1 ) {
        act_tochar( #foe3, rch );
        act_notchar( #rfoe3, rch );
        do_spell( hallucinate, mob, rch );
        }
      }
    }
  }
