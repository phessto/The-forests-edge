""
"enormous, muscular black python"
""
""
"lies coiled here."
"enormous, muscular black pythons"
""
""
"lie coiled here."
"This python is perhaps forty-five feet in total length, and easily as thick as
an ogre.  Covered in smooth, black skin on top, and greyish bands of scales on
the bottom, its muscular coils look truly sinister.  A heavy, wide skull
contains two jet-black eyes, which gaze hypnotically at the world around them.
"
"Kotoktok"
""
"Kotoktok"
"if ( attack( mob, victim, 5d6+40, \"+squeezing coils\" ) ) {
  if (random(1,5) < 3) {
    act_tochar(#squeezeu, victim, null, mob);
    act_notchar(#squeeze, victim, null, mob);
    i = 3d6+55;
    dam_message( victim, i, \"The python's death squeeze\");
    inflict( victim, mob, i, \"The python's death squeeze\");
    if( !victim ) {
      end;
    }
    set_delay(victim,32);
  }
}
attack( mob, victim, 2d15+20, \"crushing bite\" );
if ((random(1,5) == 2) && !is_pet(mob)) {
  act_notchar(#coils,mob);
  loop(all_in_room) {
    if ( (is_player(rch) || is_pet(rch)) && !is_pet(mob)) {
      attack(mob, rch, 3d15+25, \"writhing coils\");
    }
  }
}
attack( mob, victim, 2d20+21, \"swift strike\" );
"
