      act_room( #heal, ch, obj, mob );
      do_spell( heal, mob, mob );
      }
    else
      act_room( #mana, ch, obj, mob );
    }
  else
    act_room( #cant, ch, obj, mob );
  }
else if( random( 1, 6 ) == 1 )
  attack( mob, victim, 4d7+5, \"euphoric gaze\" );
