"Cladewyn"
""
"broad, graying man with a bushy beard"
""
""
"plays a gentle tune."
"[BUG]"
""
""
"- Please request an immortal for assistance!"
"This man must have once been muscularly powerful, but much of that seems to
have turned to fat now that he has reached his mid-fifties.  His shoulders,
chest, and arms are still broad and his movements dextrous, though perhaps not
the same as when he was in his prime.  A thick, bushy beard envelops the
bottom of his face, his neck, and the top of his chest; it is coarse, unkempt,
and turning from black to an iron-streaked gray.  His clothing is rumpled and
his eyes bleary, as if he does not see much sleep.  Despite his grim, bleary
look, he seems generally cheerful and always seems to have an instrument close
at hand.
"
"Nereus"
""
"Nereus"
"if( has_obj( 4186, mob ) || has_obj( 969, mob ) ) {
  interpret( mob, \"wear silver.longs\" );
  interpret( mob, \"wear longsword\" );
  }
if( !is_open( room, east ) )
  interpret( mob, \"open east\" );
attack_weapon( mob, victim, 3d6+5, \"right hook\" );
attack_weapon( mob, victim, 3d5+4, \"desperate haymaker\" );
attack_weapon( mob, victim, 3d3+2, \"knee jab\" );
attack_weapon( mob, victim, 3d4+2, \"furious kick\" );
if( 1d12 == 2 )
  interpret( mob, \"bash\" );
if( 1d5 == 2 )
  interpret( mob, \"disarm\", victim );
attack_weapon( mob, victim, 3d4+2, \"furious kick\" );
if( 1d2 == 1 )
  attack_weapon( mob, victim, 2d5+3, \"desperate bite\" );
if( 1d3 != 2 )
  attack_weapon( mob, victim, 3d2+1, \"elbow jab\" );
if( 1d6 == 1  && !is_silenced( mob ) ) {
  interpret( mob, \"yell Help!  Someone is here to attack us!\" );
  summon( mob );
  acode( find_room( 82204 ), 1 );
  }
if( !is_silenced( mob ) ) {
  i = 1d6;
  if( i == 1 ) {
    interpret( mob, \"emote begins singing a soothing, mournful song.\" );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        do_spell( sleep, mob, rch, 10 );
        }
      }
    }
  if( i == 2 ) {
    interpret( mob, \"emote begins singing a jarring, discordant song.\" );
    act_room( \"The very air in the room bursts into flames!\" );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( is_fighting( rch ) ) {
          j = 3d60+150;
          fire_message( rch, j, \"the inferno of fire\" );
          inflict_fire( rch, mob, j, \"Cladewyn\" );
          }
        }
      }
    }
  if( i == 3 ) {
    interpret( mob, \"emote begins singing a celebratory, uplifting chant.\" );
    heal( mob, 100 );
    }
  if( i == 4 ) {
    interpret( mob, \"emote begins singing in a harsh, throaty roar.\" );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( find_stat( rch, level ) < 1d50+10 ) {
          interpret( rch, \"+flee\" );
          }
        }
      }
    }
  if( i == 5 ) {
    interpret( mob, \"emote begins singing a hissing, horrible litany.\" );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( find_stat( rch, wis ) + find_stat( rch, int ) < 1d40+10 ) {
          act_tochar( \"You feel as if your body is covered with insects!  Frantically, you begin removing clothing in order to swat at them.\", rch );
          interpret( rch, \"+remove all\" );
          }
        }
      }
    }
  if( i == 6 ) {
    interpret( mob, \"emote begins to chant a loud, swaying, jerky song.\" );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
