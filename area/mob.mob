"cyclops shaman"
""
"lumbering"
"observe you carefully, preparing to attack."
"Although not quite as large as some of the other cyclops of his clan, this
particular cyclops possesses a rare thing about his race; an aptitude for
magic.  Thus, he serves as his clan's shaman, mostly a position of
superstition and tradition.  His eye has grown dark and sinister, and he looks
to be a quite powerful denizen of evil.
"
"Phule"
""
"Severus"
"attack_weapon( mob, victim, 5d25+20, \"lumbering fist-bludgeon\" );
attack_weapon( mob, victim, 5d25+20, \"lumbering fist-bludgeon\" );
if( random( 0, 1 ) == 0 )
  attack_weapon( mob, victim, 5d25+20, \"lumbering fist-bludgeon\" );
if( random( 0, 6 ) == 1 ) {
  rch = rand_player( room );
  do_spell( slay, mob, rch );
  }
if( has_obj( 1004, mob ) ) {
  obj = has_obj( 1004, mob );
  act_room( \"$N recites $p.\", ch, obj, mob );
  do_spell( mind blade, mob, ch );
  junk_obj( obj, 1 );
  }
if( random( 0, 5 ) < 3 ) {
  act_tochar( #reach, ch );
  act_notchar( #rreach, ch );
  attack( mob, victim, 5d25+40, \"rending\" );
  send_to_room( #echo, room );
  loop( all_in_room ) {
    if( rch != mob )
      attack( mob, rch, 3d25+40, \"landslide pound\" );
    }
  }
attack( mob, victim, 1d100+10, \"leaping pummel\" );
