else {
  attack( mob, victim, 3d9+80, \"ethereal slash\" );
  attack( mob, victim, 3d9+80, \"wispy kick\" );
  attack( mob, victim, 3d9+80, \"rushing strike\" );
  attack( mob, victim, 3d10+90, \"ethereal pierce\" );
  }
if( random( 1, 4 ) == 1 ) {
  i = 8d6+120;
