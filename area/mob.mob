    mpcode( mob, 1 );
    }
  if( random( 0, 9 ) < 4 ) {
    send_to_room( #curse, room );
    do_spell( blind, mob, ch );
} }
attack_shock( mob, victim, 7d5+25, \"electric touch\" );
if( random( 0, 9 ) < 7 )
  attack( mob, victim, 7d5+35, \"vicious blow\" );
