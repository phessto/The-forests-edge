if( attack( mob, victim, 6d52+52, \"terrible bite\" ) ) {
  act_tochar( #sinks, ch, null, mob );
  act_notchar( #sinksin, ch, null, mob );
  j = 50d16+75;
  cold_message( ch, j, \"the bone-chilling bite\" );
  inflict_cold( ch, mob, j, \"the bone-chilling bite of an ice wolf\" );
  }
else {
  if( 1d4 == 2 ) {
    act_notchar( #breath, mob );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( 1d3 != 2 ) {
          j = 30d24+60;
          cold_message( ch, j, \"the intense blast of frost\" );
          inflict_cold( ch, mob, j, \"the breath of an ice wolf\" );
          }
        }
      }
    }
  else {
    attack( mob, victim, 3d16+12, \"raking claw of ice\" );
    attack( mob, victim, 3d16+12, \"raking claw of ice\" );
    }
  }
