""
"peers around, his bow string pulled taut."
"vyan archers"
""
""
"peer around, their bow strings pulled taut."
"Dark and quiet, this vyan archer has learned the extreme patience required of
an archer.  His black pupils peer deliberately into the corners, carefully
scanning for movement.  Flexed arm muscles, ever ready for action, grasp the
bowstring tightly, ready for the arrow's release at the first sign of
trouble.  He grins with an odd smirk of pleasure as he carefully guards his
surroundings.
"
"Soren"
""
""
"if( wearing_obj( 1679, mob ) ) {
  act_room( #arrow, ch );
  attack( mob, ch, 2d20+80, \"arrow\" );
  if( random( 1, 4 ) == 2 ) {
    i = 2d30+40;
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( can_see_char( mob, rch ) ) {
          attack( mob, rch, i, \"volley of arrows\" );
          }
        }
      }
    }
  if( random( 1, 3 ) == 2 ) {
    if( players_room( room ) > 9 ) {
      i = 2d30+140;
      act_tochar( #crowd, ch );
      loop( all_in_room ) {
        if( is_player( rch ) || is_pet( rch ) ) {
          if( can_see_char( mob, rch ) ) {
            dam_message( rch, i, \"A vyan archers burst of arrows\" );
            inflict( rch, mob, i, \"Vyan archer\" );
