"wait( 1 );
if( !ch || !mob )
  continue;
if( !char_in_room( ch, room ) || !can_see_char( mob, ch ) )
  continue;
if( !is_fighting( mob ) ) {
  if( !is_open( room, south ) ) {
    act_tochar( #nobarn, ch );
  } else {
    act_tochar( #barn, ch );
    interpret( mob, \"close door\" );
  }
}
wait( 2 );
if( !mob )
  continue;
if( !char_in_room( ch, room ) )
  end;
if( !has_quest( ch, 7 ) ) {
  act_tochar( #common, ch );
  if( find_stat( ch, level ) > 14 )
    act_tochar( #oklevel, ch );
  else
    act_tochar( #notlevel, ch );
}
