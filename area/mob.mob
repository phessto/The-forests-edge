"i = 1d2000;
if( i == 1 && !is_name( \"muscular\", name( mob, mob ) ) ) {
  do_spell( vitality, mob, null, 10 );
  do_spell( ogre strength, mob, null, 10 );
  do_spell( bless, mob, null, 10 );
  do_spell( holy wrath, mob, mob, 10 );
  if( !is_altered( mob ) )
    set_singular( mob, string( \"muscular $x\", mob ) );
  else
    set_singular( mob, string( \"muscular, $x\", mob ) );
  }
if( i == 2 && !is_name( \"agile\", name( mob, mob ) ) ) {
  do_spell( haste, mob, null, 10 );
  if( !is_altered( mob ) )
    set_singular( mob, string( \"agile $x\", mob ) );
  else
    set_singular( mob, string( \"agile, $x\", mob ) );
  }
if( i == 3 && !is_name( \"scaled\", name( mob, mob ) ) ) {
  do_spell( barkskin, mob, null, 10 );
  do_spell( invulnerability, mob, null, 10 );
  if( !is_altered( mob ) )
    set_singular( mob, string( \"scaled $x\", mob ) );
  else
    set_singular( mob, string( \"scaled, $x\", mob ) );
  }
if( i == 4 && !is_name( \"three-eyed\", name( mob, mob ) ) ) {
  do_spell( detect hidden, mob, null, 10 );
  do_spell( detect invisible, mob, null, 10 );
  if( !is_altered( mob ) )
    set_singular( mob, string( \"three-eyed $x\", mob ) );
  else
    set_singular( mob, string( \"three-eyed, $x\", mob ) );
  }
"
