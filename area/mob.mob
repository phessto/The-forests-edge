  if( !is_silenced( mob ) ) {
    act_tochar( #burn, ch, obj, mob );
    act_notchar( #rburn, ch, obj, mob );
    do_spell( burning hands, mob, ch );
    }
  else
    act_room( #cant, ch, obj, mob );
  }
else if( i == 2 ) {
  attack( mob, victim, 4d6+14, \"sweeping, ethereal claw\" );
  interpret( mob, \"bash\" );
  }
"
