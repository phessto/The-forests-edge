"Brzztae"
""
"dark faerie king"
""
""
"hovers here, a look of burning hatred on his face."
"dark faerie kings"
""
""
"hover here, a look of deja vu on their faces."
"This abnormally large dark faerie stands a full ten inches tall.  His large
muscles look as if they were chiseled from stone as they are perfectly toned.
His snow-white hair is neatly combed back and tied up with a leather strap.
His red eyes glisten like an enormous bonfire and seem to portray a look of
hatred for all those not of his kind.  He stands tall and confident as if his
sense of nobility were enough to make mountains move.
"
"Terek"
""
"Nereus"
"if( wearing_obj( 3234, mob ) ) {
  attack( mob, victim, 5d7+10, \"horrid slash\" );
  attack( mob, victim, 5d7+10, \"wicked slash\" );
  attack( mob, victim, 5d7+12, \"horizontal slice\" );
  if( 1d4 == 1 ) {
    i = 5d7+8;
    ch = rand_player( room );
    if( !ch )
      ch = victim;
    act_tochar( #slash, ch );
    act_notchar( #nslash, ch );
    fire_message( ch, i, \"Brzztae's fiery strike\" );
    inflict_fire( ch, mob, i, \"Brzztae's fiery strike\" );
  }
}
else {
  attack( mob, victim, 5d7+3, \"horrid punch\" );
  attack( mob, victim, 5d7+3, \"wicked punch\" );
  attack( mob, victim, 5d7+5, \"fierce blow\" );
  if( 1d4 == 1 ) {
    i = 5d7+2;
    ch = rand_player( room );
    if( !ch )
      ch = victim;
    act_tochar( #dslash, ch );
    act_notchar( #ndslash, ch );
    dam_message( ch, i, \"Brzztae's violent strike\" );
    inflict( ch, mob, i, \"Brizztae's violent strike\" );
  }
}
if( 1d5 == 1 ) {
  i = 5d7+15;
  act_tochar( #frenzy, ch );
  act_notchar( #nfrenzy, ch );
  dam_message( victim, i, \"Brzztae's frenzied attack\" );
  inflict( victim, mob, i, \"Brzztae's frenzied attack\" );
}
if( 1d3 == 1 ) {
  ch = rand_player( room );
  if( !ch )
    ch = victim;
  act_tochar( #fire, ch );
  act_notchar( #nfire, ch );
  do_spell( faerie fire, mob, ch );
}
"
