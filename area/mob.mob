  if( random( 1, 2 ) == 1 ) {
  ch = rand_player( room );
  attack( mob, ch, 4d5, \"tail thwack\" );
  }
if( i == 1 )
  interpret( mob, \"kick\" );
else if( i == 2 )
  interpret( mob, \"bash\" );
else if( i == 3 )
  interpret( mob, \"em hisses in derision at you!\" );
else if( i == 4 )
  interpret( mob, \"punch\" );
else if( i > 18 ) {
  act_room( #tailsweep, ch, obj, mob );
  attack_room( mob, 4d8+8, \"lighting quick tail sweep\" );
  }
