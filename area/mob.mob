"shaggy"
"are here"
"Were it not for a bent back and shambling gait, this creature would stand a
full head and shoulders taller than an ordinary yeti.  Besides a thicker,
slightly darker coat of fur than an average yeti, this creature appears to be
more simian; its hands are only very crudely prehensile.  Dull yellow canines
like those of a lion protrude from a maw caked black with blood.  A malevolent
glint in the black eyes of this beast reveals a soul as cold as the snow
around you.
"
"Nereus"
""
""
"if( random( 1, 3 ) == 2 ) {
  if( rflag( reset0, room ) ) {
    remove_rflag( reset0, room );
    act_notchar( #collapse, mob );
    acode( room, 2 );
    }
  else {
    obj = obj_in_room( 3620, room );
    if( obj ) {
      act_notchar( #boulder, mob );
      junk_obj( obj, 1 );
      loop( all_in_room ) {
        if( mob != rch ) {
          i = 10d14+22;
          dam_message( rch, i, \"the giant boulder of ice\" );
          inflict( rch, mob, i, \"a tumbling boulder of ice\" );
          obj = wield( rch );
          if( obj ) {
            if( find_stat( ch, dex ) + find_stat( ch, str ) < random( 18, 40 ) ) {
              if( !obj_flag( obj, no_disarm ) && !obj_flag( obj, two_hands ) && size( rch ) < 6 ) {
                act_tochar( #knock, rch );
                act_notchar( #knocks, rch );
                obj_to_char( obj, rch );
                }
              }
            }
          }
        }
      }
    else {
      rch = rand_char( room );
      attack( mob, rch, 7d9+12, \"desperate bite\" );
      }
    }
  }
else {
  attack( mob, ch, 8d8+10, \"snarling bite\" );
  attack( mob, ch, 8d6+16, \"savage punch\" );
  attack( mob, ch, 8d6+16, \"savage punch\" );
  if( random( 1, 3 ) == 2 )
    attack( mob, ch, 10d2+10, \"flailing kick\" );
  }
"
