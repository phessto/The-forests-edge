#2669
"the Howler"
""
"massive blob of flesh"
""
""
"floats nearby, its mucousy maw opening and closing."
"Howler"
""
""
"float nearby, their mucousy maws opening and closing."
"This massive blob of flesh shimmers eerily, its pale grey mass glistening from
light flickering across its slick, secretion-covered surface.  A few tendrils
flail erratically, sprouting absently between hundreds of tiny suckers lining
its body.  Its misshapen wings are dwarfed by its huge maw, which appears to
be able to crane open as large as the whole thing is wide.  It pulses
rhythmically, as if breathing, slowly inflating until it appears it must
burst, and then deflating to its grotesque mass.
"
"Phule"
"desc by groob
"
""
"if( random( 0, 2 ) != 0 ) {
  act_tochar( #dive, victim, null, mob );
  act_notchar( #rdive, victim, null, mob );
  if( attack( mob, victim, 2d19+9, \"open-mawed dive\" ) ) {
    i = 2d3;
    loop( i > 0 ) {
      act_room( #chomp, mob );
      if( attack( mob, victim, i, \"chomp\" ) ) {
        if( random( 1, 10 ) < 7 ) {
          i = 0;
          }
        else {
          i = i - 1;
          }
        j = 2d11+11;
        act_room( #drool, mob );
        acid_message( victim, j, \"the corrosive saliva\" );
        inflict_acid( victim, mob, j, \"The Howler\" );
        }
      else {
        if( random( 1, 10 ) < 8 ) {
          i = 0;
          }
        else {
          i = i - 1;
          }
        }
      }
    }
  }
else {
  act_room(#inhale, mob );
  if( is_silenced( mob ) ) {
    act_room( #wind, mob );
    if( random( 0, 1 ) == 0 ) {
      act_room( #belch, mob );
      loop( all_in_room ) {
        if( rch != mob ) {
          attack_acid( mob, rch, 2d11+9, \"acid belch\" );
          }
        }
      }
    }
  else {
    act_room( #foul, mob );
    loop( all_in_room ) {
      if( can_hear( rch ) ) {
        i = 2d19+11;
        sound_message( rch, i, \"Intense howling\" );
        inflict_sound( rch, mob, i, \"The Howler\" );
        j = i / 10;
        if( j > 10 ) {
          j = 10;
          }
        if( j > 0 ) {
          do_spell( deafen, mob, rch, j );
          }
        }
      }
    }
  }
"
