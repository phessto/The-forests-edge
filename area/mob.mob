"attack_fire( mob, victim, 8d7+10, \"fiery breath\" );
if( random( 1, 5 ) > 3 ) {
  act_tochar( \"The tail whips out and tries to bash you to the ground!\", ch );
  act_notchar( \"The tail whips out and tries to bash $n to the ground!\", ch );
  interpret( mob, \"bash\", victim );
  }
attack( mob, victim, 8d7+10, \"+snapping jaws\" );
if( random( 1, 10 ) > 5 )
  attack( mob, victim, 8d7+10, \"lashing tail\" );
