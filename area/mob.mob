    wait( 1 );
    act_tochar( #enter, ch );
    act_notchar( #nenter, ch );
    transfer( ch, find_room( 36835 ) );
    act_notchar( #narrive, ch );
    modify_move( ch, -3 );
    loop( followers ) {
      act_tochar( #enter, rch );
      act_notchar( #nenter, rch );
      transfer( rch, find_room( 36835 ) );
      modify_move( rch, -3 );
      act_notchar( #narrive, rch );
      }
    act_room( #close, ch );
    close( room, east );
    }
  else {
    junk_obj( obj, 1 );
    wait( 1 );
    act_tochar( #return, ch );
    act_notchar( #nreturn, ch );
    obj_to_char( oload( 4071 ), ch );
    wait( 1 );
    interpret( mob, \"shake\" );
