"A monstrosity forged of ice, crudely carved or shaped by magic from a single,
massive monolith of opaque, blue-white ice.  The golem's outline shimmers
softly and his form is tenuous; at times the mighty limbs of ice become
completely transparent, revealing the icy passageways behind them.  Despite
being twenty feet in height and probably half as wide, the construct does not
seem to leave markings in the soft frost of the ground.  Formed in the shape
of an immensely muscular, impossibly proportioned man, its legs and arms are
as thick as ancient oaks and seem as impregnable to harm.  No scars or
markings of any kind mar the blue-white ice of this artificial creature - it
could have been created hours or eons ago, standing watch over this icy tomb.
"
"Nereus"
""
"Valin"
"if( !rflag( reset0, room ) ) {
  act_notchar( #heals, mob );
  heal( mob, 3d1000+200 );
  if( find_stat( mob, hit ) > 2000 ) {
    dispel_affect( mob, invulnerability );
    dispel_affect( mob, displace );
    dispel_affect( mob, armor );
    dispel_affect( mob, resist shock );
    dispel_affect( mob, resist fire );
    dispel_affect( mob, resist cold );
    dispel_affect( mob, resist acid );
    set_rflag( reset0, room );
    act_notchar( #phasesin, mob );
    }
  }
else {
  if( attack_weapon( mob, victim, 5d100+310, \"ponderous smash\" ) ) {
    if( 1d30 > find_stat( victim, con ) ) {
      act_tochar( #byebye, victim );
      act_notchar( #hedead, victim );
      set_resting( victim );
      set_delay( victim, 100 - ( 2 * find_stat( victim, con ) ) );
      }
    }
  if( 1d3 == 2 ) {
    rch = rand_char( room );
    if( !is_player( rch ) && !is_pet( rch ) )
      rch = rand_player( room );
    if( rch && rch != victim )
      attack_weapon( mob, victim, 4d110+110, \"earth-shattering pound\" );
    }
  if( ( find_stat( mob, hit ) < 2000 ) && 1d3 != 2 ) {
    remove_rflag( reset0, room );
    act_notchar( #phases, mob );
    do_spell( invulnerability, null, mob, 10 );
    do_spell( resist acid, null, mob, 25 );
    do_spell( resist cold, null, mob, 25 );
    do_spell( resist fire, null, mob, 25 );
    do_spell( resist shock, null, mob, 25 );
    do_spell( armor, null, mob, 10 );
    do_spell( displace, null, mob, 10 );
    }
  }
"
