"test"
"if( !is_player( ch ) )
  continue;
if( cflag( 148, ch ) || class( ch ) != bard || find_skill( ch, song of the wind ) == 0 ) {
  interpret( mob, #no );
  end;
  }
obj = wearing_obj( 237, mob );
if( !obj ) {
  interpret( mob, \"say Ask me again later.\" );
  end;
  }
if( obj_value( obj, 1 ) >= 0 ) {
  if( owns( ch, obj ) )
    interpret( mob, \"say Make haste, for time grows short. \" );
  else
    interpret( mob, \"say I am sorry, but someone else is taking the test right now.  I must ask you to return later.\" );
  end;
  }
interpret( mob, #test1 );
wait( 1 );
interpret( mob, #test2 );
wait( 1 );
obj_to_char( oload( 12, 4 ), ch );
act_notchar( \"$N gives $n four copper coins.\", ch, obj, mob );
act_tochar( \"$N gives you four copper coins.\", ch, obj, mob );
wait( 0 );
interpret( mob, \"say Now go.\" );
set_cflag( 147, ch );
obj = set_obj_value( obj, 0, 0 );
obj = set_obj_value( obj, 1, 60 );
obj = set_owner( obj, ch );
obj = set_obj_timer( obj, 60 );
"
