"Xaelon"
""
"apprentice of elemental magic"
""
""
"paces about, looking impatient."
"aprrentice's of elemental magic."
""
""
"pace about, looking impatient."
"Standing probably six feet in height, this heavily cloaked figure is
undeniably a user of magic.  Delicate fingers hang slightly out of his baggy
cloak, probably experiencing little physical labor, but used mainly to channel
spells.  The face is nearly shadowed by a large hood, but what can be seen
appears quite handsome.  He has eyes of deep blue, and very short hair, almost
spikey.  Alongside his ears, two long strands of hair fall to around his neck,
fastened with something to keep them taut.  His face is painted with a nasty
grin, and his demeanor reflects that of a young boy up to no good.
"
"Soren"
""
""
"attack( mob, victim, 10d10+20, \"nasty uppercut\" );
if( is_silenced( mob ) )  {
  if( has_obj( 929, mob ) ) {
    junk_obj( has_obj( 929, mob ) );
    act_room( #quaff, ch );
    do_spell( neutralize, mob, mob );
    act_room( #wrath, ch );
    loop( all_in_room ) {
      if( is_player( rch ) ) {
        j = 10d20+50;
        shock_message( rch, j, \"A blue-white bolt of energy from above\" );
        inflict_shock( rch, mob, j, \"Xaelon\" );
        }
      }
    }
  }
i = random( 1, 12 );
if( i == 1 ) {
  act_room( #acids, ch );
  do_spell( acid storm, mob, ch );
  }
if( i == 2 ) {
  act_room( #ices, ch );
  do_spell( ice storm, mob, ch );
  }
if( i == 3 ) {
  act_room( #chain, ch );
  do_spell( lightning bolt, mob, ch );
  }
if( i == 4 ) {
  act_room( #flame, ch );
  do_spell( fireball, mob, ch );
  }
if( random( 1, 5 ) == 2 ) {
  act_room( #grin, ch );
  act_room( #fire, ch );
  loop( all_in_room ) {
    if( is_player( rch ) )
      do_spell( fireball, mob, rch );
    }
  }
else {
  if( random( 1, 4 ) == 2 ) {
    act_room( #breath, ch );
    loop( all_in_room ) {
      if( is_player( rch ) )
        do_spell( freeze, mob, rch );
      }
    }
  }
"
