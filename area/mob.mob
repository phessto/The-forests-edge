"Hedrack"
"obj = has_obj( 3005, mob );
if( obj ) {
  rch = rand_player( room );
  if( attack( mob, rch, 2d5, \"thrown spear\" ) ) {
act_tochar( #hit, rch );
    obj_to_char( obj, rch );
    } else {
act_tochar( #miss, rch );
act_notchar( #omiss, rch );
  obj_to_room( obj, room );
  }
}
if( wearing_obj( 3006, mob ) ) {
attack( mob, victim, 2d5, \"overhand jab\" );
}
attack_weapon( mob, victim, 1d6+3, \"claw\" );
if( random( 1, 10) < 4 )
attack_weapon( mob, victim, 1d6+3, \"claw\" );
