      act_room( \"@G$p head rears back and breathes out a cone of acid!@n\", mob, obj );
    } if( obj_value( obj, 0 ) == 2 ) {
      act_room( \"@R$p head rears back and breathes out a blast of flame!@n\", mob, obj );
    } if( obj_value( obj, 0 ) == 3 ) {
      act_room( \"@C$p head rears back and breathes out freezing air!@n\", mob, obj );
    } if( obj_value( obj, 0 ) == 4 ) {
      act_room( \"@Y$p head rears back and breathes out a cone of electrical energy!@n\", mob, obj );
    } if( obj_value( obj, 0 ) == 5 ) {
      act_room( \"@M$p head rears back and roars with ear-shattering intensity!@n\", mob, obj );
    }
    loop( all_in_room ) {
      if( rch != mob ) {
        i = 8d16+48;
        if( obj_value( obj, 0 ) == 1 ) {
          acid_message( rch, i, \"The prismatic hydra's acid breath\" );
          inflict_acid( rch, mob, i, \"\" );
        } if( obj_value( obj, 0 ) == 2 ) {
          fire_message( rch, i, \"The prismatic hydra's fiery breath\" );
          inflict_fire( rch, mob, i, \"\" );
        } if( obj_value( obj, 0 ) == 3 ) {
          cold_message( rch, i, \"The prismatic hydra's icy breath\" );
          inflict_cold( rch, mob, i, \"\" );
        } if( obj_value( obj, 0 ) == 4 ) {
          shock_message( rch, i, \"The prismatic hydra's lightning breath\" );
          inflict_shock( rch, mob, i, \"\" );
        } if( obj_value( obj, 0 ) == 5 ) {
          sound_message( rch, i, \"The prismatic hydra's sonic blast\" );
          inflict_sound( rch, mob, i, \"\" );
        }
      }
    }
  }
