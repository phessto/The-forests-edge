""
"Severus"
"if( wearing_obj( 2734, mob ) )
  attack( mob, victim, 6d4+22, \"brutal pound\" );
if( !wearing_obj( 2734, mob ) )
  attack( mob, victim, 2d4+12, \"right hand\" );
attack( mob, victim, 2d4+12, \"left hand\" );
if( random( 1, 10 ) > 7 )
  attack( mob, victim, 2d6+34, \"bite\" );
i = 1d6;
if( i == 4 ) {
  send_to_room( #stal, room );
  act_tochar( #stal2, ch );
  act_notchar( #stal3, ch );
  attack( mob, ch, 5d5+20, \"hurled stalactite\" );
}
if( i == 1 )
  interpret( mob, \"bash\" );
if( i == 5 )
  interpret( mob, \"bellow\" );
if( i == 3 ) {
  if( ( rch = rand_player( room, mob ) ) )
    attack( mob, rch, 2d5+30, \"bite\" );
}
if( i == 2 ) {
  act_room( #roof, ch );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) )
      attack( mob, rch, 5d3+25, \"+crushing rocks\" );
  }
}
"
