""
""
"enormous hand of ice"
""
""
"has burst forth from the frozen floor!"
"enormous hand of ice"
""
""
"have burst forth from the frozen ground!"
"This construction of ice looks as if it were crudely fashioned with chisel and
hammer from a single enormous block of opaque, blue-white ice.  It forms the
shape of a great hand, forearm just below the wrist protruding from the frozen
ground.  It is nearly twenty feet from the tips of its fingers to where it
seamlessly melds with the ice along the ground, each finger as thick as a
man's thigh.  No evidence of battle can be seen across the hand or fingers; it
is almost as if this enormous limb of ice was forged yesterday.
"
"Nereus"
""
""
"victim = null;
loop( all_in_room ) {
  if( is_pet( rch ) || is_player( rch ) ) {
    if( !has_obj( 4312, rch ) )
      victim = rch;
    }
  }
if( rflag( reset1, room ) ) {
  if( attack( mob, victim, 3d100+80, \"brutal slap\" ) ) {
    if( victim ) {
      act_tochar( #grabs, victim, null, mob );
      act_notchar( #grabshim, victim, null, mob );
      obj_to_char( oload( 4312, 1 ), victim );
      remove_rflag( reset1, room );
      }
    }
  else {
    attack( mob, victim, 3d80+80, \"ponderous smash\" );
    }
  }
else {
  if( rflag( reset2, room ) ) {
    if( victim ) {
      if( !has_obj( 4312, victim ) ) {
        if( attack( mob, victim, 3d100+80, \"brutal grasp\" ) ) {
          if( victim ) {
            remove_rflag( reset2, room );
            act_tochar( #grabs, victim, null, mob );
            act_notchar( #grabshim, victim, null, mob );
            obj_to_char( oload( 4312, 1 ), victim );
            }
          }
        }
      }
    }
  else {
    if( victim ) {
      attack( mob, victim, 3d80+80, \"ponderous smash\" );
      }
    }
  }
loop( all_in_room ) {
  if( has_obj( 4312, rch ) ) {
    if( 1d3 == 1 && find_stat( rch, str ) > 1d60 ) {
      act_tochar( #pry, rch, null, mob );
      act_notchar( #pries, rch, null, mob );
      junk_obj( has_obj( 4312, rch ) );
      if( !rflag( reset2, room ) )
        set_rflag( reset2, room );
      else
        set_rflag( reset1, room );
      }
    else {
      act_tochar( #crrush, rch, null, mob );
      act_notchar( #crrushes, rch, null, mob );
      i = 4d40+165;
      dam_message( rch, i, \"the brutal grasp of a hand of ice\" );
      inflict( rch, mob, i, \"an enormous hand of ice\" );
      if( rch ) {
        set_delay( rch, 48 );
        set_resting( rch );
        }
      else
        acode( find_room( 33751 ), 3 );
      }
    }
  }
"
