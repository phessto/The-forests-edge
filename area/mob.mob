    attack_fire( mob, rch, 10d5+50, \"ring of flame surrounding you\" );
  }
attack_fire( mob, ch, 20d3+50, \"thrown spear of fire\" );
if( random( 0, 1 ) == 0 )
  attack_fire( mob, ch, 20d3+50, \"thrown spear of fire\" );
