    attack_fire( mob, rch, 5d5+5, \"spray of molten glass\" );
    }
  }
else if( i > 8 ) 
  if( !is_silenced( mob ) ) {
  act_room( #roar, ch, obj, mob );
  summon( mob, victim );
  }
else
  act_room( #cant, ch, obj, mob );
