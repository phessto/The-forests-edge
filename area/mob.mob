""
"acolyte of Temohpab"
""
""
"stands here as if the eyes of his dark lord."
"acolytes of Temohpab"
""
""
"stand here, surveying the area."
"Before you is a human male in his early twenties.  Very little stands out
about this man, his height is just under six feet tall, his weight just
under one hundred and fifty pounds.  His brown hair, though slightly
unruly lies only to a length halfway down his neck, showing some signs of
having been cut recently.  Pale hazel eyes stare out from a slightly
round face, accentuated only by the slight dark rings that are evident
just above his cheeckbones.
"
"Soren"
""
"Nereus"
"if( random( 1, 3 ) == 1 ) {
  loop( all_in_room ) {
    if( is_player( rch ) )
      if( rch != mob ) {
      act_tochar( #killall, ch );
      do_spell( cause critical, mob, rch );
      }
    }
  }
if( wearing_obj( 706, mob ) || wearing_obj( 3579, mob ) ) {
  if( random( 1, 4 ) == 2 ) {
    i = 4d25+100;
    act_room( #touch, ch );
    act_tochar( #touch1, ch );
    act_notchar( #touch2, ch );
    dam_message( ch, i, \"the sinful touch\" );
    inflict( ch, mob, i, \"acolyte of Temophab\" );
    }
  }
if( random( 1, 4 ) == 2 ) {
  act_room( #wicked, ch );
  do_spell( cure critical, mob, mob );
  }
if( wearing_obj( 706, mob ) || wearing_obj( 3579, mob ) )
  attack( mob, ch, 2d30+80, \"double-handed full length swing\" );
if( !wearing_obj( 706, mob ) ) {
  if( !wearing_obj( 3579, mob ) ) {
    if( random( 1, 4 ) == 2 ) {
      i = 100;
      act_room( #touch3, ch );
      act_tochar( #touch4, ch );
      act_notchar( #touch5, ch );
      dam_message( ch, i, \"the sinful touch\" );
      inflict( ch, mob, i, \"acolyte of Temophab\" );
