"if( !can_see_char( mob, ch ) )
  continue;
i = find_stat( ch, align ) % 3;
if( i == 2 ) {
  act_tochar( #greet, ch );
  do_spell( holy wrath, null, ch );
  end;
  }
if( i == 0 ) {
  act_tochar( #curse, ch );
  do_spell( curse, mob, ch );
  }
if( i == 1 ) {
  act_tochar( #choose, ch );
  do_spell( curse, mob, ch );
  }
attack( mob, ch, 3d20+20, \"rolling wave of evil\" );
set_victim( mob, ch );
