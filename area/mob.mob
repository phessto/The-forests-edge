""
"puffy white"
"is here"
"cloud elemental guardians"
""
""
"quietly stand guard on the small path."
"A walking cloud reaching twelve foot tall and partially melded with the cloudy
surface stands here in a slightly guarded posture.  Roughly humanoid shape,
this creature is without a doubt a manifestation of the arcane arts.  It's
entire body seems capable of melding with the clouds surface, as its feet and
legs constantly do.  Two small orbs of sun-fire mimic eyes for this unusual
creature; other than these it has no noticeable hints of humanity.
"
"Soren"
""
""
"mob = mob_in_room( 1227, room );
attack( mob, ch, 2d5+120, \"wispy fist\" );
attack( mob, ch, 2d5+120, \"wispy fist\" );
if( random( 1, 3 ) == 2 ) {
  act_tochar( #shoulder, ch );
  act_notchar( #shoulder2, ch );
  interpret( mob, \"bash\" );
  if( is_resting( victim ) ) {
    act_tochar( #stomp, ch );
    act_notchar( #stomp2, ch );
    attack( mob, ch, 2d10+180, \"slightly corporeal stomp\" );
    }
  if( !is_resting( victim ) ) {
    if( !is_resting( mob ) ) {
      act_tochar( #fist, ch );
      act_notchar( #fist2, ch );
      attack( mob, ch, 2d5+120, \"close-quartered fist\" );
      }
    }
  if( is_resting( mob ) ) {
    act_room( #rumble, ch );
    loop( all_in_room ) {
      j = 2d4+200;
      if( race( rch ) != elemental ) {
        if( race( rch ) != angel ) {
          dam_message( rch, j, \"the violent rumbling\" );
          inflict( rch, mob, j, \"a cloud elemental\" );
          }
        }
      }
    }
  }
if( random( 1, 4 ) == 3 ) {
  rch = rand_player( room );
  act_tochar( #move, rch );
  act_notchar( #move2, rch );
  attack( mob, rch, 2d25+250, \"waiting elbow\" );
  }
"
