"Olah"
"if( random( 1, 3 ) == 3 ) {
  summon( mob, victim );
  act_room( #aid, ch );
  }
attack( mob, victim, 3d30+50, \"powerful strike\" );
attack( mob, victim, 3d50+50, \"smiting blow\" );
attack( mob, victim, 6d20+50, \"wrathful strike\" );
attack( mob, victim, 4d30+50, \"furious smite\" );
i = 1d5;
if( i == 1 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_tochar( #slay, ch );
    act_notchar( #nslay, ch );
    do_spell( slay, mob, victim, 10 );
    }
  }
if( i == 3 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_tochar( #bolt, ch );
    act_notchar( #nbolt, ch );
    j = 5d50+70;
    shock_message( victim, j, \"The titan king's bolt of lightning\" );
    inflict_shock( victim, mob, j, \"A titan king's bolt of lightning\" );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 8 ) {
          j = 5d60+100;
          act_tochar( #bolt, rch );
          act_notchar( #nbolt, rch );
          shock_message( rch, j, \"The titan king's bolt of lightning\" );
          inflict_shock( rch, mob, j, \"A titan king's bolt of lightning\" );
          }
        }
      }
    }
  }
if( random( 1, 6 ) == 6 ) {
  act_tochar( #hurl, ch );
  act_notchar( #nhurl, ch );
  set_resting( victim );
  }
attack( mob, victim, 5d25+35, \"furious punch\" );
if( random( 1, 9 ) < 8 ) {
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( random( 1, 9 ) < 8 )
        attack( mob, rch, 3d50+50, \"tornado punch\" );
      }
    }
  }
attack( mob, victim, 4d40+35, \"powerful kick\" );
if( random( 1, 9 ) < 8 )
  attack( mob, victim, 4d40+55, \"thunderous kick\" );
if( i == 5 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
  else {
    act_room( #heal, ch );
    do_spell( restoration, mob, mob, 10 );
    }
  }
