if( i == 1 ) {
  act_room( #buffet, ch, obj, mob );
  act_tochar( #down, ch, obj, mob );
  act_notchar( #rdown, ch, obj, mob );
  attack( mob, victim, 6d4+4, \"+gusts of buffeted wind\" );
  loop( followers ) {
