"m = find_stat( mob, hit );
j = 7;
k = find_stat( mob, max_hit ) / ( j - 2 );
n = j;
loop( n > 0 ) {
  if( m < k*n ) {
    if( !has_obj( 3685+j-n, mob ) ) {
      obj = obj_to_char( oload( 3685+j-n ), mob );
      act_room( #grow, mob, obj, mob );
      mpcode( mob, 3 );
      }
    obj = has_obj( 3685+j-n, mob );
    mpcode( mob, 2 );
    }
  n = n - 1;
  }
"
E
"grow"
"@rFrom a wound along one of the hydra's necks, $p head springs forth!@n
