"Fildon"
""
"stick-thin man with a thin, waxed moustache"
""
""
"watches you from the shadows."
"[BUG]"
""
""
"- Contact an immortal!"
"This man is angular and gaunt, with bones protruding at all angles.  Despite
the uncoordinated appearance of a single glance, the man's motions are fluid
and silent.  His black hair has been clipped short and slicked back with oil. 
His facial hair has been trimmed short as well, a thin moustache coated with
wax and twisted to a needle point on each side of his nose.  Short in stature
and not muscularly exceptional, he appears to be either of noble blood or he
wishes that he was - his clothes are elaborate, clean, and well-maintained.
"
"Nereus"
""
"Nereus"
"interpret( mob, \"wear dagger\" );
interpret( mob, \"wear stiletto\" );
interpret( mob, \"wear poniard\" );
attack_backstab( mob, victim );
obj = has_obj( 4363, mob );
if( obj && find_stat( mob, hit ) < 1100 ) {
  act_notchar( #quaff, mob, obj, null );
  junk_obj( has_obj( 4363, mob ) );
  heal( mob, 600 );
  }
obj = has_obj( 1531, mob );
if( obj )
  interpret( mob, \"quaff swirling.potion\" );
attack_weapon( mob, victim, 3d3+1, \"swift punch\" );
attack_weapon( mob, victim, 3d3+1, \"lightning-fast punch\" );
attack_weapon( mob, victim, 3d6+1, \"sharp knee\" );
attack_weapon( mob, victim, 3d3+1, \"elbow swipe\" );
attack_weapon( mob, victim, 3d5+2, \"hand chop\" );
attack_offhand( mob, victim, 5d2+12, \"swift punch\" );
attack_offhand( mob, victim, 5d2+12, \"sharp punch\" );
if( 1d2 == 2 )
  attack_offhand( mob, victim, 5d2+12, \"tumbling punch\" );
if( 1d3 != 2 )
  attack_weapon( mob, victim, 4d3+3, \"fast punch\" );
if( 1d2 == 2 )
  attack_weapon( mob, victim, 4d4+1, \"acrobatic kick\" );
i = 0;
obj = has_obj( 4387, mob );
if( 1d2 == 1 && obj ) {
  loop( all_in_room ) {
    if( is_player( rch ) ) {
      if( class( rch ) == mage || class( rch ) == cleric || class( rch ) == paladin ) {
        if( !is_silenced( rch ) && i == 0 ) {
          i = 1;
          act_tochar( #hurl, rch, obj, mob );
          act_notchar( #hur, rch, obj, mob );
          if( 1d50 > find_stat( rch, dex ) ) {
            junk_obj( obj, 1 );
            act_tochar( #wound, rch );
            act_notchar( #wounds, rch );
            j = 12d15+73;
            dam_message( rch, j, \"the thrown dagger\" );
            inflict( rch, mob, j, \"Fildon's hurled dagger\" );
            do_spell( silence, mob, rch, 15 );
            }
          else {
            act_tochar( #dodge, rch );
            act_notchar( #dodges, rch );
            obj_to_room( obj, room );
            }
          }
        }
      }
    }
  }
obj = has_obj( 2294, mob );
if( i == 0 && obj ) {
  rch = rand_player( room, mob );
  if( rch ) {
    act_tochar( #hurl2, rch, obj, mob );
    act_notchar( #hurls2, rch, obj, mob );
    attack_acid( mob, rch, 3d300, \"the shattered globe of acid\" );
    junk_obj( obj, 1 );
    }
  }
