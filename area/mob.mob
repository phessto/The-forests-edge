  act_tochar( #ch, ch );
  act_notchar( #not, ch );
  i = 5d10+10;
  dam_message( ch, i, \"the antlion's crushing mandibles' embrace\" );
  inflict( ch, mob, i, \"the antlion's crushing mandibles\" );
  }
else {
  if( random( 1, 10) == 1 ) {
    act_tochar( #ch2, ch );
    act_notchar( #not2, ch );
    i = 6d10+20;
