"are here"
"This huge bear, once fearsome, is now an empty shell.  Lifeless, shrunken eyes
stare from it's head, and it's fur is musty and dull.  Yellowed and cracked
teeth protrude from the once powerful jaws of this poor beast, yet they still
appear to be capable of tearing most animals to pieces.  This male bear's
claws are equally deadly weapons still; they stretch perhaps eight inches from
their tip to the creature's emaciated paws.
"
"Tsukurite"
""
"Nereus"
"if( 1d6 == 1 )
  interpret( mob, \"emote roars in rage, foam flying from his mouth!\" );
i = 0;
if( attack( mob, victim, 7d11+21, \"savage clawing\" ) )
  i = i + 1;
if( attack( mob, victim, 7d11+21, \"savage clawing\" ) )
  i = i + 1;
if( 1d5 == 2 ) {
  rch = rand_char( room );
  if( rch == mob )
    rch = rand_player( room );
  if( rch ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      act_tochar( #charge, rch );
      act_notchar( #charges, rch );
      if( attack( mob, rch, 6d20+35, \"unstoppable charge\" ) ) {
        if( rch && mob ) {
          if( size( rch ) <= size( mob ) ) {
            if( find_stat( rch, dex ) < random( 4, 20 ) ) {
              if( is_standing( rch ) ) {
                act_tochar( #knock, rch );
                act_notchar( #knockshim, rch );
                set_resting( rch );
                set_delay( rch, 52 - find_stat( rch, dex ) );
              }
            }
          }
        }
      }
    }
  }
}
"
