"if( !cflag( 147, ch ) )
  continue;
rch = mob_in_room( 286, find_room( 24048 ) );
if( !rch )
  continue;
obj = wearing_obj( 237, rch );
if( !obj || !owns( ch, obj ) )
  continue;
if( obj_value( obj, 1 ) < 0 ) {
  interpret( mob \"say It would seem your time has expired.\" );
  remove_cflag( 147, ch );
  end;
  }
i = obj_value( obj, 0 );
if( i%16 < 8 ) {
  set_obj_value( obj, 0, i+8 );
  interpret( mob, \"say Very well, go on your way.\" );
  }
else {
  interpret( mob, \"say I have no need of this.\" );
  interpret( mob, \"drop copper.coin\" );
  }
"
