attack( mob, victim, 4d40+25, \"powerful kick\" );
if( random( 1, 9 ) < 8 )
  attack( mob, victim, 4d40+45, \"thunderous kick\" );
if( i == 5 ) {
  if( is_silenced( mob ) )
    act_room( #silence, ch );
