  attack( mob, ch, 2d25, \"short legged kick\" );
  act_tochar( #punch, ch );
  act_notchar( #punch2, ch );
  attack_weapon( mob, ch, 2d10+30, \"shaft punch\" );
  }
if( random( 1, 10 ) == 2 ) {
  act_room( #area, ch );
  loop( all_in_room ) {
    if( random( 1, 3 ) >= 2 ) {
