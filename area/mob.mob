"Tireese"
""
"priestess of Morkith"
""
""
"revels in her duties to her dark lord."
"priestess' of Morkith"
""
""
"revel in their duty to their dark lord."
"Dark shadows seem to follow this young woman around as she moves, a
perceptible evil.  A tight black robe accentuates her athletic form,
destorying any doubts in your mind as to how well she can use the scourge
hanging from her belt.  Pure black, slightly curly hair flows over her
shoulders, held back tight in a pony tail.  Cold, dark brown eyes stare out at
you set just above her pale, slightly pastey cheecks.  Her skin is the color
of pure ivory, simple proof that she rarely spends time outside of the temple.
"
"Soren"
""
"Olah"
"if( wearing_obj( 3557, mob ) ) {
  attack( mob, ch, 5d9+50, \"slicing whip\" );
  attack( mob, ch, 5d9+50, \"slicing whip\" );
  if( random( 1, 4 ) == 3 ) {
    if( attack( mob, ch, 4d20+20, \"slashing whip\" ) ) {
      act_tochar( #choke, ch );
      act_notchar( #choke2, ch );
      j = 5d5+50;
      dam_message( ch, j, \"the strangulating whip\" );
      inflict( ch, mob, j, \"Tireese\" );
      act_room( #snap, ch );
      act_notchar( #gasp, ch );
    }
  }
}
if( !wearing_obj( 3557, mob ) ) {
  attack( mob, ch, 5d5+25, \"slap\" );
  do_spell( cause serious, mob, ch );
}
if( random( 1, 4 ) == 2 ) {
  act_room( #pray, ch );
  do_spell( cure critical, mob, mob );
}
if( random( 1, 2 ) == 1  )
  attack( mob, ch, 5d5+70, \"quick stepped kick\" );
if( random( 1, 10 ) >= 5 ) {
  ch = rand_char( room );
  if( is_player( ch ) ) {
    if( find_stat( ch, level ) < 38 ) {
      act_tochar( #gone, ch );
      act_notchar( #gone2, ch );
      do_spell( harm, mob, ch );
      transfer( ch, find_room( 17331 ) );
    }
  }
}
if( random( 1, 5 ) == 2 ) {
  act_room( #murmur, ch );
  act_room( #grow, ch );
  loop( all_in_room ) {
    if( rch != mob ) {
      j = 9d12;
      dam_message( rch, j, \"The pulsating shiver\" );
      inflict( rch, mob, j, \"Tireese\" );
    }
  }
  act_room( #boom, ch );
  loop( all_in_room ) {
    if( rch != mob ) {
      dam_message( rch, j, \"The explosion of darkness\" );
      inflict( rch, mob, j, \"Tireese\" );
    }
  }
}
