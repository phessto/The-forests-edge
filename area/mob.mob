"if( !is_player( ch ) )
  continue;
if( cflag( 147, ch ) && !cflag( 148, ch ) ) {
  obj = wearing_obj( 237, mob );
  if( !obj || !owns( ch, obj ) ) {
    end;
    }
  if( obj_value( obj, 1 ) >= 0 ) {
    if( obj_value( obj, 0 ) != 15 ) {
      interpret( mob, \"say You have not yet delivered all four coins.\" );
      end;
      }
    set_cflag( 148, ch );
    interpret( mob, \"say You have completed the quest in the time alotted.  I will now freely share my knowledge with you.\" );
    obj = set_obj_value( obj, 1, -1 );
    obj = set_obj_timer( obj, 0 );
    obj = set_owner( obj, mob );
    }
  }
"
