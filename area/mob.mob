    rch = rand_char( room );
    if( rch != mob ) {
      act_tochar( #lash, rch );
      act_notchar( #lash2, rch );
      attack( mob, rch, 2d25+75, \"hammer smash\" );
      }
    }
  }
if( !wearing_obj( 3020, mob ) ) {
  attack( mob, ch, 2d25, \"flailing punch\" );
  interpret( mob, \"wear hammer\" );
  }
if( random( 1, 2 ) == 1 ) {
  j = 2d60;
  act_tochar( #fling, ch );
  act_notchar( #fling2, ch );
  dam_message( ch, j, \"the dark opal stone\" );
  inflict( ch, mob, j, \"Jushan\" );
obj_to_room( oload( 4842 ), room );
