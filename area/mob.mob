    act_tochar( #wail, ch );
    attack_sound( mob, ch, 3d20+20, \"piercing wail\" );
    }
  }
if( i == 3 ) {
  act_notchar( #o-bolt, victim );
  act_tochar( #bolt, victim );
  do_spell( lightning bolt, mob, victim );
  }
if( i == 2 ) {
  j = random( -60, -18 );
  loop( all_in_room ) {
    if( is_player( rch ) ) {
      act_tochar( #suck, rch );
      modify_mana( rch, j );
      heal( mob, dice( 5, 4 ) );
      }
    }
  }
