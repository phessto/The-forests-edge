"Den'tiren"
""
"vyan sorcerer, chosen of Morkith"
""
""
"is here, studying from an ancient tome."
"vyan sorcerers, chosen of Morkith"
""
""
"are here, destroying the laws of physics."
"Standing before you is a tall, yet frail-looking vyan male.  He has an air of
superiority around him, dressed as he is in completly wrinkle-free, clean
clothes.  His hair is a dull grey worn long down to the middle of his back,
the only real color coming from the tips of his ebony ears peeking out.  His
eyes are the color of a morning sky, pale blue with small flecks of red
evident just outside of the pupil.  Standing at a height of almost six feet
tall, he does set forth the image of a learned man.
"
"Soren"
""
"Severus"
"attack( mob, ch, 10d5+3, \"punch\" );
if( is_silenced( mob ) ) {
  if( ( obj = has_obj( 929, mob ) ) ) {
    junk_obj( obj, 1 );
    act_room( #quaff, ch );
    do_spell( neutralize, mob );
    act_room( #wrath, ch );
    loop( all_in_room ) {
      if( is_player( rch ) ) {
        j = 2d250+50;
        fire_message( rch, j, \"Den'tiren's piercing gaze of fire\" );
        inflict_fire( rch, mob, j, \"Den'tiren's piercing gaze of fire\" );
      }
    }
  }
}
if( !is_silenced( mob ) ) {
  act_room( #murmur, ch );
  if( random( 1, 2 ) == 2 ) {
    do_spell( prismic missile, mob, ch );
    do_spell( acid storm, mob, ch );
    if( random( 1, 3 ) == 2 )
      do_spell( prismic missile, mob, ch );
    if( random( 1, 4 ) == 2 ) {
      rch = rand_player( room );
      if( rch ) {
        if( class( rch ) == cleric ) {
          act_tochar( #notalk, ch );
          act_notchar( #notalk2, ch );
          do_spell( silence, mob, ch );
          do_spell( lightning bolt, mob, ch );
        }
        if( class( rch ) == mage ) {
          act_tochar( #notalk, ch );
          act_notchar( #notalk2, ch );
          do_spell( silence, mob, ch );
          do_spell( lightning bolt, mob, ch );
        }
        if( class( rch ) == monk ) {
          act_tochar( #slomo, ch );
          act_notchar( #slomo2, ch );
          do_spell( slow, mob, ch );
          do_spell( sleep, mob, ch );
        }
        if( class( rch ) == warrior ) {
          act_tochar( #scared, ch );
          act_notchar( #scared2, ch );
          do_spell( fear, mob, ch );
          do_spell( blind, mob, ch );
        }
        if( class( rch ) == paladin ) {
          act_tochar( #noholy, ch );
          act_notchar( #noholy2, ch );
          do_spell( silence, mob, ch );
          do_spell( slow, mob, ch );
        }
        if( class( rch ) == ranger ) {
          act_tochar( #notalk, ch );
          act_notchar( #notalk2, ch );
          do_spell( silence, mob, ch );
          do_spell( fireball, mob, ch );
        }
      }
    }
    if( random( 1, 7 ) == 6 ) {
      j = 2d40+40;
      act_room( #sweep, ch );
      act_room( #sweep2, ch );
      loop( all_in_room ) {
        if( is_player( rch ) ) {
          fire_message( rch, j, \"The roiling wave of flames\" );
          inflict_fire( rch, mob, j, \"Den'tiren's wave of fire\" );
        }
      }
    }
  }
  if( 0 )
    if( random( 1, 8 ) == 7 ) {
    if( !mob_in_room( 2393, room ) ) {
      send_to_room( #zapzap, room );
      mload( 2393, room );
      send_to_room( #arrive, room );
    }
  }
  if( random( 1, 3 ) == 2 ) {
    j = 2d100+50;
    rch = rand_char( room );
    if( is_player( rch ) ) {
      act_tochar( #boltgrab, rch );
      act_notchar( #boltgrab1, rch );
      shock_message( rch, j, \"Den'tiren's electric choke\" );
      inflict_shock( rch, mob, j, \"Den'tirens's electric choke\" );
    }
  }
}
