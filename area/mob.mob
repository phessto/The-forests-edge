    do_spell( burning hands, mob, victim );
    end;
    }
  if( i > 15 )
    if( !is_silenced( mob ) ) {
    act_room( #cure, ch );
    do_spell( cure serious, mob, mob );
    end;
    }
  else
    act_room( #cant, ch, obj, mob );
  else {
    if( !is_resting( mob ) ) {
      act_tochar( #fire, ch );
      act_notchar( #rfire, ch );
      do_spell( fireball, mob, victim );
      }
    }
  }
