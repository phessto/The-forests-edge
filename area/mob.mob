  if( random( 1, 4 ) == 2 ) {
    i = 15d10;
    act_room( #crimson, ch );
    act_room( #arrow2, ch );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( can_see_char( mob, rch ) ) {
          fire_message( rch, i, \"The exploding crimson arrow\" );
          inflict_fire( rch, mob, i, \"A goblin archer\" );
          }
        }
      }
    }
  attack( mob, ch, 2d10+40, \"swing\" );
  if( random( 1, 3 ) == 2 ) {
    act_room( #fast, ch );
    attack( mob, ch, 10d10+75, \"arrow\" );
    }
  attack( mob, ch, 2d10+40, \"punch\" );
  }
else {
  attack( mob, ch, 2d10+40, \"swing\" );
  attack( mob, ch, 2d10+40, \"swing\" );
  i = random( 1, 3 );
  if( i == 1 )
    interpret( mob, \"bash\", ch );
  if( i == 2 )
    attack( mob, ch, 5d10+75, \"brutal kick\" );
  }
