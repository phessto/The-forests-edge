""
"crystalline"
"stand here proudly."
"This horse appears to have been chiseled from a block of purely smooth, clear
ice.  While the creature is as clear as glass, the curves of its body have
been crudely faceted, causing the light to dance through the icy stallion and
across the walls of the icy crypt.  Despite the appearance of ice, the horse
moves fluidly; its mane and tail move as if softly blown by a breeze and
his flanks rise and fall in time with its frosty breath.
"
"Nereus"
""
"Severus"
"if( random( 2, 4 ) == 3 ) {
  rch = rand_player( room );
  act_tochar( #kick, rch );
  act_notchar( #kicks, rch );
  if( attack( mob, rch, 6d10+20, \"charging blow\" ) ) {
    if( size( rch ) <= size( mob ) ) {
      if( find_stat( rch, dex ) < random( 10, 25 ) ) {
        act_tochar( #knocks, rch );
        act_notchar( #knockshim, rch );
        if( is_mounted( rch ) )
          dismount( rch );
        set_resting( rch );
        set_delay( rch, 52 - find_stat( rch, dex ) );
      }
    }
  }
}
attack( mob, victim, 5d8+19, \"powerful kick\" );
attack( mob, victim, 5d8+19, \"powerful kick\" );
attack( mob, victim, 4d10+12, \"powerful kick\" );
if( attack( mob, victim, 5d6+30, \"frosty bite\" ) ) {
  i = 4d10+50;
  cold_message( victim, i, \"the chilling bite\" );
  inflict_cold( victim, mob, i, \"the chilling bite\" );
}
"
