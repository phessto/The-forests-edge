"if( mob_in_room( 2393, find_room( 17317 ) ) ) {
  mob = mob_in_room( 2393, room );
  ch = rand_char( find_room( 17317 ) );
  act_room( #mad, ch );
  act_room( #bolt, ch );
  loop( all_in_room ) {
    if( is_player( rch ) ) {
      if( random( 1,10 ) >= 2 )
        do_spell( lightning bolt, mob, rch );
      else
        do_spell( chain lightning, mob, rch );
    }
  }
}
mob = mob_in_room( 2378, room );
if( ( obj = wearing_obj( 3556, mob ) ) || ( obj = has_obj( 3556, mob ) ) ) {
  if( random( 1, 10 ) <= 9 ) {
    act_room( #break, ch );
    junk_obj( obj, 1 );
    obj = oload( 3600 );
    obj_to_char( obj, mob );
  }
}
