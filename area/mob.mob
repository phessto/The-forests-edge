""
""
"wooly mammoth"
""
"shaggy"
"shambles across the wintry plateau."
"wooly mammoths"
""
"shaggy"
"form an imposing pack on the wintry plateau."
"Standing over nine feet at the shoulder, this enormous creature is the largest
of the northern wastes.  Resembling a slightly smaller elephant covered in
coarse, deep brown hair, the mammoth has a thick layer of fat for insulation
from the elements.  A hump of fat behind the mammoth's head also appears to
serve much the same purpose as a camel's hump.  A flexible, versatile trunk
extends down to the ground, winding between two enormous, curved tusks.
"
"Nereus"
""
"Nereus"
"attack( mob, victim, 4d20+20, \"slashing tusk\" );
attack( mob, victim, 4d20+20, \"slashing tusk\" );
attack( mob, victim, 12d12+30, \"bone-crushing stomp\" );
if( 1d2 == 1 )
  attack( mob, victim, 12d12+30, \"bone-crushing stomp\" );
if( 1d4 == 2 ) {
  act_notchar( #blast, mob );
  act_area( #trumpeting, mob );
  loop( all_in_room ) {
    if( is_player( rch ) || is_pet( rch ) ) {
      if( 1d2 == 1 ) {
        act_tochar( #trample, rch );
        act_notchar( #trampled, rch );
        i = 16d12+55;
        dam_message( rch, i, \"the trampling charge of the mammoth\" );
        inflict( rch, mob, i, \"a wooly mammoth\" );
        if( rch ) {
          if( find_stat( rch, dex ) < 1d20+12 && size( rch ) <= size( mob ) ) {
            if( is_standing( rch ) ) {
              set_resting( rch );
              set_delay( rch, 50 - find_stat( rch, dex ) );
              }
            }
          }
        else
          act_tochar( #manage, rch );
        }
      else {
        act_tochar( #leap, rch );
        }
      }
    }
  }
"
