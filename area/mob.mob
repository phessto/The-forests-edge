""
"gape at you with unseeing eyes."
"The cave shrieker is a pale lump of flesh with no eyes, only a gaping,
toothless maw which covers the entire top half of the blob.  About the size of
a dog, this disgusting parasite clings to cave walls and lurks, waiting to
drop down upon unsuspecting prey.  Its body is covered with tiny suckers which
allow it to attach itself to sheer rock, and a pair of scaly, vestigial wings
sprout at odd angles.
"
"Phule"
""
""
"if( is_silenced( mob ) ) {
  act_room( \"$n attempts to shriek, but no sound is heard!\", mob );
  }
else {
  if( can_hear( victim ) ) {
    attack_sound( mob, victim, 3d13+3, \"piercing shriek\" );
    }
  else {
    act_tochar( \"$N shrieks, but you cannot hear $S cries.\", victim, null, mob );
    act_notchar( \"$N shrieks, but $n cannot hear $S cries.\", victim, null, mob );
    }
  }
if( random( 0, 1 ) == 0 ) {
  if( is_silenced( mob ) ) {
    act_room( \"$n attempts to wail, but no sound is heard!\", mob );
    }
  else {
    act_room( \"$n opens $s mouth and begins to wail!\", mob );
    loop( all_in_room ) {
      if( can_hear( rch ) ) {
        attack_sound( mob, rch, 3d9+3, \"ear-splitting wail\" );
        }
      else {
        if( vnum( rch ) == 2346 ) {
          if( is_silenced( rch ) ) {
            do_spell( neutralize, mob, rch, 1d5+1 );
            }
          }
        }
      }
    }
  }
else if( random( 0, 1 ) == 1 ) {
  act_room( \"$n opens $s maw and spits a glob of acid!\", mob );
  attack_acid( mob, victim, 3d11+3, \"acid spray\" );
  }
"
