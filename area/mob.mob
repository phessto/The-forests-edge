if( cflag( 43, ch ) ) {
  act_tochar( #atone3, ch );
  end;
  }
if( cflag( 44, ch ) ) {
  act_tochar( #atone4, ch );
  end;
  }
if( cflag( 40, ch ) ) {
  act_tochar( #meanie, ch );
  wait( 2 );
  act_tochar( #meanie2, ch );
  wait( 5 );
  i = random( 1, 4 );
  if( i == 1 ) {
    act_tochar( #atone1, ch );
    set_cflag( 41, ch );
    }
  if( i == 2 ) {
    act_tochar( #atone2, ch );
    set_cflag( 42, ch );
    }
  if( i == 3 ) {
    act_tochar( #atone3, ch );
    set_cflag( 43, ch );
