"obj = obj_in_room( 3674, room );
if( obj ) {
  act_room( #eat, ch, obj, mob );
  junk_obj( obj, 1 );
  remove_rflag( reset2, room );
  act_room( #blood, mob );
  }
if( rflag( reset2, room ) ) {
  loop( all_in_room ) {
    if( find_stat( rch, hit ) < find_stat( rch, max_hit ) - 10 )
      remove_rflag( reset2, room );
    }
  if( !rflag( reset2, room ) )
    act_room( #blood, mob );
  }
if( rflag( reset2, room ) ) {
  i = 1d6-1;
  if( attack( mob, victim, i, \"tiny bite\" ) && i > 4 ) {
    act_room( #blood, mob );
    remove_rflag( reset2, room );
  } }
if( !rflag( reset2, room ) ) {
  i = 0;
  loop( i < 2d4 ) {
    i = i + 1;
    attack( mob, victim, 3d5, \"frenzied bite\" );
  } }
"
