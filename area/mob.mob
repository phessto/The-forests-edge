""
"hulking"
"searches for things to devour."
"major bulettes"
""
"hulking"
"search for things to devour."
"Much larger than most others of its kind, this massive creature resembles a
huge snapping turtle crossed with a great white shark with legs.  It stands
about fifteen feet tall and twice as long from head to tip.  Its head is
shaped like a crab's claw and thickly plated.  The major bulette peers out
from narrow, yellow eyes with blue-green pupils and brown-black sclera. 
Protecting its body is a durable, scaly shell which is a blue-green color that
is almost sleek and reflective.  Strong, stumpy legs that end in dull ivory
nails support its tremendous weight.  A long, scaly tail floats precariously
from its hind portions, slowly waving from side to side.
"
"Olah"
""
"Nereus"
"i = 1d2;
if( i == 1 ) {
  act_tochar( #leap, ch );
  act_notchar( #nleap, ch );
  if( random( 1, 9 ) < 8 )
    attack( mob, victim, 6d30+35, \"furious pounce\" );
  attack( mob, victim, 4d30+30, \"furious clawing\" );
  attack( mob, victim, 5d25+25, \"ferocious clawing\" );
  attack( mob, victim, 5d25+30, \"rabid clawing\" );
  if( random( 1, 10 ) < 8 )
    attack( mob, victim, 6d25+30, \"vicious clawing\" );
  if( random( 1, 9 ) < 7 ) {
    act_room( #tail, ch );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 7 )
          attack( mob, rch, 3d40+30, \"wild tail strike\" );
        }
      }
    }
  }
else {
  attack( mob, victim, 3d40+25, \"sharp clawing\" );
  attack( mob, victim, 5d20+15, \"powerful strike\" );
  attack( mob, victim, 3d30+25, \"vicious bite\" );
  if( random( 1, 9 ) < 8 )
    attack( mob, victim, 6d20+25, \"fierce claw\" );
  if( random( 1, 10 ) < 8 )
    attack( mob, victim, 6d20+25, \"fierce clawing\" );
  if( random( 1, 9 ) < 7 ) {
    act_room( #tail, ch );
    loop( all_in_room ) {
      if( is_player( rch ) || is_pet( rch ) ) {
        if( random( 1, 9 ) < 7 )
          attack( mob, rch, 3d25+20, \"melee tail strike\" );
        }
      }
    }
  }
if( random( 1, 9 ) < 8 )
  attack_acid( mob, victim, 7d25+20, \"acidic bite\" );
attack( mob, victim, 7d25+20, \"ferocious bite\" );
if( random( 1, 9 ) < 8 )
  attack( mob, victim, 6d25+40, \"monstrous bite\" );
loop( all_in_room ) {
  if( is_player( rch ) || is_pet( rch ) ) {
    if( random( 1, 7 ) == 7 ) {
      j = 3d45+45;
      act_room( #spit, ch );
      acid_message( rch, j, \"the bulette's acidic spit\" );
      inflict_acid( rch, mob, j, \"A bulette's acidic spit\" );
      }
    }
  }
