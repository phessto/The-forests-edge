"if( is_player( ch ) ) {

  if( cflag( 189, ch ) ) {

    if( 1d5 != 3 ) {

      mob = mob_in_room( 2652, room );

      if( mob && !is_fighting( mob ) && ( 1d6 != 4 ) ) {

        act_tochar( #charge, ch, null, mob );

        act_notchar( #charges, ch, null, mob );

        if( attack( mob, ch, 3d12+12, \"shoulder bash\" ) ) {

          act_tochar( #knock, ch );

          set_resting( ch );

          set_delay( ch, 32 );

        }

        end;

      }

      mob = mob_in_room( 2651, room );

      if( mob && !is_fighting( mob ) && ( 1d6 != 4 ) ) {

        act_tochar( #melt, ch, null, mob );

        act_notchar( #melts, ch, null, mob );

        attack_backstab( mob, ch );

        end;

      }

      mob = mob_in_room( 2655, room );

      if( mob && !is_fighting( mob ) && ( 1d6 != 4 ) ) {

        interpret( mob, \"Yell Let glorious battle be joined!  For Morkith!\" );

        attack_weapon( mob, ch, 3d8+8, \"two-fisted punch\" );

