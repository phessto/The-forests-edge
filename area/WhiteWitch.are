      mob = mob_in_room( 2653, room );

      if( mob && !is_fighting( mob ) && ( 1d6 != 4 ) ) {

        act_tochar( #call, ch, null, mob );

        act_notchar( #calls, ch, null, mob );

        do_spell( slay, mob, ch, 13 );

        end;

      }

      mob = mob_in_room( 2654, room );

      if( mob && !is_fighting( mob ) && ( 1d6 != 4 ) ) {

        if( char_affected( mob, invisibility ) )

          dispel_affect( mob, invisibility );

        act_notchar( #flame, mob );

        do_spell( flame strike, mob, ch, 20 );

        end;

      }

    }

  }

}

