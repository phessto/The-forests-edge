"__Banshee_Wail_Code__"
""
"if( !rflag( reset2, room ) )

  end;

remove_rflag( reset2, room );

i = 0;

loop( all_in_room ) {

    if( vnum( rch ) == 2668 )

      i = i + 1;

  }

if( i == 1 ) act_room( #single, ch );

  if( i == 2 ) act_room( #double, ch );

  if( i == 3 ) act_room( #triple, ch );

  if( i == 4 ) act_room( #ruhroh, ch );

  if( i > 0 ) {

  loop( all_in_room ) {

    if( is_player( rch ) || is_pet( rch ) ) {

      if( i == 1 ) {

        j = 50d2+55;

        if( random( 1, 7 ) == 5 ) {

          act_tochar( #feared, rch );

          do_spell( fear, mob, rch, 5 );

          }

        sound_message( rch, j, \"the mournful wail\" );

        inflict_sound( rch, mob, j, \"a banshee's mournful wail\" );

        }

      if( i == 2 ) {

        j = 75d3+75;

        if( random( 1, 21 ) == 17 ) interpret( rch, \"flee\" );

          if( random( 1, 3 ) == 2 ) {

          act_tochar( #feared, rch );

          do_spell( fear, mob, rch, 7 );

          }

        sound_message( rch, j, \"the piercing shriek\" );

        inflict_sound( rch, mob, j, \"the banshees' mournful cries\" );

        }

      if( i == 3 ) {

        j = 100d3+100;

        act_tochar( #feared, rch );

        do_spell( fear, mob, rch, 10 );

        if( random( 1, 10 ) == 7 ) {

          interpret( rch, \"flee\" );

          }

        sound_message( rch, j, \"the deafening howl\" );

        inflict_sound( rch, mob, j, \"the banshees' deafening howl\" );

        }

      if( i >= 4 ) {

        j = 120d4+145;

        act_tochar( #paralyzed, rch );

        drain_stat( rch, str, 5, -2 );

        do_spell( paralyze, mob, rch, 20 );

        if( random( 1, 5 ) == 3 ) {

          act_tochar( #stunned, rch );

          set_delay( rch, 48 );

          }

        if( random( 1, 7 ) == 5 ) interpret( rch, \"flee\" );

          sound_message( rch, j, \"the chorus of screams\" );

        inflict_sound( rch, mob, j, \"the banshees' chorus of screams\" );

        }

      }

    }

  }

wait( 1 );

set_rflag( reset2, room );

"
