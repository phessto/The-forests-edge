"__Launch_Lich_zone__"
""
"j = 0;

i = 82589;

loop( i < 82594 ) {

  if( i != 82590 )

    if( players_room( find_room( i ) ) > 0 )

    j = 1;

  i = i + 1;

  }

i = 82599;

loop( i < 82618 ) {

  if( i != 82607 )

    if( players_room( find_room( i ) ) > 0 )

    j = 1;

  i = i + 1;

  }

if( players_room( find_room( 82663 ) ) > 0 )

  j = 1;

if( j == 0 ) {

  if( mob_in_room( 2751, find_room( 82617 ) ) )

    junk_mob( mob_in_room( 2751, find_room( 82617 ) ) );

  if( !mob_in_room( 2708, find_room( 82617 ) ) )

    mload( 2708, find_room( 82617 ) );

  mob = mob_in_room( 1329, find_room( 82608 ) );

  if( !mob )

    mload( 1329, find_room( 82608 ) );

  remove_rflag( status0, find_room( 82611 ) );

  remove_rflag( status0, find_room( 82615 ) );

  remove_rflag( status0, find_room( 82614 ) );

  remove_rflag( status0, find_room( 82610 ) );

  remove_rflag( status0, find_room( 82613 ) );

  obj = obj_in_room( 4560, find_room( 82617 ) );

  if( obj )

    set_obj_value( obj, 0, 20 );

  if( obj )

    set_obj_value( obj, 2, 0 );

  if( obj )

    set_obj_value( obj, 1, 0 );

  mob = mob_in_room( 2708, find_room( 82617 ) );

  if( mob )

    interpret( mob, \"sit bier\" );

  acode( find_room( 82617 ), 9 );

  }

"
!
