"if( find_stat( ch, level ) > 91 )

  continue;

mob = mob_in_room( 2830, room );

if( mob ) {

  if( can_see_char( mob, ch ) ) {

    if( find_stat( ch, align ) % 3 == 0 && !is_follower( ch ) ) {

      interpret( mob, \"say You may pass.  Do not cause trouble; you are responsible for those with you.\" );

      continue;

    }

    if( find_stat( ch, align ) % 3 == 2 ) {

      interpret( mob, \"say Stop - you cannot enter.\" );

      end;

    }

    if( find_stat( ch, align ) % 3 == 1 && !is_follower( ch ) ) {

      interpret( mob, \"say I can only allow you to enter if you are led by one I can trust.\" );

      end;

    }

  }

}

continue;

"
