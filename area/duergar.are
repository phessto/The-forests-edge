""
""
65763 -1 91779 0 5
A
"dig mine"
""
"if( !is_player( ch ) )

  end;


// Make sure player has a proper mining tool wielded

if( !wield( ch ) || !obj_flag( wield( ch ), tool_mine ) ) {

  act_tochar( #needtool, ch );

  end;

}


if( rflag( reset0, room ) ) {

  remove_rflag( reset0, room );

  i = random( 1, 10 );


  // Found something (chunk of platinum ore)

  if( i < 4 ) {

    act_tochar( #found, ch );

    act_notchar( #rfound, ch );

    obj_to_char( oload( 4752 ), ch );

    end;

  }

}


// No dice!

act_tochar( #nothing, ch );

act_notchar( #rnothing, ch );

