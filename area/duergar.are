"cart"
"if( !is_player( ch ) )

  end;

if( rflag( reset0, room ) ) {

  i = random( 1, 100 );

  remove_rflag( reset0, room );

  if( i < 51 ) {

    // found something!

    act_tochar( #eureka, ch );

    act_notchar( #reureka, ch );


    // load pickaxe

    if( i > 20 )

      obj_to_char( oload( 3403 ), ch );

    else {

      // load crowbar (for #91750)

      if( i > 10 )

        obj_to_char( oload( 241 ), ch );

      // load oil-soaked rag (for #91776)

      else

        obj_to_char( oload( 2079 ), ch );

    }

    end;

  }

}


