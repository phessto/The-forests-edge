A
"climb"
"w we west rubble"
"if( ( exit = door( room, west ) ) ) {

  act_tochar( #climb, ch );

  act_notchar( #rclimb, ch );

  transfer( ch, leads_to( exit ) );


  loop( followers ) {

    if ( is_standing( rch ) && !is_fighting( rch ) && !is_mounted( rch ) ) {

      ch = rch;

      acode( room, 2 );

    }

    else {

      if( !is_fighting( rch ) && is_mounted( rch ) )

        act_tochar( #mounted, rch );

    }

  }

}

else

  beetle( #broken, ch );

"
