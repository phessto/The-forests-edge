"The boards have already been removed.

"
!
0 0 0
A
"look"
"d do down boards"
"if( !is_open( room, down ) )

  act_tochar( #boards, ch );

else if( is_name( arg, \"boards\" ) )

  act_tochar( #opened, ch );

else

  continue;

"
E
"boards"
"The entrance to what appears to be a steeply inclined mine shaft has been

boarded up from the outside, with sturdy planks of wood nailed firmly in

place.  As you wipe away the dust, you see the word \"@RDanger@n\" painted across

them in red.

"
E
"opened"
"The boards have been removed.

"
!
0 0 0
A
""
""
"exit = door( room, east );

if ( exit && leads_to( exit ) ) {

  i = size( ch );

  j = size( leads_to( exit ) );


  // If needs to duck and can fit out the door

  if ( i > 4 && i <= j ) {

    act_tochar( #duck, ch );

    act_notchar( #rduck, ch );


    transfer( ch, leads_to( exit ) );

    end;

  }

  // Else if can fit, continue as usual

  else if ( i <= j )

    continue;

}

else

  beetle( \"Error: Exit not found.\", ch, null, room );

"
E
"duck"
"You hunker your head down and head east out of the cave.

"
E
"rduck"
"$n hunkers $s head down and heads east out of the cave.

"
!
