"loop( all_in_room ) {

  // Only trigger for duergar mine workers

  if( is_mob( rch ) && vnum( rch ) == 2784 ) {

    mob = rch;

    if( is_resting( mob ) ) {

      set_standing( mob );

      interpret( mob, \"emote leaps up from his seat and readies for battle!\" );

    }

    mpcode( mob, 2 );

  }

}


if( !is_open( room, north ) )

  open( room, north );

