"if( !( thing = find_room( 91776 ) ) )

  end;


// Opens quietly

if( !rflag( reset0, room( thing ) ) ) {

  act_tochar( #quiet, ch );

  act_notchar( #rquiet, ch );

}

// Opens loudly (alerts workers)

else {

  act_tochar( #loud, ch );

  act_notchar( #rloud, ch );

  room = find_room( 91777 );

  acode( room, 1 );  // Workers stand up, switch weapons

}

open( room( thing ), south );

"
E
"quiet"
"With the hinges nicely oiled, you manage to open the door quietly.

"
E
"rquiet"
"$n manages to open the makeshift door to the south without making any noise.

"
E
"loud"
"@WAs you open the makeshift door to the south, the hinges bind and you hear a

loud screech!@n

"
E
"rloud"
"As $n opens the makeshift door to the south, the hinges bind, making a loud

screeching noise.@n

"
!
0 0 0
A
"oil grease"
"s so south door hinges"
"if( !is_player( ch ) )

  end;


if( !rflag( reset0, room ) ) {

  act_tochar( #done, ch );

  end;

}


// has a set of oil-soaked rags

if( has_obj( 2079, ch ) ) {

  act_tochar( #oil, ch );

  act_notchar( #roil, ch );

  remove_rflag( reset0, room );

}

else

  act_tochar( #cant, ch );

"
E
"oil"
"You grease up the hinges of the makeshift door with an oil-soaked rag.

"
E
"roil"
"$n greases up the hinges of the makeshift door to the south with an oil-soaked

rag.

"
E
"cant"
"You don't have anything to grease the hinges with.

"
E
"done"
"The hinges already appear to be nicely greased.

"
!
