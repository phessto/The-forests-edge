  act_tochar( #cant, ch );

  act_notchar( #rcant, ch );

}

else

  act_tochar( #opened, ch );


"
E
"cant"
"You can't seem to pull the boards loose with your bare hands.  You might be

able to pry them off with a crowbar, or perhaps just pure brute force will do.

"
E
"rcant"
"$n tries to pull the boards loose but seems unable.

"
