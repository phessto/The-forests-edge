A
"enter"
"white marble archway"
"act_tochar( #wmenter, ch );

act_notchar( #rwmenter, ch );

transfer( ch, find_room( 4630 ) );

room = find_room( 4630 );

act_notchar( #owmenter, ch);

room = find_room( 4625 );

loop( followers ) {

ch = rch;

acode( room, 1 );

}

"
E
"wmenter"
"You step through the polished white marble archway and enter a room quiet

enough to be a mausoleum.

"
E
"rwmenter"
"You see $n step through the polished white marble archway.

"
E
"owmenter"
"$n arrives through the white marble archway to the south.

"
!
0 0 0
A
"enter"
"mist-shrouded archway"
"act_tochar( #msenter, ch );

act_notchar( #rmsenter, ch );

transfer( ch, find_room( 4627 ) );

room = find_room( 4627 );

act_notchar( #osmenter, ch ) ;

room = find_room( 4625 );

loop( followers ) {

ch = rch;

acode( room, 2);

}

"
E
"msenter"
"Droplets of the fine mist condense on you as you step through the archway,

leaving you not a little damp.

"
E
"rmsenter"
"You see $n step through the mist-shrouded doorway to the southwest.

"
E
"osmenter"
"$n arrives through the arch to the northeast, looking a little more wet than usual.

"
!
