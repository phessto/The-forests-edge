if( rflag( reset0, room ) ) {

  ch = rand_char( room );

  if( is_player( ch ) ) {

    remove_rflag( reset0, room );

    if( is_sleeping( ch ) ) {

      act_tochar( #sleep, ch );

      act_notchar( #rsleep, ch );

      }

    else {

      act_tochar( #boo, ch );

      act_notchar( #rboo, ch );

      }

    mload( 2698, room );

    mob = mob_in_room( 2698, room );

    victim = ch;

    attack( mob, victim, 3d6, \"eviscerating claws\" );

    }

  }

