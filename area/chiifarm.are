  act_tochar( #apple, ch, obj );

  act_notchar( #capple, ch, obj );

  }

else {

  act_notchar( #pet, ch, obj );

  interpret( ch, \"eat apple\" );

  obj_to_room( has_obj( 543, ch ), room );

  }

