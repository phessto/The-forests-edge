"ring"
"if( has_obj( 4323, ch ) || wearing_obj( 4323, ch ) ) {
  if( is_name( \"KEEP\", clan_abbrev( ch ) ) ) {
    act_tochar( #success, ch );
    act_notchar( #rsuccess, ch );
    wait( 1 );
    act_tochar( #bye, ch );
    act_notchar( #rbye, ch );
    room = find_room( 28111 );
    transfer( ch, room );
    }
  else {
    act_tochar( #fail, ch );
    act_notchar( #rfail, ch );
    junk_obj( has_obj( 4323, ch ) );
    }
  }
else
  continue;
"
