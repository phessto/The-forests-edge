"climb"
"up chasm"
"if (is_fighting (ch)) {

  act_tochar(#youre_fighting, ch);

  end;

}

if (is_mounted (ch)) {

  act_tochar(#nomount, ch);

  end;

}

if (is_standing (ch)) {

  if (can_fly (ch)) {

    act_tochar(#fly_up, ch);

    act_notchar(#ofly_up, ch);

    transfer (ch, find_room (43544));

    act_notchar(#ofly_arr, ch);

  }

  else {

    if (find_skill (ch, climb) > random (0,7)) {

      use_skill (ch, climb);

      act_tochar (#climb_up, ch);

      act_notchar (#oclimb_up, ch);

      transfer (ch, find_room (43544));

      act_notchar (#oclimb_arr, ch);

    }

    else {

      act_tochar(#fail, ch);

    }

  }

  loop (followers) {

    if (is_player (rch)) {

      ch = rch;

      acode (room, 1);

    }

  }

}

