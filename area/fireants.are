"climb"
"1 down fissure"
"i = 5d10+20;

if( is_fighting( ch ) ) {

  act_tochar( #flee, ch );

  end;

  }

if( can_fly( ch ) ) {

act_tochar( #fly_char, ch );

act_notchar( #fly_room, ch );

fire_message( ch, i, \"a blast of scolding steam\" );

inflict_fire( ch, mob, i, \"a blast of scolding steam\" );

transfer( ch, find_room( 43515 ) );

act_notchar( #fly_arr, ch );

end;

}

if( is_mounted( ch ) ) {

  act_tochar( #nomount, ch );

  end;

  }

if( find_skill( ch, climb ) > random( 0, 7 ) ) {

  use_skill( ch, climb );

  act_tochar( #climb_char, ch );

  act_notchar( #climb_room, ch );

  fire_message( ch, i, \"a blast of scolding steam\" );

  inflict_fire( ch, mob, i, \"a blast of scolding steam\" );

  transfer( ch, find_room( 43515 ) );

  act_notchar( #climb_arr, ch );

  }

else{

  act_tochar( #fail, ch );

  act_notchar( #failroom, ch );

  }

loop( followers ) {

  if( is_player( rch ) ) {

    ch = rch;

    acode( room, 1 );

  }

}

